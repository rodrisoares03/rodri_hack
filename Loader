-- =========================================================
-- HELPERS
-- =========================================================
local function New(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		o.Font = Enum.Font.GothamBold
	end
	return o
end
local function Corner(r, p) return New("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function Stroke(col, th, p) return New("UIStroke", {Color = col or C.Border, Thickness = th or 1}, p) end
local function Tween(obj, props, t, style, dir)
	local info = TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
	pcall(function() TweenService:Create(obj, info, props):Play() end)
end

-- Pedido HTTP (executor request / syn / fluxus / fallback)
local function getHWID()
	local hwid = "unknown"
	pcall(function()
		local analytics = game:GetService("RbxAnalyticsService")
		hwid = analytics:GetClientId()
	end)
	return hwid
end

-- Validacao contra a API do bot (base de dados real, keys nao publicas)
local function validateKeyWithApi(key)
	local hwid = getHWID()
	local okHttp, response = pcall(game.HttpGet, game,
		API_URL .. "?key=" .. HttpService:UrlEncode(key) .. "&hwid=" .. HttpService:UrlEncode(hwid))
	if not okHttp or not response or response == "" then
		return false, "Sem ligacao ao servidor de keys.", nil
	end
	local okDecode, data = pcall(function() return HttpService:JSONDecode(response) end)
	if not okDecode or type(data) ~= "table" then
		return false, "Resposta invalida do servidor.", nil
	end
	if data.ok == true then
		return true, data.message or "Key aceite", data
	end
	local reasons = {
		invalid = "Key invalida.",
		revoked = "Key revogada.",
		expired = "Key expirada.",
		hwid = "Key vinculada a outro dispositivo.",
	}
	return false, reasons[data.reason] or data.message or "Key recusada.", data
end

