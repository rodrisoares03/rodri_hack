		if obj:IsA("TextBox") or obj:IsA("TextButton") or obj:IsA("TextLabel") then
			obj.Visible = false
		end
	end

	local bigIcon = New("ImageLabel", {
		Image = "rbxassetid://" .. ICON_ID,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0.5, -30, 0, 68),
		Size = UDim2.new(0, 60, 0, 60),
		ZIndex = 4,
	}, card)
	Corner(14, bigIcon)
	Stroke(C.Border, 1, bigIcon).Transparency = 0.35

	local lTitle = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 0, 138),
		Size = UDim2.new(1, -40, 0, 24),
		Text = "Loading script",
		TextSize = 16,
		TextColor3 = C.Text,
		ZIndex = 4,
	}, card)

	local lSub = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 0, 164),
		Size = UDim2.new(1, -40, 0, 16),
		Text = "Getting things ready...",
		TextSize = 11,
		TextColor3 = C.Dim,
		ZIndex = 4,
	}, card)

	local barBg = New("Frame", {
		BackgroundColor3 = C.Input,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 20, 0, 194),
		Size = UDim2.new(1, -40, 0, 10),
		ZIndex = 4,
	}, card)
	Corner(4, barBg)
	local barFill = New("Frame", {
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 5,
	}, barBg)
	Corner(4, barFill)

	local lStatus = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 0, 216),
		Size = UDim2.new(1, -40, 0, 16),
		Text = "Loading",
		TextSize = 10,
		TextColor3 = C.Dim,
		ZIndex = 4,
	}, card)

	local loadingWidgets = { bigIcon, lTitle, lSub, barBg, lStatus }

	Tween(barFill, {Size = UDim2.new(1, 0, 1, 0)}, LOAD_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	Tween(bigIcon, {Rotation = 360}, LOAD_TIME, Enum.EasingStyle.Linear)

	task.delay(LOAD_TIME + 0.25, function()
		lStatus.Text = "Starting Night Menu..."
		task.wait(0.25)

		-- O loader DESAPARECE primeiro, so depois o menu e executado
		pcall(function() gui.Enabled = false end)
		task.wait(0.35)
		pcall(function() gui:Destroy() end)
		task.wait(0.25)

		-- compilar noutro thread e libertar a string antes de executar (menos memoria)
		task.defer(function()
			local loadError = nil
			local okHttp, src = pcall(game.HttpGet, game, SCRIPT_URL)
			if not okHttp or not src or src == "" then
				loadError = "Falha no HttpGet do menu."
			else
				if src:sub(1, 3) == "\239\187\191" then src = src:sub(4) end
				local loader = loadstring or load
				local fn, compileErr = loader(src)
				src = nil
				if not fn then
					loadError = "Erro ao compilar: " .. tostring(compileErr)
				else
					local okRun, runErr = pcall(fn)
					if not okRun then loadError = "Erro ao executar: " .. tostring(runErr) end
				end
			end
			if loadError then
				pcall(function()
					local errGui = New("ScreenGui", {Name = "NightLoaderError", IgnoreGuiInset = true})
					errGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
					local box = New("TextLabel", {
						BackgroundColor3 = C.Card,
						Position = UDim2.new(0.5, -200, 0.5, -40),
						Size = UDim2.new(0, 400, 0, 80),
						Text = loadError,
						TextSize = 12,
						TextWrapped = true,
						TextColor3 = C.Text,
					}, errGui)
					Corner(8, box)
				end)
				warn("[Night Loader] " .. tostring(loadError))
			end
		end)
	end)
end

checkBtn.MouseButton1Click:Connect(function()
	if loading then return end
	local key = tostring(keyBox.Text or ""):match("^%s*(.-)%s*$")
	if key == "" then
		setStatus("Escreve a key primeiro.", Color3.fromRGB(255, 120, 120))
		return
	end

	setStatus("A validar key...", C.Dim)
	local accepted, message = validateKeyWithApi(key)
	if not accepted then
		setStatus(message, Color3.fromRGB(255, 120, 120))
		Tween(keyBox, {BackgroundColor3 = Color3.fromRGB(90, 40, 45)}, 0.12)
		task.wait(0.18)
		Tween(keyBox, {BackgroundColor3 = C.Input}, 0.12)
		return
	end

	setStatus("Key correta!", Color3.fromRGB(120, 255, 150))
	pcall(function()
		if writefile then writefile("night_loader_key.txt", key) end
	end)
	task.wait(0.35)
	showLoadingScreen()
end)

