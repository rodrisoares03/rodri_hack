-- Elo de corrente real: anel feito de segmentos de metal (retorna modelo + lista de segmentos com offsets locais)
function makeMultiWaypointChainLink(parent, centerCF, linkRadius, thickness, color, segCount)
	segCount = segCount or 8
	local linkModel = Instance.new("Model")
	linkModel.Name = "ChainLink"
	local chord = 2 * linkRadius * math.sin(math.pi / segCount)
	local segs = {}
	for s = 0, segCount - 1 do
		local am = (math.pi * 2 / segCount) * s + (math.pi / segCount)
		local offset = CFrame.new(math.cos(am) * linkRadius, math.sin(am) * linkRadius, 0) * CFrame.Angles(0, 0, am + math.pi / 2)
		local seg = Instance.new("Part")
		seg.Name = "LinkSeg"
		seg.Anchored = true
		seg.CanCollide = false
		seg.CanTouch = false
		seg.CanQuery = false
		seg.Material = Enum.Material.Metal
		seg.Color = color
		seg.Reflectance = 0.08
		seg.Size = Vector3.new(chord * 1.35, thickness, thickness)
		seg.CFrame = centerCF * offset
		seg.Parent = linkModel
		table.insert(segs, {part = seg, offset = offset})
	end
	linkModel.Parent = parent
	return linkModel, segs
end

-- Corrente pendurada: elos intercalados (cada elo girado 90 graus como corrente de verdade)
function makeMultiWaypointChain(parent, topCF, linkCount, linkRadius, thickness, color)
	local step = linkRadius * 1.75
	for i = 0, linkCount - 1 do
		local rot = (i % 2 == 1) and CFrame.Angles(0, math.rad(90), 0) or CFrame.Angles(0, 0, 0)
		makeMultiWaypointChainLink(parent, topCF * CFrame.new(0, -i * step, 0) * rot, linkRadius, thickness, color, 8)
	end
end

-- Sistema de raios: pool de segmentos neon que formam descargas serrilhadas aleatorias
function makeMultiWaypointLightning(model, baseCF, halfW, halfH, boltCount, segPerBolt)
	boltCount = boltCount or 3
	segPerBolt = segPerBolt or 7
	local sys = {model = model, baseCF = baseCF, halfW = halfW, halfH = halfH, bolts = {}}
	for _ = 1, boltCount do
		local segs = {}
		for _ = 1, segPerBolt do
			local seg = Instance.new("Part")
			seg.Name = "PortalBolt"
			seg.Anchored = true
			seg.CanCollide = false
			seg.CanTouch = false
			seg.CanQuery = false
			seg.Material = Enum.Material.Neon
			seg.Color = Color3.fromRGB(225, 185, 255)
			seg.Transparency = 1
			seg.Size = Vector3.new(1, 0.08, 0.08)
			seg.Parent = model
			table.insert(segs, seg)
		end
		table.insert(sys.bolts, {segs = segs, timer = math.random() * 0.4, active = false})
	end
	return sys
end

function updateMultiWaypointLightning(sys, dt)
	for _, bolt in ipairs(sys.bolts) do
		bolt.timer = bolt.timer - dt
		if bolt.timer <= 0 then
			if bolt.active and math.random() < 0.4 then
				bolt.active = false
				bolt.timer = 0.04 + math.random() * 0.12
				for _, seg in ipairs(bolt.segs) do
					seg.Transparency = 1
				end
			else
				bolt.active = true
				bolt.timer = 0.05 + math.random() * 0.13
				local edge = math.random(0, 2)
				local aLocal
				if edge == 0 then
					aLocal = Vector3.new((math.random() * 2 - 1) * sys.halfW, sys.halfH + 0.15, 0)
				elseif edge == 1 then
					aLocal = Vector3.new(-sys.halfW - 0.15, (math.random() * 2 - 1) * sys.halfH, 0)
				else
					aLocal = Vector3.new(sys.halfW + 0.15, (math.random() * 2 - 1) * sys.halfH, 0)
				end
				local outDir = Vector3.new(math.random() * 2 - 1, math.random() * 1.4 - 0.5, math.random() * 2 - 1)
				if outDir.Magnitude < 0.05 then
					outDir = Vector3.new(0, 1, 0)
				else
					outDir = outDir.Unit
				end
				local bLocal = aLocal + outDir * (1.1 + math.random() * 2.1)
				local aWorld = (sys.baseCF * CFrame.new(aLocal)).Position
				local bWorld = (sys.baseCF * CFrame.new(bLocal)).Position
				local n = #bolt.segs
				local jitter = 0.4
				local prev = aWorld
				for i = 1, n do
					local t = i / n
					local p = aWorld:Lerp(bWorld, t)
					if i < n then
						p = p + Vector3.new((math.random() * 2 - 1) * jitter, (math.random() * 2 - 1) * jitter, (math.random() * 2 - 1) * jitter * 0.5)
					end
					local delta = p - prev
					local len = delta.Magnitude
					local seg = bolt.segs[i]
					if len > 0.01 then
						local mid = prev + delta / 2
						local dir = delta.Unit
						local up = math.abs(dir.Y) > 0.98 and Vector3.new(0, 0, 1) or Vector3.yAxis
						seg.Size = Vector3.new(len, 0.08, 0.08)
						seg.CFrame = CFrame.lookAt(mid, mid + dir, up) * CFrame.Angles(0, math.pi / 2, 0)
						seg.Transparency = math.random() < 0.3 and 0.35 or 0
					else
						seg.Transparency = 1
					end
					prev = p
				end
			end
		end
	end
end

function ensureMultiWaypointMarkerLoop()
	if multiWaypointMarkerConn then return end
	multiWaypointMarkerConn = RunService.Heartbeat:Connect(function(dt)
		local clockNow = os.clock()

		-- Barras de redemoinho internas
		for _, spinner in ipairs(multiWaypointMarkerSpinners) do
			local part = spinner.part
			if part and part.Parent then
				spinner.angle = spinner.angle + spinner.speed * dt
				part.CFrame = spinner.baseCF * CFrame.Angles(0, 0, spinner.angle)
			end
		end

		-- Anel de orbes magicos girando no plano do portal
		for _, ring in ipairs(multiWaypointOrbRings) do
			ring.angle = ring.angle + ring.speed * dt
			local count = #ring.orbs
			for i, orb in ipairs(ring.orbs) do
				if orb and orb.Parent then
					local a = ring.angle + (math.pi * 2 / count) * i
					orb.CFrame = ring.baseCF * CFrame.new(math.cos(a) * ring.radius, math.sin(a) * ring.radius, 0) * CFrame.Angles(0, 0, a)
				end
			end
		end

		-- Elos de corrente orbitando o portal
		for _, orbiter in ipairs(multiWaypointOrbiters) do
			if orbiter.model and orbiter.model.Parent then
				orbiter.angle = orbiter.angle + orbiter.speed * dt
				local a = orbiter.angle
				local offset = CFrame.new(
					math.cos(a) * orbiter.radiusX,
					math.sin(a * 0.7 + orbiter.phase) * orbiter.height,
					math.sin(a) * orbiter.radiusZ
				) * CFrame.Angles(math.rad(90), 0, a)
				orbiter.model:PivotTo(orbiter.baseCF * offset)
			end
		end

		-- Raios electricos piscando em volta da moldura
		for _, sys in ipairs(multiWaypointLightnings) do
			if sys.model and sys.model.Parent then
				updateMultiWaypointLightning(sys, dt)
			end
		end

		-- Pulso do nucleo roxo
		for _, glow in ipairs(multiWaypointGlowPulses) do
			if glow.part and glow.part.Parent and glow.light and glow.light.Parent then
				local pulse = 0.5 + 0.5 * math.sin(clockNow * glow.speed + glow.phase)
				glow.light.Brightness = glow.baseBrightness + pulse * 1.8
				glow.part.Transparency = math.clamp(glow.baseTransparency - pulse * 0.06, 0, 1)
			end
		end

		-- Numero do waypoint com tamanho proporcional fixo no mundo (nao cresce ao afastar)
		local cam = workspace.CurrentCamera
		if cam then
			local vpY = cam.ViewportSize.Y
			local denom = 2 * math.tan(math.rad(cam.FieldOfView) / 2)
			if denom > 0 then
				for _, tag in ipairs(multiWaypointNumberTags) do
					local part = tag.part
					if part and part.Parent and tag.gui and tag.gui.Parent then
						local dist = (part.Position - cam.CFrame.Position).Magnitude
						if dist > 1 then
							local px = math.floor(math.clamp(tag.worldHeight * (vpY / (denom * dist)), tag.minPx, tag.maxPx))
							tag.gui.Size = UDim2.fromOffset(px, px)
						end
					end
				end
			end
		end
	end)
end

function createMultiWaypointMarker(entry, index)
	local position = entry.position
	local look = entry.look or Vector3.new(0, 0, -1)
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end

	local blockSize = 0.7
	local openingW = 3.5
	local openingH = 4.9
	local outerH = openingH + blockSize * 2

	local center = position + Vector3.new(0, outerH / 2, 0)
	local baseCF = CFrame.lookAt(center, center + flatLook)

	local model = Instance.new("Model")
	model.Name = "NightMultiWaypointMarker" .. tostring(index)

	-- Fundo do portal: SEMPRE roxo (painel neon fixo)
	local glowPart = Instance.new("Part")
	glowPart.Name = "PortalGlow"
	glowPart.Anchored = true
	glowPart.CanCollide = false
	glowPart.CanTouch = false
	glowPart.CanQuery = false
	glowPart.Material = Enum.Material.Neon
	glowPart.Color = Color3.fromRGB(150, 70, 255)
	glowPart.Transparency = 0.08
	glowPart.Size = Vector3.new(openingW, openingH, 0.18)
	glowPart.CFrame = baseCF
	glowPart.Parent = model

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(165, 85, 255)
	light.Brightness = 3
	light.Range = 14
	light.Parent = glowPart

	local ambientEmitter = Instance.new("ParticleEmitter")
	ambientEmitter.Color = ColorSequence.new(Color3.fromRGB(195, 125, 255))
	ambientEmitter.LightEmission = 1
	ambientEmitter.Rate = 10
	ambientEmitter.Lifetime = NumberRange.new(0.8, 1.4)
	ambientEmitter.Speed = NumberRange.new(0.5, 1.5)
	ambientEmitter.Acceleration = Vector3.new(0, 2.5, 0)
	ambientEmitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0)})
	ambientEmitter.Parent = glowPart

	-- Barras de redemoinho girando dentro do portal
	local spinners = {}
	local function makeSwirlBar(startAngle, speed, transparency)
		local bar = Instance.new("Part")
		bar.Name = "PortalSwirl"
		bar.Anchored = true
		bar.CanCollide = false
		bar.CanTouch = false
		bar.CanQuery = false
		bar.Material = Enum.Material.Neon
		bar.Color = Color3.fromRGB(185, 120, 255)
		bar.Transparency = transparency
		bar.Size = Vector3.new(openingW - 0.2, 0.75, 0.06)
		bar.CFrame = baseCF * CFrame.Angles(0, 0, startAngle)
		bar.Parent = model
		table.insert(spinners, {part = bar, baseCF = baseCF, angle = startAngle, speed = speed})
	end
	makeSwirlBar(0, 1.6, 0.35)
	makeSwirlBar(math.pi / 2, -1.15, 0.5)

	-- Moldura estilo Minecraft: blocos de obsidiana roxa escura
	local function makeBlock(cf)
		local shade = math.random(0, 14)
		local block = Instance.new("Part")
		block.Name = "ObsidianBlock"
		block.Anchored = true
		block.CanCollide = false
		block.CanTouch = false
		block.CanQuery = false
		block.Material = Enum.Material.Slate
		block.Color = Color3.fromRGB(26 + shade, 18 + math.floor(shade * 0.6), 44 + shade)
		block.Size = Vector3.new(blockSize, blockSize, blockSize)
		block.CFrame = cf
		block.Parent = model
	end

	local halfStep = openingW / 2 + blockSize / 2
	local cols = math.floor((openingW + blockSize * 2) / blockSize + 0.5)
	for c = 0, cols - 1 do
		local x = -halfStep + c * blockSize
		makeBlock(baseCF * CFrame.new(x, -(openingH / 2 + blockSize / 2), 0))
		makeBlock(baseCF * CFrame.new(x, openingH / 2 + blockSize / 2, 0))
	end
	local sideRows = math.floor(openingH / blockSize + 0.5)
	for r = 0, sideRows - 1 do
		local y = -(openingH / 2) + blockSize / 2 + r * blockSize
		makeBlock(baseCF * CFrame.new(-halfStep, y, 0))
		makeBlock(baseCF * CFrame.new(halfStep, y, 0))
	end

	-- Correntes reais penduradas nos dois lados da moldura
	local chainColor = Color3.fromRGB(58, 50, 78)
	local chainSideX = openingW / 2 + blockSize * 1.02
	for _, sx in ipairs({-chainSideX, chainSideX}) do
		makeMultiWaypointChain(model, baseCF * CFrame.new(sx, openingH / 2 - 0.15, 0), 7, 0.27, 0.09, chainColor)
	end

	-- Elos de corrente orbitando o portal (estilo anime)
	for i = 1, 6 do
		local linkModel = makeMultiWaypointChainLink(model, baseCF, 0.23, 0.085, Color3.fromRGB(84, 70, 118), 8)
		table.insert(multiWaypointOrbiters, {
			model = linkModel,
			baseCF = baseCF,
			angle = (math.pi * 2 / 6) * i,
			speed = 1.3 + (i % 3) * 0.3,
			radiusX = openingW / 2 + 1.25,
			radiusZ = 1.15,
			height = openingH / 2 + 0.45,
			phase = i * 1.37,
		})
	end

	-- Anel de orbes magicos girando ao redor do portal
	local orbs = {}
	for _ = 1, 10 do
		local orb = Instance.new("Part")
		orb.Name = "PortalOrb"
		orb.Anchored = true
		orb.CanCollide = false
		orb.CanTouch = false
		orb.CanQuery = false
		orb.Material = Enum.Material.Neon
		orb.Color = Color3.fromRGB(205, 150, 255)
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(0.18, 0.18, 0.18)
		orb.CFrame = baseCF
		orb.Parent = model
		table.insert(orbs, orb)
	end
	table.insert(multiWaypointOrbRings, {
		orbs = orbs,
		baseCF = baseCF,
		angle = index * 0.63,
		speed = 0.85,
		radius = openingW / 2 + blockSize + 0.42,
	})

	-- Raios electricos piscando em volta da moldura
	table.insert(multiWaypointLightnings, makeMultiWaypointLightning(model, baseCF, openingW / 2, openingH / 2, 3, 7))

	-- Pulso de brilho do nucleo roxo
	table.insert(multiWaypointGlowPulses, {
		part = glowPart,
		light = light,
		baseBrightness = 3,
		baseTransparency = 0.08,
		speed = 2.1,
		phase = index * 0.9,
	})

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "MultiWaypointBillboard"
	billboard.Size = UDim2.new(0, 90, 0, 90)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, outerH / 2 + 0.9, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = glowPart

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = "#" .. tostring(index)
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(230, 210, 255)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(90, 40, 180)
	label.Parent = billboard

	-- Numero com tamanho proporcional ao portal (nao cresce na tela ao afastar)
	table.insert(multiWaypointNumberTags, {
		gui = billboard,
		part = glowPart,
		worldHeight = 2,
		minPx = 14,
		maxPx = 110,
	})

	model.Parent = workspace
	return model, spinners
end

function refreshMultiWaypointMarkers()
	for _, marker in pairs(multiWaypointMarkers) do
		pcall(function()
			marker:Destroy()
		end)
	end
	multiWaypointMarkers = {}
	multiWaypointMarkerSpinners = {}
	multiWaypointOrbiters = {}
	multiWaypointOrbRings = {}
	multiWaypointGlowPulses = {}
	multiWaypointNumberTags = {}
	multiWaypointLightnings = {}
	for i, entry in ipairs(multiWaypointPositions) do
		local model, spinners = createMultiWaypointMarker(entry, i)
		multiWaypointMarkers[i] = model
		if spinners then
			for _, spinner in ipairs(spinners) do
				table.insert(multiWaypointMarkerSpinners, spinner)
			end
		end
	end
	ensureMultiWaypointMarkerLoop()
end

function saveCurrentMultiWaypoint()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return false end

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {character}
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist

	local rayResult = workspace:Raycast(root.Position, Vector3.new(0, -300, 0), rayParams)
	local savedPosition
	if rayResult then
		savedPosition = rayResult.Position
	else
		savedPosition = root.Position - Vector3.new(0, 3, 0)
	end

	table.insert(multiWaypointPositions, {
		position = savedPosition,
		look = root.CFrame.LookVector,
	})
	refreshMultiWaypointMarkers()
	return true
end

function clearAllMultiWaypoints()
	multiWaypointPositions = {}
	multiWaypointIndex = 0
	refreshMultiWaypointMarkers()
end

function spawnMultiWaypointPortal(position)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	local look = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end

	local center = position + Vector3.new(0, 2.9, 0)
	local baseCF = CFrame.lookAt(center, center + flatLook)

	local model = Instance.new("Model")
	model.Name = "NightMultiWaypointPortal"

	local frame = Instance.new("Part")
	frame.Name = "PortalFrame"
	frame.Anchored = true
	frame.CanCollide = false
	frame.CanTouch = false
	frame.CanQuery = false
	frame.Material = Enum.Material.Metal
	frame.Color = Color3.fromRGB(16, 12, 24)
	frame.Size = Vector3.new(3.2, 5.2, 0.45)
	frame.Transparency = 1
	frame.CFrame = baseCF
	frame.Parent = model

	local glow = Instance.new("Part")
	glow.Name = "PortalGlow"
	glow.Anchored = true
	glow.CanCollide = false
	glow.CanTouch = false
	glow.CanQuery = false
	glow.Material = Enum.Material.Neon
	glow.Color = Color3.fromRGB(150, 70, 255)
	glow.Transparency = 0.12
	glow.Size = Vector3.new(2.55, 0.15, 0.18)
	glow.CFrame = baseCF
	glow.Parent = model

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(165, 85, 255)
	light.Brightness = 6
	light.Range = 20
	light.Parent = glow

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(195, 125, 255))
	emitter.LightEmission = 1
	emitter.Rate = 55
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Speed = NumberRange.new(2, 5)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0)})
	emitter.Parent = glow

	-- Onda de choque circular na abertura do portal
	pcall(function()
		local shock = Instance.new("Part")
		shock.Name = "PortalShockwave"
		shock.Anchored = true
		shock.CanCollide = false
		shock.CanTouch = false
		shock.CanQuery = false
		shock.Material = Enum.Material.Neon
		shock.Color = Color3.fromRGB(190, 120, 255)
		shock.Transparency = 0.25
		shock.Shape = Enum.PartType.Cylinder
		shock.Size = Vector3.new(0.05, 1, 1)
		shock.CFrame = baseCF * CFrame.Angles(0, 0, math.rad(90))
		shock.Parent = model
		TweenService:Create(shock, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(0.05, 11, 11),
			Transparency = 1,
		}):Play()
	end)

	model.Parent = workspace

	TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.05}):Play()
	TweenService:Create(glow, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = Vector3.new(2.55, 4.75, 0.18)}):Play()

	-- Correntes reais (elos de anel) montando dos dois lados com animacao de queda
	local chainColor = Color3.fromRGB(52, 46, 70)
	for _, sideX in ipairs({-1.95, 1.95}) do
		for i = 1, 8 do
			local linkRootFinal = baseCF * CFrame.new(sideX, 2.3 - (i - 1) * 0.56, 0) * CFrame.Angles(0, math.rad(i % 2 == 0 and 90 or 0), 0)
			local linkRootStart = linkRootFinal * CFrame.new(0, 7 + i * 0.22, 0)
			local _, segs = makeMultiWaypointChainLink(model, linkRootStart, 0.21, 0.075, chainColor, 6)
			for _, s in ipairs(segs) do
				local finalCF = linkRootFinal * s.offset
				local segPart = s.part
				task.delay(0.05 + i * 0.045, function()
					if segPart and segPart.Parent then
						TweenService:Create(segPart, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {CFrame = finalCF}):Play()
					end
				end)
			end
		end
	end

	-- Elos de corrente orbitando o portal
	local orbitLinks = {}
	for _ = 1, 7 do
		local linkModel, segs = makeMultiWaypointChainLink(model, baseCF, 0.22, 0.08, Color3.fromRGB(84, 70, 118), 6)
		for _, s in ipairs(segs) do
			s.part.Transparency = 0.15
		end
		table.insert(orbitLinks, {model = linkModel, segs = segs})
	end

	-- Raios electricos em volta do portal
	local lightningSys = makeMultiWaypointLightning(model, baseCF, 1.65, 2.55, 2, 6)

	local lifetime = 1.7
	local elapsed = 0
	local heartbeatConn
	heartbeatConn = RunService.Heartbeat:Connect(function(dt)
		elapsed = elapsed + dt
		local remaining = lifetime - elapsed

		for i, entry in ipairs(orbitLinks) do
			if entry.model and entry.model.Parent then
				local angle = (math.pi * 2 / #orbitLinks) * i + elapsed * 3.2
				local radius = 2.75 + math.sin(elapsed * 4 + i) * 0.15
				local offset = CFrame.new(math.cos(angle) * radius, math.sin(elapsed * 2.5 + i) * 0.8, math.sin(angle) * radius) * CFrame.Angles(math.rad(90), 0, angle)
				entry.model:PivotTo(baseCF * offset)
			end
		end

		updateMultiWaypointLightning(lightningSys, dt)

		-- Fade final dos elos orbitando e raios
		if remaining <= 0.4 then
			local t = 1 - math.clamp(remaining / 0.4, 0, 1)
			for _, entry in ipairs(orbitLinks) do
				for _, s in ipairs(entry.segs) do
					if s.part and s.part.Parent then
						s.part.Transparency = 0.15 + t * 0.85
					end
				end
			end
			for _, bolt in ipairs(lightningSys.bolts) do
				for _, seg in ipairs(bolt.segs) do
					if seg and seg.Parent then
						seg.Transparency = 1
					end
				end
			end
		end

		if remaining <= 0 then
			heartbeatConn:Disconnect()
			pcall(function()
				model:Destroy()
			end)
		end
	end)

	task.delay(lifetime - 0.4, function()
		if frame and frame.Parent then
			TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1}):Play()
			TweenService:Create(glow, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1}):Play()
		end
	end)

	task.delay(lifetime + 0.6, function()
		pcall(function()
			if model and model.Parent then
				model:Destroy()
			end
		end)
		if heartbeatConn then
			heartbeatConn:Disconnect()
		end
	end)
end

