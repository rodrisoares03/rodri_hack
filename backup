function nmSaveProfile(name)
	local raw = name
	if raw == nil and nmNameInput then raw = nmNameInput.Text end
	if type(raw) == "string" and #raw > 32 then
		nmSetStatus("nome longo cortado para 32 caracteres", Color3.fromRGB(255, 190, 100))
	end
	local clean = nmResolveName(name, false)
	if not clean then
		nmSetStatus("type a profile name first", Color3.fromRGB(255, 120, 120))
		return false
	end
	local okCollect, cfg = pcall(nmCollectSettings)
	if not okCollect or type(cfg) ~= "table" then
		nmSetStatus("save failed: " .. tostring(cfg), Color3.fromRGB(255, 120, 120))
		return false
	end
	local store = nmReadStore()
	local isUpdate = type(store.profiles[clean]) == "table"
	store.profiles[clean] = cfg
	store.last = clean
	local ok, err = nmWriteStore(store)
	if not ok then
		nmSetStatus("save failed: " .. tostring(err), Color3.fromRGB(255, 120, 120))
		return false
	end
	nmSelected = clean
	-- Mostra exatamente qual nome foi salvo (evita sobrescrever outro perfil sem aviso)
	if nmNameInput then nmNameInput.Text = clean end
	nmRefreshProfiles()
	local diskOk = nmVerifyProfileOnDisk(clean)
	if diskOk then
		local statusText = isUpdate and ("updated: " .. clean) or ("saved: " .. clean)
		nmSetStatus(statusText, Color3.fromRGB(170, 255, 170))
	else
		nmSetStatus("salvo na memoria, mas o arquivo nao confirmou: " .. clean, Color3.fromRGB(255, 190, 100))
	end
	showMenuToast(isUpdate and "Profile Updated" or "Profile Saved", clean, Color3.fromRGB(170, 255, 170))
	return true
end

function nmLoadProfile(name)
	local clean = nmResolveName(name, true)
	if not clean then
		nmSetStatus("select or type a profile name", Color3.fromRGB(255, 120, 120))
		return false
	end
	local store = nmReadStore()
	local cfg = store.profiles[clean]
	if type(cfg) ~= "table" then
		nmSetStatus("profile not found: " .. clean, Color3.fromRGB(255, 120, 120))
		return false
	end
	nmApplySettings(cfg)
	store.last = clean
	nmWriteStore(store)
	nmSelected = clean
	if nmNameInput then nmNameInput.Text = clean end
	nmRefreshProfiles()
	nmSetStatus("loaded: " .. clean, Color3.fromRGB(170, 255, 170))
	showMenuToast("Profile Loaded", clean, Color3.fromRGB(170, 220, 255))
	return true
end

function nmDeleteProfile(name)
	local clean = nmResolveName(name, true)
	if not clean then
		nmSetStatus("select or type a profile name", Color3.fromRGB(255, 120, 120))
		return false
	end
	local store = nmReadStore()
	if type(store.profiles[clean]) ~= "table" then
		nmSetStatus("profile not found: " .. clean, Color3.fromRGB(255, 120, 120))
		return false
	end
	store.profiles[clean] = nil
	if store.last == clean then store.last = nil end
	local ok, err = nmWriteStore(store)
	if not ok then
		nmSetStatus("delete failed: " .. tostring(err), Color3.fromRGB(255, 120, 120))
		return false
	end
	if nmSelected == clean then nmSelected = nil end
	nmRefreshProfiles()
	nmSetStatus("deleted: " .. clean, Color3.fromRGB(170, 255, 170))
	return true
end

