local AUTOEXEC_CHOICE_FILE = "night_autoexec_choice.txt"
local NIGHT_MENU_VERSION = "v6.1-2026-11-25"

local function writeAutoExecChoice(enabled)
	if type(writefile) ~= "function" then return end
	pcall(function()
		writefile(AUTOEXEC_CHOICE_FILE, NIGHT_MENU_VERSION .. "|" .. (enabled and "yes" or "no"))
	end)
end

local function readAutoExecChoice()
	if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
	local ok, exists = pcall(isfile, AUTOEXEC_CHOICE_FILE)
	if not ok or not exists then return nil end
	local ok2, content = pcall(readfile, AUTOEXEC_CHOICE_FILE)
	if not ok2 or not content then return nil end
	local value = tostring(content):match("^%s*(.-)%s*$")
	-- formato antigo ("yes"/"no") conta como escolha de outra versao -> pergunta de novo
	local savedVersion, choice = value:match("^([^|]+)|([^|]+)$")
	if not savedVersion or savedVersion ~= NIGHT_MENU_VERSION then return nil end
	if choice == "yes" then return true end
	if choice == "no" then return false end
	return nil
end

