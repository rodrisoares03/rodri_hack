-- Linha de tiro rigida: qualquer parede bloqueia (nao usa penetracao)
function betaHasClearShot(origin, endPos, ignored)
	local delta = endPos - origin
	local dist = delta.Magnitude
	if dist < 0.01 then return true end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = type(ignored) == "table" and ignored or {}
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local result = workspace:Raycast(origin, delta.Unit * dist, params)
	return result == nil
end

-- Silent aim embutido: aumenta a hitbox da CABECA (cobre o corpo todo) e do torso.
-- Size continua gigante (hitbox), mas Transparency = 1 esconde as partes da SUA visao (cliente).
function betaExpandHitbox(model)
	if not model or betaHitboxBackup[model] then return betaHitboxGen[model] or 0 end
	betaHitboxGen[model] = (betaHitboxGen[model] or 0) + 1
	local backup = {}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local isHead = part.Name == "Head"
			local isTorso = part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso"
			if isHead or isTorso then
				backup[part] = {size = part.Size, transparency = part.Transparency}
				pcall(function()
					if isHead then
						-- Cabeca gigante (hitbox igual), mas oculta na SUA visao
						-- Qualquer tiro no corpo continua contando como cabeca
						part.Size = Vector3.new(8, 8, 8)
						part.Transparency = 1
					else
						-- Torso gigante (hitbox igual), tambem oculto na sua visao
						part.Size = Vector3.new(part.Size.X * 3, part.Size.Y * 3, part.Size.Z * 3)
						part.Transparency = 1
					end
				end)
			end
		end
	end
	betaHitboxBackup[model] = backup
	return betaHitboxGen[model]
end

function betaRestoreHitbox(model)
	local backup = model and betaHitboxBackup[model]
	if not backup then return end
	for part, data in pairs(backup) do
		pcall(function()
			if part and part.Parent then
				part.Size = data.size
				part.Transparency = data.transparency
			end
		end)
	end
	betaHitboxBackup[model] = nil
end

function betaRestoreAllHitboxes()
	for model in pairs(betaHitboxBackup) do
		pcall(betaRestoreHitbox, model)
	end
	betaHitboxBackup = {}
	betaHitboxGen = {}
end

