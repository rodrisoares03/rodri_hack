-- Redimensionar UI (estilo Solix: mainFrame 960x600, topbar 38, sidebar 185)
function resizeUI(newWidth, newHeight)
	menuExpandedSize = UDim2.new(0, newWidth, 0, newHeight)
	mainFrame.Position = UDim2.new(0.5, -newWidth/2, 0.5, -newHeight/2)
	mainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
	if newHeight >= 100 then
		sidebar.Visible = true
		content.Visible = true
	end
	local headerH = math.max(38, math.min(40, math.floor(newHeight * 38 / 600)))
	header.Size = UDim2.new(1, 0, 0, headerH)
	sidebar.Size = UDim2.new(0, 200, 1, -headerH)
	content.Size = UDim2.new(1, -200, 1, -headerH)
	content.Position = UDim2.new(0, 200, 0, headerH)
	local fontScale = newHeight / 600
	title.TextSize = math.max(12, 13 * fontScale)
	for _, tabData in pairs(tabs) do
		local label = tabData[3]
		if label and label:IsA("TextLabel") then
			label.TextSize = math.max(11, 12 * fontScale)
		end
	end
	for _, page in pairs(pages) do
		if page:IsA("ScrollingFrame") then
			for _, child in ipairs(page:GetDescendants()) do
				if child:IsA("TextLabel") or child:IsA("TextButton") then
					child.TextSize = math.max(10, 12 * fontScale)
				elseif child:IsA("TextBox") then
					child.TextSize = math.max(10, 12 * fontScale)
				end
			end
		end
	end
	if miscSubPagesHolder then
		for _, child in ipairs(miscSubPagesHolder:GetDescendants()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") then
				child.TextSize = math.max(10, 12 * fontScale)
			elseif child:IsA("TextBox") then
				child.TextSize = math.max(10, 12 * fontScale)
			end
		end
	end
	task.defer(refreshUtilCanvas)
end

