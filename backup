local MOUSE_BIND_ALIASES = {
	MouseButton1 = "MouseLeft", MouseButton2 = "MouseRight", MouseButton3 = "MouseMiddle",
	MouseButton4 = "X1", MouseButton5 = "X2",
	MouseLeft = "MouseLeft", MouseRight = "MouseRight", MouseMiddle = "MouseMiddle",
	X1 = "X1", X2 = "X2",
}

function nmEncodeBind(value)
	if typeof(value) == "EnumItem" then
		-- UserInputType de mouse deve ser guardado como bind de mouse, nunca como KeyCode
		if value.EnumType == Enum.UserInputType then
			local mapped = MOUSE_BIND_ALIASES[value.Name] or value.Name
			return {k = "mouse", v = mapped}
		end
		return {k = "key", v = value.Name}
	end
	if type(value) == "string" and value ~= "" and value ~= "None" then
		if MOUSE_BIND_ALIASES[value] then return {k = "mouse", v = MOUSE_BIND_ALIASES[value]} end
		return {k = "mouse", v = value}
	end
	return nil
end

function nmDecodeBind(data)
	if type(data) ~= "table" then return nil, "None" end
	local raw = tostring(data.v or "")
	if raw == "" then return nil, "None" end
	if data.k == "key" then
		-- Tentativa segura: versoes antigas guardavam MouseButton2 dentro de "key"
		local okKey, key = pcall(function() return Enum.KeyCode[raw] end)
		if okKey and key then return key, raw end
		local mapped = MOUSE_BIND_ALIASES[raw]
		if mapped then return mapped, mapped end
	elseif data.k == "mouse" then
		local mapped = MOUSE_BIND_ALIASES[raw] or raw
		return mapped, mapped
	end
	return nil, "None"
end

-- IMPORTANTE: usar chaves TEXTO. Indices numericos viram chaves de string no JSON
-- (ex.: [2] -> "2") e o Decode antigo nao encontrava mais os componentes.
function nmEncodeValue(value)
	local t = typeof(value)
	if t == "Color3" then return {t = "Color3", r = value.R, g = value.G, b = value.B} end
	if t == "Vector2" then return {t = "Vector2", x = value.X, y = value.Y} end
	if t == "Vector3" then return {t = "Vector3", x = value.X, y = value.Y, z = value.Z} end
	if t == "UDim2" then return {t = "UDim2", xs = value.X.Scale, xo = value.X.Offset, ys = value.Y.Scale, yo = value.Y.Offset} end
	if t == "EnumItem" then return {t = "Enum", enum = tostring(value.EnumType):gsub("^Enum%.", ""), name = value.Name} end
	if type(value) == "number" or type(value) == "string" or type(value) == "boolean" then return value end
	return nil
end

function nmSavedField(saved, letter, numericIndex)
	return saved[letter] or saved[tostring(numericIndex)] or saved[numericIndex]
end

function nmDecodeValue(saved)
	if typeof(saved) == "Color3" then return saved end
	if type(saved) ~= "table" then
		if type(saved) == "number" or type(saved) == "string" or type(saved) == "boolean" then return saved end
		return nil
	end
	if saved.t == "Color3" then
		local r = nmSavedField(saved, "r", 2)
		local g = nmSavedField(saved, "g", 3)
		local b = nmSavedField(saved, "b", 4)
		if type(r) == "number" and type(g) == "number" and type(b) == "number" then
			return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
		end
	elseif saved.t == "Vector2" then
		local x = nmSavedField(saved, "x", 2)
		local y = nmSavedField(saved, "y", 3)
		if type(x) == "number" and type(y) == "number" then return Vector2.new(x, y) end
	elseif saved.t == "Vector3" then
		local x = nmSavedField(saved, "x", 2)
		local y = nmSavedField(saved, "y", 3)
		local z = nmSavedField(saved, "z", 4)
		if type(x) == "number" and type(y) == "number" and type(z) == "number" then return Vector3.new(x, y, z) end
	elseif saved.t == "UDim2" then
		local xs = nmSavedField(saved, "xs", 2)
		local xo = nmSavedField(saved, "xo", 3)
		local ys = nmSavedField(saved, "ys", 4)
		local yo = nmSavedField(saved, "yo", 5)
		if type(xs) == "number" and type(xo) == "number" and type(ys) == "number" and type(yo) == "number" then
			return UDim2.new(xs, xo, ys, yo)
		end
	elseif saved.t == "Enum" then
		local enumName = saved.enum or saved[2]
		local itemName = saved.name or saved[3]
		if type(enumName) == "string" and type(itemName) == "string" then
			local enumType = Enum[enumName]
			return enumType and enumType[itemName] or nil
		end
	end
	return nil
end

function nmEmptyStore()
	return {profiles = {}, ui = {}, last = nil}
end

-- Cache do store: uma leitura falha NUNCA pode apagar os perfis salvos.
nmStoreCache = nil
nmStorePath = nil

-- Alguns executores trocam a raiz de arquivos entre lugares (jogos diferentes).
-- Gravar/ler em mais de um caminho aumenta a chance do perfil sobreviver ao rejoin.
function nmStorePaths()
	local paths = {}
	local function add(path)
		if type(path) ~= "string" or path == "" then return end
		for _, existing in ipairs(paths) do
			if existing == path then return end
		end
		table.insert(paths, path)
	end
	add(nmStoreFile)
	if type(makefolder) == "function" and type(isfolder) == "function" then
		pcall(function()
			if not isfolder("night_menu") then makefolder("night_menu") end
		end)
		add("night_menu/" .. nmStoreFile)
	end
	return paths
end

function nmReadStore()
	-- O store em memoria e sempre o mais recente (ele e atualizado em nmWriteStore).
	-- Reler o disco logo apos salvar pode devolver conteudo antigo em alguns executores.
	if nmStoreCache then return nmStoreCache end
	if not readfile then return nmEmptyStore() end
	for _, path in ipairs(nmStorePaths()) do
		local okContent, content = pcall(readfile, path)
		if okContent and type(content) == "string" and content ~= "" then
			local okData, data = pcall(function() return HttpService:JSONDecode(content) end)
			if okData and type(data) == "table" then
				if type(data.profiles) ~= "table" then data.profiles = {} end
				if type(data.ui) ~= "table" then data.ui = {} end
				nmStorePath = path
				nmStoreCache = data
				return data
			end
		end
	end
	return nmStoreCache or nmEmptyStore()
end

function nmWriteStore(store)
	if type(store) ~= "table" then return false, "invalid store" end
	store.profiles = type(store.profiles) == "table" and store.profiles or {}
	store.ui = type(store.ui) == "table" and store.ui or {}
	if not writefile then
		nmStoreCache = store
		return false, "executor has no writefile"
	end
	local ok, content = pcall(function() return HttpService:JSONEncode(store) end)
	if not ok then return false, tostring(content) end
	local wrote, lastErr = false, nil
	for _, path in ipairs(nmStorePaths()) do
		local ok2, err = pcall(function() writefile(path, content) end)
		if ok2 then
			wrote = true
			nmStorePath = path
		else
			lastErr = tostring(err)
		end
	end
	nmStoreCache = store
	if not wrote then return false, lastErr or "writefile failed" end
	return true
end

-- Confere (sem usar o cache) se o nome realmente chegou ao arquivo no disco.
function nmVerifyProfileOnDisk(name)
	if not readfile or type(name) ~= "string" then return false end
	for _, path in ipairs(nmStorePaths()) do
		local ok, content = pcall(readfile, path)
		if ok and type(content) == "string" and content:find(name, 1, true) then
			return true
		end
	end
	return false
end

function nmCleanName(name)
	if type(name) ~= "string" then return nil end
	local clean = name:gsub("^%s+", ""):gsub("%s+$", "")
	if clean == "" then return nil end
	return clean:sub(1, 32)
end

-- Um unico ponto de resolucao de nome.
-- SAVE nao permite cair no nome de outro perfil; LOAD/DELETE podem usar a selecao.
function nmResolveName(explicit, allowSelected)
	local clean = nmCleanName(explicit)
	if clean then return clean end
	if nmNameInput then
		clean = nmCleanName(nmNameInput.Text)
		if clean then return clean end
	end
	if allowSelected then return nmCleanName(nmSelected) end
	return nil
end

function nmCollectSettings()
	local cfg = {toggles = {}, binds = {}, values = {}}
	for key, entry in pairs(nmToggles) do
		if entry and entry.getState then cfg.toggles[key] = entry.getState() and true or false end
	end
	for id, entry in pairs(nmBinds) do
		if entry and entry.getBindValue then
			cfg.binds[id] = nmEncodeBind(entry.getBindValue()) or {k = "none"}
		end
	end
	for _, key in ipairs(NM_VALUE_KEYS) do
		local encoded = nmEncodeValue(nmGetVar(key))
		if encoded ~= nil then cfg.values[key] = encoded end
	end
	if _G.hitboxColor then cfg.values.hitboxColor = nmEncodeValue(_G.hitboxColor) end
	if FlySystem then cfg.values.flySpeed = FlySystem.speed end
	cfg.values.friendUserIds = collectMenuFriendIds()
	return cfg
end

