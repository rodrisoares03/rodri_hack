function refreshESPForPlayer(p)
	if p == LocalPlayer then return end

	local data = syncPlayerCharacter(p)
	local char = data and data.character
	if not char then return end

	local humanoid = data and data.humanoid or char:FindFirstChildOfClass("Humanoid")
	local root = data and data.root or char:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		cleanupESPForCharacter(char)
		return
	end

	if espEnabled then
		ensureHighlight(char)
		ensureBox3D(char)
		if showTracers then
			ensureTracer(char)
		end
		if showEspDistance then
			ensureDistanceLabel(char)
		end
		if showName then
			ensureNameLabel(char, p)
		end
		if showHealth then
			ensureHealthBar(char)
		end
	else
		cleanupESPForCharacter(char)
	end
end

-- Sistema ESP Otimizado - Atualiza automaticamente após morte
function cleanupESPForCharacter(character)
	if not character then return end

	pcall(function()
		if overlays[character] then
			overlays[character]:Destroy()
			overlays[character] = nil
		end
		if highlights[character] then
			highlights[character]:Destroy()
			highlights[character] = nil
		end
		if boxes[character] then
			pcall(function() boxes[character]:Destroy() end)
			boxes[character] = nil
		end
		if distanceLabels[character] then
			distanceLabels[character]:Remove()
			distanceLabels[character] = nil
		end
		if nameLabels[character] then
			nameLabels[character]:Remove()
			nameLabels[character] = nil
		end
		if tracers[character] then
			tracers[character]:Remove()
			tracers[character] = nil
		end
		if healthBars[character] then
			if healthBars[character].bg then healthBars[character].bg:Remove() end
			if healthBars[character].fill then healthBars[character].fill:Remove() end
			healthBars[character] = nil
		end
	end)
end

-- ========= NPC ESP FUNCTIONS =========

function getNPCsFromWorkspace()
	local npcs = {}
	local myChar = LocalPlayer.Character
	local myRoot = myChar and getPrimaryPart(myChar)
	-- Sem root (morte/respawn) nao substitui a cache: isso apagava o ESP e fazia piscar
	if not myRoot then return nil end

	-- Sem filtro de "onScreen" aqui: NPCs fora do ecra no momento do scan ficavam
	-- fora da cache durante o intervalo inteiro e o ESP so aparecia depois ("reload").
	-- O culling visual por-frame ja e feito nos ensure* (Visible=false quando off-screen).
	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model") and model ~= myChar then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = getPrimaryPart(model)
			if humanoid and root and root:IsA("BasePart") and humanoid.Health > 0 then
				local isPlayer = Players:GetPlayerFromCharacter(model)
				if not isPlayer then
					local dist = (root.Position - myRoot.Position).Magnitude
					if dist <= ESP_MAX_DISTANCE then
						table.insert(npcs, {model = model, humanoid = humanoid, root = root, distance = dist})
					end
				end
			end
		end
	end
	return npcs
end

function ensureNpcHighlight(model)
	if not model or not model.Parent then
		if npcHighlights[model] then
			pcall(function() npcHighlights[model]:Destroy() end)
			npcHighlights[model] = nil
		end
		return
	end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and getPrimaryPart(myChar)
	local targetRoot = getPrimaryPart(model)
	if myRoot and targetRoot then
		local distance = (targetRoot.Position - myRoot.Position).Magnitude
		if distance >= ESP_MAX_DISTANCE then
			if npcHighlights[model] then
				pcall(function() npcHighlights[model]:Destroy() end)
				npcHighlights[model] = nil
			end
			return
		end
	end

	local h = npcHighlights[model]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "NpcESP"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Adornee = model
		h.Parent = LocalPlayer:WaitForChild("PlayerGui")
		npcHighlights[model] = h
	end

	if npcAutoEspEnabled and targetRoot then
		-- Raycast com cache de 0.2s por NPC (antes: 1 raycast por NPC POR FRAME = stutter)
		local now = tick()
		local visibility = npcVisibilityCache[model]
		if not visibility or now - visibility.at > 0.2 then
			local rayOrigin = workspace.CurrentCamera.CFrame.Position
			local rayDir = (targetRoot.Position - rayOrigin).Unit * 100
			local raycastParams = RaycastParams.new()
			local ignore = {model}
			if myChar then table.insert(ignore, myChar) end
			raycastParams.FilterDescendantsInstances = ignore
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			local result = workspace:Raycast(rayOrigin, rayDir, raycastParams)
			visibility = {visible = (result == nil), at = now}
			npcVisibilityCache[model] = visibility
		end
		if visibility.visible then
			-- Cor escolhida no botao COLOR quando visivel
			h.FillColor = npcSkeletonColor
			h.OutlineColor = npcSkeletonColor
		else
			-- Vermelho quando oculto
			h.FillColor = Color3.fromRGB(255, 0, 0)
			h.OutlineColor = Color3.fromRGB(255, 0, 0)
		end
	else
		-- Sem Auto ESP (ou sem root para o raycast): usa sempre a cor escolhida
		h.FillColor = npcSkeletonColor
		h.OutlineColor = npcSkeletonColor
	end

	if npcEspMode == "Cheio" then
		h.FillTransparency = 0
		h.OutlineTransparency = 0
	else
		h.FillTransparency = 1
		h.OutlineTransparency = 0
	end

	h.Enabled = true
end

function ensureNpcBox3D(model)
	if not model or not model.Parent then
		if npcBoxes[model] then
			pcall(function() npcBoxes[model]:Destroy() end)
			npcBoxes[model] = nil
		end
		return
	end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and getPrimaryPart(myChar)
	local targetRoot = getPrimaryPart(model)
	if myRoot and targetRoot then
		local distance = (targetRoot.Position - myRoot.Position).Magnitude
		if distance >= ESP_MAX_DISTANCE then
			if npcBoxes[model] then
				pcall(function() npcBoxes[model]:Destroy() end)
				npcBoxes[model] = nil
			end
			return
		end
	end

	local head = model:FindFirstChild("Head")
	local humanoidRootPart = getPrimaryPart(model)
	if not head or not humanoidRootPart then return end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15
	local charHeight = (isR15 and 5.4 or 5.0) + 0.6
	local charWidth = (isR15 and 3.2 or 2.8) + 0.4
	local offsetY = isR15 and -0.4 or -0.3

	-- Tamanho em PIXELS proporcionais a distancia (Scale em BillboardGui e relativo a tela!)
	local npcCamera = workspace.CurrentCamera
	local boxWPx, boxHPx = charWidth, charHeight
	if npcCamera then
		local denom = 2 * math.tan(math.rad(npcCamera.FieldOfView) / 2)
		local camDist = (humanoidRootPart.Position - npcCamera.CFrame.Position).Magnitude
		if denom > 0 and camDist > 0.1 then
			local pxPerStud = npcCamera.ViewportSize.Y / (denom * camDist)
			boxWPx = math.clamp(math.floor(charWidth * pxPerStud), 6, 2000)
			boxHPx = math.clamp(math.floor(charHeight * pxPerStud), 6, 2000)
		end
	end

	if not npcBoxes[model] then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "NpcESP_Box"
		billboard.Adornee = humanoidRootPart
		billboard.Size = UDim2.fromOffset(boxWPx, boxHPx)
		billboard.StudsOffset = Vector3.new(0, offsetY, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = humanoidRootPart

		local frame = Instance.new("Frame")
		frame.Name = "BoxFrame"
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundTransparency = 1
		frame.Parent = billboard

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 3)
		corner.Parent = frame

		local stroke = Instance.new("UIStroke")
		stroke.Color = npcEspColor
		stroke.Thickness = 2.5
		stroke.Transparency = 0.1
		stroke.Parent = frame

		npcBoxes[model] = billboard
	end

	local billboard = npcBoxes[model]
	if billboard and billboard.Parent then
		billboard.Size = UDim2.fromOffset(boxWPx, boxHPx)
		billboard.StudsOffset = Vector3.new(0, offsetY, 0)
		local frame = billboard:FindFirstChild("BoxFrame") or billboard:FindFirstChildOfClass("Frame")
		if frame then
			local stroke = frame:FindFirstChildOfClass("UIStroke")
			if stroke then stroke.Color = npcEspColor end
		end
	end
end

