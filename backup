		_G.magnetLoop = RunService.Heartbeat:Connect(function()
			if not magnetEnabled or not LocalPlayer.Character then return end
			
			local myChar = LocalPlayer.Character
			local myRoot = myChar:FindFirstChild("HumanoidRootPart")
			if not myRoot then return end
			
			for _, player in pairs(Players:GetPlayers()) do
				pcall(function()
					if player ~= LocalPlayer and player.Character then
						if isEnemy(player) and isInSameDimension(player.Character) then
							local tChar = player.Character
							local tRoot = tChar:FindFirstChild("HumanoidRootPart")
							local tHum = tChar:FindFirstChildOfClass("Humanoid")
							
							if not tRoot or not tHum then return end
							
-- SALVAR posição e stats ORIGINAIS só uma vez
								if not _G.magnetOriginalPositions[player] then
									_G.magnetOriginalPositions[player] = tRoot.CFrame
								end
								if not _G.magnetOriginalStats[player] then
									_G.magnetOriginalStats[player] = {
										WalkSpeed = tHum.WalkSpeed,
										JumpPower = tHum.JumpPower,
										AutoRotate = tHum.AutoRotate
									}
								end
								
								-- PUXAR SEMPRE, TODO FRAME, NUNCA PARA
								tRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -magnetDistance)
								
								-- ZERAR TODA VELOCIDADE PARA NÃO ESCAPAR
								tRoot.AssemblyLinearVelocity = Vector3.zero
								tRoot.AssemblyAngularVelocity = Vector3.zero
								tRoot.Velocity = Vector3.zero
								tRoot.RotVelocity = Vector3.zero
								
								-- TRAVAR MOVIMENTO DO ALVO
								tHum.WalkSpeed = 0
								tHum.JumpPower = 0
								tHum.AutoRotate = false
							end
						end
				end)
			end
		end)
	else
		if _G.magnetLoop then _G.magnetLoop:Disconnect() end
		
		-- RESTAURAR TUDO AO NORMAL QUANDO DESATIVAR
		for _, player in pairs(Players:GetPlayers()) do
			pcall(function()
				if player.Character then
					local tRoot = player.Character:FindFirstChild("HumanoidRootPart")
					local tHum = player.Character:FindFirstChildOfClass("Humanoid")
					
					-- VOLTAR PARA POSIÇÃO ORIGINAL
					if _G.magnetOriginalPositions[player] and tRoot then
						tRoot.CFrame = _G.magnetOriginalPositions[player]
						tRoot.AssemblyLinearVelocity = Vector3.zero
					end
					
					-- RESTAURAR STATS ORIGINAIS
					if _G.magnetOriginalStats[player] and tHum then
						tHum.WalkSpeed = _G.magnetOriginalStats[player].WalkSpeed
						tHum.JumpPower = _G.magnetOriginalStats[player].JumpPower
						tHum.AutoRotate = _G.magnetOriginalStats[player].AutoRotate
					end
				end
			end)
		end
		
		-- LIMPAR CACHE
		_G.magnetOriginalPositions = {}
		_G.magnetOriginalStats = {}
	end
end, "Pulls enemies closer while active and restores them when off.", {
