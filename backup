function applyStoredMenuSettings()
	local store = nmReadStore()
	local settings = store.ui or {}

	suppressThemeFeedback = true
	pcall(function()
		if type(settings.friendUserIds) == "table" then
			playerFriendIds = {}
			for _, userId in ipairs(settings.friendUserIds) do playerFriendIds[tostring(userId)] = true end
			if currentAimbotTarget and isMenuFriend(currentAimbotTarget) then currentAimbotTarget = nil end
			if magnetTarget and isMenuFriend(magnetTarget) and stopMagnet then stopMagnet() end
			if infinitePushTarget and isMenuFriend(infinitePushTarget) and stopInfinitePush then stopInfinitePush() end
			if killTargetPlayer and isMenuFriend(killTargetPlayer) and stopKilling then stopKilling() end
			for _, plr in ipairs(Players:GetPlayers()) do
				updatePlayerFriendVisual(plr)
				if plr.Character and refreshESPForPlayer then pcall(refreshESPForPlayer, plr) end
			end
		end
		if settings.autoExecuteEnabled ~= nil then autoExecuteEnabled = settings.autoExecuteEnabled and true or false end
		if settings.hasCustomSizePreference ~= nil then hasCustomSizePreference = settings.hasCustomSizePreference and true or false end
		if type(settings.language) == "string" and LANGUAGE_NAMES[settings.language] then
			currentUILanguage = settings.language
			refreshLocalizedMenuText()
			if refreshLanguageOptionButtons then refreshLanguageOptionButtons() end
		end
		if settings.themeName and THEME_PRESETS[settings.themeName] then applyThemePreset(settings.themeName) end
		if settings.themeStyle and THEME_STYLES[settings.themeStyle] then applyThemeStyle(settings.themeStyle) end
		if hasCustomSizePreference and settings.sizeIndex and menuSizes and menuSizes[settings.sizeIndex] then applyThemeSize(settings.sizeIndex) end
		if type(settings.activeMiscTab) == "string" and miscSubPages[settings.activeMiscTab] then setMiscSubTab(settings.activeMiscTab) end
		if type(settings.activeTab) == "string" and tabs[settings.activeTab] and pages[settings.activeTab] then setTab(settings.activeTab) end
		local storedMain = unpackInterfacePosition(settings.mainFramePosition)
		if storedMain then mainFrame.Position = storedMain menuExpandedPosition = storedMain end
		local storedRestore = unpackInterfacePosition(settings.restoreButtonPosition)
		if storedRestore then
			restoreButtonDefaultPosition = storedRestore
			if restoreButton then restoreButton.Position = storedRestore end
		end
	end)
	suppressThemeFeedback = false
	pcall(updateThemeStatus)
end


