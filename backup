-- ========= SUBCATEGORIA: NPC TRIGGERBOT / NPC HITBOX =========
function rememberNpcHitbox(npcModel, npcRoot)
	if not _G.npcHitboxOriginalSizes[npcModel] then
		_G.npcHitboxOriginalSizes[npcModel] = {
			Root = npcRoot,
			Size = npcRoot.Size,
			Transparency = npcRoot.Transparency,
			Material = npcRoot.Material,
		}
	end
end

function applyNpcHitbox(info)
	local npcModel = info and info.model
	local npcRoot = info and info.root
	if not npcModel or not npcModel.Parent or not npcRoot or not npcRoot.Parent then return end
	rememberNpcHitbox(npcModel, npcRoot)
	npcRoot.Size = Vector3.new(npcHitboxSize, npcHitboxSize, npcHitboxSize)
	npcRoot.Transparency = 1
	npcRoot.CanCollide = false
end

function clearNpcHitbox(npcModel, npcRoot)
	local original = _G.npcHitboxOriginalSizes[npcModel]
	npcRoot = npcRoot or (original and original.Root)
	if npcRoot and npcRoot.Parent and original then
		npcRoot.Size = original.Size
		npcRoot.Transparency = original.Transparency
		npcRoot.Material = original.Material
	end
	_G.npcHitboxOriginalSizes[npcModel] = nil
end

