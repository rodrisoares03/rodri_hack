function nmRefreshProfiles()
	if not nmListScroll then return end
	local store = nmReadStore()
	local names = {}
	for name in pairs(store.profiles) do table.insert(names, name) end
	table.sort(names, function(a, b) return tostring(a):lower() < tostring(b):lower() end)

	local signature = table.concat(names, "\0")
	-- Selecionar um perfil nao deve reconstruir a lista (evita clique cair na linha errada)
	if signature == nmProfileListSignature and next(nmProfileRows) then
		nmUpdateProfileHighlights()
		return
	end

	for _, child in ipairs(nmListScroll:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
