local function updateInfinitePushButton()
	if not infinitePushBtn then
		return
	end

	if infinitePushEnabled then
		infinitePushBtn.Text = "STOP PUSH"
		infinitePushBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
	else
		infinitePushBtn.Text = "INFINITE PUSH"
infinitePushBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
	end
