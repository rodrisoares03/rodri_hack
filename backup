-- Continuous aiming
RunService.RenderStepped:Connect(function()
	-- NPC Aimbot
	if npcAimbotEnabled then
		if tick() - lastNpcTargetUpdateTime >= 0.15 then
			currentNpcAimbotTarget = getClosestNPC()
			lastNpcTargetUpdateTime = tick()
		end
		if currentNpcAimbotTarget and npcAimbotKeyHeld then
			aimAtNPC(currentNpcAimbotTarget)
		end
	else
		currentNpcAimbotTarget = nil
	end

	-- NPC Triggerbot: dispara quando a mira esta sobre um NPC
	if npcTriggerEnabled and not panelVisible then
		local nowNpcTrigger = tick()
		-- Trigger apenas LE a cache do ESP (nunca escreve nela) para nao baguncar os visuais
		if nowNpcTrigger - lastNpcTriggerShot >= npcTriggerCooldown then
			local triggerCamera = workspace.CurrentCamera
			local triggerChar = LocalPlayer.Character
			if triggerCamera and triggerChar then
				local result = raycastSkipPenetrable(
					triggerCamera.CFrame.Position,
					triggerCamera.CFrame.LookVector,
					1000,
					{triggerChar, triggerCamera}
				)
				if result and result.Instance then
					local hitPart = result.Instance
					while hitPart do
						local triggeredModel = nil
						for _, info in ipairs(npcEspCachedModels) do
							if info.model == hitPart then
								triggeredModel = info.model
								break
							end
						end
						if triggeredModel then
							local npcRoot = getPrimaryPart(triggeredModel)
							local myRootNow = getPrimaryPart(triggerChar)
							local maxRange = getAutofireRange()
							local inRange = not (npcRoot and myRootNow) or maxRange == math.huge
								or (npcRoot.Position - myRootNow.Position).Magnitude <= maxRange
							if inRange and crosshairOnModel(triggeredModel, 1000, true) then
								if npcTriggerCandidateSince == 0 then npcTriggerCandidateSince = nowNpcTrigger end
								if nowNpcTrigger - npcTriggerCandidateSince >= autofireTriggerDelay then
									fireAutofireShot()
									lastNpcTriggerShot = nowNpcTrigger
									npcTriggerCandidateSince = 0
								end
							else
								npcTriggerCandidateSince = 0
							end
							break
						end
						hitPart = hitPart.Parent
					end
				else
					npcTriggerCandidateSince = 0
				end
			else
				npcTriggerCandidateSince = 0
			end
		end
	end

	if aimbotEnabled then
		-- Sempre procurar alvo se o Aimbot estiver ligado (para o Autofire usar)
		if tick() - lastTargetUpdateTime >= 0.15 then
			currentAimbotTarget = getClosestPlayer()
			lastTargetUpdateTime = tick()
		end
		
		-- Com Silent Aim a camera NAO gira: o redirecionamento e feito nos raycasts/remotos
		if currentAimbotTarget and (aimbotKeyHeld or isInMovingVehicle()) and not silentAimEnabled then
			aimAt(currentAimbotTarget)
		end
	else
		currentAimbotTarget = nil
	end

	-- NO RECOIL: estabiliza a rotacao da camera quando nao ha movimento de mouse
	if noRecoilEnabled and noRecoilStabilize and not panelVisible
		and not (betaSpinTriggerEnabled or betaNoJumpSpinEnabled or betaNoSpinEnabled) then
		local cam = workspace.CurrentCamera
		if cam then
			local look = cam.CFrame.LookVector
			local aimingNow = aimbotEnabled and currentAimbotTarget and (aimbotKeyHeld or isInMovingVehicle())
			if silentMouseMoved or aimingNow then
				silentStableLook = look
				silentMouseMoved = false
			elseif silentStableLook and look:Dot(silentStableLook) < 0.99995 then
				pcall(function()
					cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + silentStableLook)
				end)
			end
		else
			silentStableLook = nil
		end
	elseif not noRecoilEnabled then
		silentStableLook = nil
	end

	-- ESP with automatic cleanup (esconde os visuais com o menu aberto)
	if espEnabled and not panelVisible then
		local validChars = {}
		for _, player in ipairs(Players:GetPlayers()) do
			local data = syncPlayerCharacter(player)
			if player ~= LocalPlayer and isEnemy(player) then
				local character = data and data.character or player.Character
				if character then
					local humanoid = data and data.humanoid or character:FindFirstChildOfClass("Humanoid")
					local root = data and data.root or character:FindFirstChild("HumanoidRootPart")
					local stateOk = true
					if humanoid then
						pcall(function()
							stateOk = humanoid:GetState() ~= Enum.HumanoidStateType.Dead
						end)
					end
					-- trigger/auto-kill pode deixar o character "fantasma" no ar
					local heightOk = true
					local myRootNow = LocalPlayer.Character and getPrimaryPart(LocalPlayer.Character)
					if root and myRootNow then
						heightOk = math.abs(root.Position.Y - myRootNow.Position.Y) <= 150
					end
					if humanoid and root and humanoid.Health > 0 and stateOk and heightOk then
						validChars[character] = true
						pcall(function()
							if showSkeleton then ensureHighlight(character) end
							if showBox3D then ensureBox3D(character) end
							if showTracers then ensureTracer(character) end
							if showEspDistance then ensureDistanceLabel(character) end
							if showName then ensureNameLabel(character, player) end
							if showWeapon then ensureWeaponLabel(character, player) end
							if showHealth then ensureHealthBar(character) end
						end)
					end
				end
			end
		end
		for char, _ in pairs(highlights) do
			if not validChars[char] then
				pcall(function() highlights[char]:Destroy() end)
				highlights[char] = nil
			end
		end
		for char, box in pairs(boxes) do
			local orphan = not validChars[char] or not box or not box.Parent
			if not orphan and box.Adornee then
				orphan = box.Adornee.Parent ~= char
			end
			if orphan then
				pcall(function() if box then box:Destroy() end end)
				boxes[char] = nil
			end
		end
		for char, label in pairs(nameLabels) do
			local orphan = not validChars[char] or not label or not label.Parent
			if not orphan and label:IsA("BillboardGui") and label.Adornee then
				orphan = label.Adornee.Parent ~= char
			end
			if orphan then
				pcall(function() if label then label:Remove() end end)
				nameLabels[char] = nil
			end
		end
		for char, _ in pairs(weaponLabels) do
			if not validChars[char] then
				pcall(function() weaponLabels[char]:Remove() end)
				weaponLabels[char] = nil
			end
		end
		for char, label in pairs(distanceLabels) do
			local orphan = not validChars[char] or not label or not label.Parent
			if not orphan and label:IsA("BillboardGui") and label.Adornee then
				orphan = label.Adornee.Parent ~= char
			end
			if orphan then
				pcall(function() if label then label:Remove() end end)
				distanceLabels[char] = nil
			end
		end
		for char, _ in pairs(tracers) do
			if not validChars[char] then
				pcall(function() tracers[char]:Remove() end)
				tracers[char] = nil
			end
		end
		for char, bar in pairs(healthBars) do
			if not validChars[char] then
				pcall(function()
					if bar.bg then bar.bg:Remove() end
					if bar.fill then bar.fill:Remove() end
				end)
				healthBars[char] = nil
			end
		end
		else
		clearAllESPVisuals()
	end

	-- NPC ESP (throttled scan) — also scan when aimbot needs targets or any sub-feature is active
	if npcEspEnabled or npcShowSkeleton or npcShowBox or npcShowTracers or npcShowDistance or npcShowName or npcShowHealth or npcShowWeapon or npcAimbotEnabled or npcTriggerEnabled or npcHitboxEnabled or (silentAimEnabled and silentIncludeNPCs) then
		local now = tick()
		if now - npcEspLastScanTime >= npcEspScanInterval then
			npcEspLastScanTime = now
			local scanned = getNPCsFromWorkspace()
			if scanned then npcEspCachedModels = scanned end
		end
		local validNpcs = {}
		for _, npcInfo in ipairs(npcEspCachedModels) do
			local model = npcInfo.model
			if model and model.Parent and npcInfo.humanoid and npcInfo.humanoid.Health > 0 then
				validNpcs[model] = true
				if not panelVisible then
					-- pcall separado por elemento: uma falha (ex: Drawing API) ja nao mata os restantes
					pcall(function() if npcShowSkeleton then ensureNpcHighlight(model) end end)
					pcall(function() if npcShowBox then ensureNpcBox3D(model) end end)
					pcall(function() if npcShowTracers then ensureNpcTracer(model) end end)
					pcall(function() if npcShowDistance then ensureNpcDistanceLabel(model) end end)
					pcall(function() if npcShowName then ensureNpcNameLabel(model) end end)
					pcall(function() if npcShowWeapon then ensureNpcWeaponLabel(model) end end)
					pcall(function() if npcShowHealth then ensureNpcHealthBar(model) end end)
				end
			end
		end
		-- Menu aberto: limpa os visuais do NPC ESP para ficar clean (aimbot continua funcionando)
		if panelVisible then
			clearAllNpcESP()
		end
		-- Cleanup orphaned NPC ESP
		for m, _ in pairs(npcHighlights) do
			if not validNpcs[m] then
				pcall(function() npcHighlights[m]:Destroy() end)
				npcHighlights[m] = nil
			end
		end
		for m, _ in pairs(npcBoxes) do
			if not validNpcs[m] then
				pcall(function() npcBoxes[m]:Destroy() end)
				npcBoxes[m] = nil
			end
		end
		for m, _ in pairs(npcNameLabels) do
			if not validNpcs[m] then
				pcall(function() npcNameLabels[m]:Remove() end)
				npcNameLabels[m] = nil
			end
		end
		for m, _ in pairs(npcWeaponLabels) do
			if not validNpcs[m] then
				pcall(function() npcWeaponLabels[m]:Remove() end)
				npcWeaponLabels[m] = nil
			end
		end
		for m, _ in pairs(npcDistanceLabels) do
			if not validNpcs[m] then
				pcall(function() npcDistanceLabels[m]:Remove() end)
				npcDistanceLabels[m] = nil
			end
		end
		if npcTracers then
			for m, _ in pairs(npcTracers) do
				if not validNpcs[m] then
					pcall(function() npcTracers[m]:Remove() end)
					npcTracers[m] = nil
				end
			end
		end
		for m, bar in pairs(npcHealthBars) do
			if not validNpcs[m] then
				pcall(function()
					if bar.bg then bar.bg:Remove() end
					if bar.fill then bar.fill:Remove() end
				end)
				npcHealthBars[m] = nil
			end
		end
	else
		clearAllNpcESP()
		npcEspCachedModels = {}
	end
end)

