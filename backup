function isEnemy(p)
	if isMenuFriend and isMenuFriend(p) then return false end
	-- Verificar se não é você mesmo
	if p == LocalPlayer then return false end
	
	-- Se team check estiver desativado, todos são inimigos
	if not aimbotTeamCheck then return true end
	
	-- Se team check estiver ativado, verificar equipe
	if not LocalPlayer.Team or not p.Team then
		-- Se algum jogador não tem equipe, considerar inimigo
		return true
	end
	
	-- Retornar true se estiverem em equipes diferentes
	return LocalPlayer.Team ~= p.Team
end

function applyHighlightMode(highlight)
	if espMode == "Cheio" then
		highlight.FillTransparency = 0
		highlight.OutlineTransparency = 0
	else
		highlight.FillTransparency = 1
		highlight.OutlineTransparency = 0
	end
end

function getPlayerAutoEspColor(character)
	local player = Players:GetPlayerFromCharacter(character)
	if player and isMenuFriend and isMenuFriend(player) then return FRIEND_ESP_COLOR end
	if not espAutoEnabled then return espColor end
	local camera = workspace.CurrentCamera
	local myChar = LocalPlayer.Character
	local targetRoot = getPrimaryPart(character)
	if not camera or not myChar or not targetRoot then return skeletonColor end

	local screenPos, onScreen = camera:WorldToViewportPoint(targetRoot.Position)
	local viewport = camera.ViewportSize
	local insideViewport = onScreen and screenPos.Z > 0
		and screenPos.X >= 0 and screenPos.X <= viewport.X
		and screenPos.Y >= 0 and screenPos.Y <= viewport.Y
	if not insideViewport then return skeletonColor end

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {myChar}
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist
	local direction = targetRoot.Position - camera.CFrame.Position
	local rayResult = workspace:Raycast(camera.CFrame.Position, direction, rayParams)
	if not rayResult or rayResult.Instance:IsDescendantOf(character) then
		return Color3.fromRGB(0, 255, 0)
	end
	return skeletonColor
end

function ensureHighlight(character)
	if not character or not character.Parent then
		if highlights[character] then
			pcall(function() highlights[character]:Destroy() end)
			highlights[character] = nil
		end
		return
	end
	
	-- Verificar se está na mesma dimensão
	if not isInSameDimension(character) then
		if highlights[character] then
			pcall(function() highlights[character]:Destroy() end)
			highlights[character] = nil
		end
		return
	end
	
	if not espEnabled then
		if highlights[character] then
			pcall(function() highlights[character]:Destroy() end)
			highlights[character] = nil
		end
		return
	end
	
	-- Verificar distância ANTES de criar
	local myChar = LocalPlayer.Character
	if myChar then
		local myRoot = getPrimaryPart(myChar)
		local targetRoot = getPrimaryPart(character)
		if myRoot and targetRoot then
			local distance = (targetRoot.Position - myRoot.Position).Magnitude
			if distance >= ESP_MAX_DISTANCE then
				if highlights[character] then
					pcall(function() highlights[character]:Destroy() end)
					highlights[character] = nil
				end
				return
			end
		end
	end
	
	-- Criar highlight se não existir
	local h = highlights[character]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "PlayerESP"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Adornee = character
		h.Parent = LocalPlayer:WaitForChild("PlayerGui")
		highlights[character] = h
	end

	-- Sistema: verifica se está na tela E se não tem parede
	local autoColor = getPlayerAutoEspColor(character)
	h.FillColor = autoColor
	h.OutlineColor = autoColor
	if showSkeleton then
		local characterPlayer = Players:GetPlayerFromCharacter(character)
		if not espAutoEnabled and not (characterPlayer and isMenuFriend and isMenuFriend(characterPlayer)) then
			h.FillColor = skeletonColor
			h.OutlineColor = skeletonColor
		end
		h.FillTransparency = (espMode == "Cheio") and 0 or 1
		h.OutlineTransparency = 0
		h.Enabled = true
	else
		h.Enabled = false
	end
end

