function enableNoclipSolo()
	if noclipSoloEnabled then return end
	noclipSoloEnabled = true
	-- Ativa o Fly internamente, sem alterar o toggle visual do Fly.
	noclipSoloOwnsFly = false
	if not FlySystem.flying then
		FlySystem:setFlyEnabled(true)
		noclipSoloOwnsFly = true
	end
	if not soloDimensionEnabled then
		local fn = _G._soloDimEnable
		if fn then fn() end
	end
	if noclipSoloToggleApi then
		noclipSoloToggleApi.setState(true)
	end
end

function disableNoclipSolo()
	if not noclipSoloEnabled then return end
	noclipSoloEnabled = false
	-- Desativa apenas o Fly interno que foi iniciado pelo No-Clip Solo.
	if noclipSoloOwnsFly then
		FlySystem:setFlyEnabled(false)
		noclipSoloOwnsFly = false
	end
	if soloDimensionEnabled then
		local fn = _G._soloDimDisable
		if fn then fn() end
	end
	if noclipSoloToggleApi then
		noclipSoloToggleApi.setState(false)
	end
end

	-- O modo do No-Clip Solo e escolhido no proprio engrenagem do bind.
	-- Em Toggle, pressionar o bind alterna o estado; em Hold, o estado
	-- permanece ativo somente enquanto o bind estiver pressionado.
		noclipSoloHoldInputConn = nil
		noclipSoloModePopup = nil
		noclipSoloBindHint = nil
		noclipSoloPendingGear = nil
		noclipSoloPendingTag = nil

	function stopNoclipSoloHoldInput()
		if noclipSoloHoldInputConn then
			noclipSoloHoldInputConn:Disconnect()
			noclipSoloHoldInputConn = nil
		end
	end

	function startNoclipSoloHoldInput()
		stopNoclipSoloHoldInput()
		noclipSoloHoldInputConn = UserInputService.InputEnded:Connect(function(input)
			if noclipSoloMode == "Hold" and noclipSoloBind and inputMatchesBind(input, noclipSoloBind) then
				disableNoclipSolo()
				stopNoclipSoloHoldInput()
			end
		end)
	end

	function beginNoclipSoloBindCapture(gear, bindTag)
		if noclipSoloBindHint then
			noclipSoloBindHint.Visible = true
			local gearPos = gear.AbsolutePosition
			local gearSize = gear.AbsoluteSize
			noclipSoloBindHint.Position = UDim2.new(0, gearPos.X - 180, 0, gearPos.Y + gearSize.Y + 8)
				noclipSoloBindHint.Text = (noclipSoloMode == "Hold" and "Press a key/button for Hold" or "Press a key/button for Toggle") .. " | Esc clears"
			activeBindHints[noclipSoloBindHint] = true
		end
		activeBindCapture = {
			bindId = "noclipSolo",
			hint = noclipSoloBindHint,
			gear = gear,
			setBind = function(bindValue, bindName)
				noclipSoloBind = bindValue
				noclipSoloBindString = bindDisplayName(bindValue, bindName)
			end,
			waitingForNextInput = true,
			refreshBindTag = function()
				local shown = noclipSoloBindString
				if not shown or shown == "" or shown == "None" then shown = "--" end
				if #shown > 6 then shown = shown:sub(1, 6) end
				bindTag.Text = shown
			end,
		}
		gear.TextColor3 = C.TxtWhite
		bindTag.BackgroundColor3 = C.BindActive
	end

	function setNoclipSoloMode(mode)
		noclipSoloMode = mode == "Hold" and "Hold" or "Toggle"
		if noclipSoloModePopup then
			local toggleButton = noclipSoloModePopup:FindFirstChild("ToggleMode")
			local holdButton = noclipSoloModePopup:FindFirstChild("HoldMode")
			if toggleButton then toggleButton.BackgroundColor3 = noclipSoloMode == "Toggle" and C.BindActive or C.BgInput end
			if holdButton then holdButton.BackgroundColor3 = noclipSoloMode == "Hold" and C.BindActive or C.BgInput end
		end
		if noclipSoloMode ~= "Hold" then
			stopNoclipSoloHoldInput()
			if noclipSoloEnabled then disableNoclipSolo() end
		end
	end

		function showNoclipSoloModePicker(gear, bindTag)
			if not noclipSoloModePopup then return end
			hideAllBindHints()
			activeBindCapture = nil
			noclipSoloPendingGear = gear
			noclipSoloPendingTag = bindTag
		noclipSoloModePopup.Position = UDim2.new(0, gear.AbsolutePosition.X - 174, 0, gear.AbsolutePosition.Y + gear.AbsoluteSize.Y + 8)
		noclipSoloModePopup.Visible = true
		activeBindHints[noclipSoloModePopup] = true
		local toggleButton = noclipSoloModePopup:FindFirstChild("ToggleMode")
		local holdButton = noclipSoloModePopup:FindFirstChild("HoldMode")
		if toggleButton then toggleButton.BackgroundColor3 = noclipSoloMode == "Toggle" and C.BindActive or C.BgInput end
		if holdButton then holdButton.BackgroundColor3 = noclipSoloMode == "Hold" and C.BindActive or C.BgInput end
		end

	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe or noclipSoloMode ~= "Hold" then return end
		if noclipSoloBind and inputMatchesBind(input, noclipSoloBind) then
			enableNoclipSolo()
			startNoclipSoloHoldInput()
		end
	end)

	noclipSoloApi = nil
	noclipSoloApi = createToggle(movementContent, "Noclip Solo Session", function(enabled)
		if enabled then
			enableNoclipSolo()
		else
			disableNoclipSolo()
		end
	end, "Ativa somente a Sessão Solo. Escolha Toggle ou Hold no engrenagem do bind.", {
		bindId = "noclipSolo",
		getBindValue = function() return noclipSoloBind end,
		getBindName = function() return noclipSoloBindString end,
		setBind = function(bindValue, bindName)
			noclipSoloBind = bindValue
			noclipSoloBindString = bindDisplayName(bindValue, bindName)
		end,
		onBindInput = function()
			if noclipSoloMode == "Toggle" then
				noclipSoloToggleApi.toggle()
			end
		end,
		onReady = function(api)
			noclipSoloToggleApi = api
		end,
	})

	-- Popup exibido ao clicar com o botao direito no engrenagem.
	noclipSoloModePopup = Instance.new("Frame")
	noclipSoloModePopup.Name = "NoclipSoloBindModePopup"
