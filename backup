		task.delay(1.3, function()
			pcall(function()
				burstPart:Destroy()
			end)
		end)
	end)

	-- Flash roxo na tela (ColorCorrection) que desvanece
	pcall(function()
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "NightPortalFlash"
		cc.TintColor = Color3.fromRGB(196, 148, 255)
		cc.Saturation = 0.18
		cc.Brightness = 0.07
		cc.Parent = Lighting
		TweenService:Create(cc, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TintColor = Color3.fromRGB(255, 255, 255),
			Saturation = 0,
			Brightness = 0,
		}):Play()
		task.delay(0.9, function()
			pcall(function()
				cc:Destroy()
			end)
		end)
	end)

	-- Punch de FOV na camera
	pcall(function()
		local cam = workspace.CurrentCamera
		if cam then
			local originalFOV = cam.FieldOfView
			cam.FieldOfView = originalFOV + 8
			TweenService:Create(cam, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {FieldOfView = originalFOV}):Play()
		end
	end)
end

function teleportNextMultiWaypoint()
	local count = #multiWaypointPositions
	if count == 0 then return false end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return false end

	multiWaypointIndex = (multiWaypointIndex % count) + 1
	local targetEntry = multiWaypointPositions[multiWaypointIndex]
	local targetPosition = targetEntry and targetEntry.position or nil
	if not targetPosition then return false end

	root.CFrame = CFrame.new(targetPosition + Vector3.new(0, 4, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	playPortalUseEffects(targetPosition)
	return true
end

function getPromptPart(prompt)
	local promptParent = prompt and prompt.Parent
	return promptParent and (promptParent:IsA("BasePart") and promptParent or promptParent:FindFirstAncestorWhichIsA("BasePart"))
end

function getPromptDistance(prompt)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local promptPart = getPromptPart(prompt)
	if not root or not promptPart then
		return math.huge
	end

	return (promptPart.Position - root.Position).Magnitude
end

function nudgeToPromptForSteal(prompt)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local promptPart = getPromptPart(prompt)
	if not root or not promptPart then
		return false
	end

	local targetPos = promptPart.Position + Vector3.new(0, 2.5, 0)
	root.CFrame = CFrame.new(targetPos)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

function captureStealReturnPosition()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	stealReturnCFrame = root.CFrame
	stealReturnPending = true
	return true
end

function resetCharacterPoseNoDeath()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return false
	end

	-- Re-align to camera yaw and force humanoid out of weird physics/walkback states.
	local look = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.LookVector or Vector3.new(0, 0, -1)
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	else
		look = look.Unit
	end

	root.CFrame = CFrame.new(root.Position, root.Position + look)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	humanoid.AutoRotate = true
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)
	return true
end

function resetCharacterLikeRoblox()
	local character = LocalPlayer.Character
	if not character then
		return false
	end

	pcall(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.PlatformStand = false
			humanoid.Sit = false
			humanoid.AutoRotate = true
		end

		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.RotVelocity = Vector3.zero
		end

		character:BreakJoints()
	end)

	return true
end

function reviveCharacterLikeRoblox()
	pcall(function()
		LocalPlayer:LoadCharacter()
	end)
	return true
end

function returnAfterStealNudge()
	if not stealReturnPending or not stealReturnCFrame then
		return false
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	root.CFrame = stealReturnCFrame
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	stealReturnCFrame = nil
	stealReturnPending = false
	task.defer(function()
		pcall(resetCharacterPoseNoDeath)
	end)
	return true
end

function tryStealNudgeWithReturn(prompt)
	local captured = captureStealReturnPosition()
	local nudged = nudgeToPromptForSteal(prompt)
	if nudged then
		return true
	end
	if captured then
		stealReturnCFrame = nil
		stealReturnPending = false
	end
	return false
end

function getPromptPriority(prompt)
	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
	local objectText = string.lower(tostring(prompt and prompt.ObjectText or ""))
	local combined = actionText .. " " .. objectText

	if combined:find("roubar") or combined:find("steal") or combined:find("colet") or combined:find("collect") or combined:find("pegar") or combined:find("take") or combined:find("loot") then
		return 3
	end

	if combined:find("abrir") or combined:find("open") or combined:find("claim") or combined:find("pickup") then
		return 2
	end

	if combined:find("shop") or combined:find("loja") or combined:find("buy") or combined:find("compr") or combined:find("sell") or combined:find("vender") then
		return 0
	end

	return 1
end

function getPromptNumericWeight(prompt)
	local actionText = tostring(prompt and prompt.ActionText or "")
	local objectText = tostring(prompt and prompt.ObjectText or "")
	local combined = actionText .. " " .. objectText

	local function parseToken(rawNumber, rawSuffix)
		local suffix = string.lower(tostring(rawSuffix or ""))
		local cleaned = tostring(rawNumber or ""):gsub("%s+", ""):gsub(",", "")
		local numeric = tonumber(cleaned)
		if not numeric then
			return nil
		end
		if suffix == "k" then
			numeric = numeric * 1000
		elseif suffix == "m" then
			numeric = numeric * 1000000
		elseif suffix == "b" then
			numeric = numeric * 1000000000
		end
		return numeric
	end

	local best = 0

	-- Prefer right-side value in current/max patterns (supports suffixes: K/M/B).
	for _, rightNumber, rightSuffix in combined:gmatch("(%d[%d%.,]*)%s*[kKmMbB]?%s*/%s*(%d[%d%.,]*)%s*([kKmMbB]?)") do
		local numeric = parseToken(rightNumber, rightSuffix)
		if numeric and numeric > best then
			best = numeric
		end
	end

	for rawNumber, rawSuffix in combined:gmatch("(%d[%d%.,]*)%s*([kKmMbB]?)") do
		local numeric = parseToken(rawNumber, rawSuffix)
		if numeric and numeric > best then
			best = numeric
		end
	end

	return math.floor(best)
end

function splitPromptFilterList(rawText)
	local tokens = {}
	local lowered = string.lower(tostring(rawText or ""))
	for token in lowered:gmatch("[^,%s]+") do
		table.insert(tokens, token)
	end
	return tokens
end

function promptMatchesFilter(prompt, rawText)
	local tokens = splitPromptFilterList(rawText)
	if #tokens == 0 then
		return false
	end

	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
	local objectText = string.lower(tostring(prompt and prompt.ObjectText or ""))
	local combined = actionText .. " " .. objectText

	for _, token in ipairs(tokens) do
		if token ~= "" and combined:find(token, 1, true) then
			return true
		end
	end

	return false
end

function isStealPrompt(prompt)
	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
	local objectText = string.lower(tostring(prompt and prompt.ObjectText or ""))
	local combined = actionText .. " " .. objectText

	return combined:find("roubar", 1, true)
		or combined:find("steal", 1, true)
		or combined:find("rob", 1, true)
end

function isShopPrompt(prompt)
	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
	local objectText = string.lower(tostring(prompt and prompt.ObjectText or ""))
	local combined = actionText .. " " .. objectText

	return combined:find("shop", 1, true)
		or combined:find("loja", 1, true)
		or combined:find("buy", 1, true)
		or combined:find("compr", 1, true)
		or combined:find("sell", 1, true)
		or combined:find("vender", 1, true)
end

function applyFastStealPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not isStealPrompt(prompt) then
		return
	end

	if fastStealPromptRestore[prompt] == nil then
		fastStealPromptRestore[prompt] = prompt.HoldDuration
	end
	local originalHold = fastStealPromptRestore[prompt] or 0.5
	-- Slight speed-up while staying on a safer profile.
	prompt.HoldDuration = math.clamp(originalHold * 0.85, 0.3, 2.0)
end

function restoreFastStealPrompts()
	for prompt, holdDuration in pairs(fastStealPromptRestore) do
		if prompt and prompt.Parent then
			pcall(function()
				prompt.HoldDuration = holdDuration
			end)
		end
		fastStealPromptRestore[prompt] = nil
	end
end

function setFastStealEnabled(enabled)
	fastStealEnabled = enabled and true or false

	if fastStealPromptConnection then
		fastStealPromptConnection:Disconnect()
		fastStealPromptConnection = nil
	end

	if not fastStealEnabled then
		restoreFastStealPrompts()
		fastStealLastUseAt = 0
		fastStealLastPrompt = nil
		fastStealPerPromptUseAt = {}
		return
	end

	for _, descendant in ipairs(workspace:GetDescendants()) do
		applyFastStealPrompt(descendant)
	end

	fastStealPromptConnection = workspace.DescendantAdded:Connect(function(descendant)
		applyFastStealPrompt(descendant)
	end)
end

function applyStealDistancePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not isStealPrompt(prompt) then
		return
	end

	if stealDistancePromptRestore[prompt] == nil then
		stealDistancePromptRestore[prompt] = prompt.MaxActivationDistance
	end

	local baseDistance = tonumber(prompt.MaxActivationDistance) or 10
	local desired = math.clamp(tonumber(stealDistanceValue) or 22, 8, 500)
	if desired > baseDistance then
		prompt.MaxActivationDistance = desired
	end
end

function restoreStealDistancePrompts()
	for prompt, maxDistance in pairs(stealDistancePromptRestore) do
		if prompt and prompt.Parent then
			pcall(function()
				prompt.MaxActivationDistance = maxDistance
			end)
		end
		stealDistancePromptRestore[prompt] = nil
	end
end

function setStealDistanceEnabled(enabled)
	stealDistanceEnabled = enabled and true or false

	if stealDistancePromptConnection then
		stealDistancePromptConnection:Disconnect()
		stealDistancePromptConnection = nil
	end

	if not stealDistanceEnabled then
		restoreStealDistancePrompts()
		return
	end

	task.spawn(function()
		local count = 0
		for _, descendant in ipairs(workspace:GetDescendants()) do
			applyStealDistancePrompt(descendant)
			count = count + 1
			if count % 280 == 0 then
				task.wait()
			end
		end
	end)

	stealDistancePromptConnection = workspace.DescendantAdded:Connect(function(descendant)
		applyStealDistancePrompt(descendant)
	end)
end

function setStealDistanceValue(newValue)
	local parsed = tonumber(newValue)
	if not parsed then
		return false
	end
	parsed = math.clamp(math.floor(parsed), 8, 500)
	stealDistanceValue = parsed
	if stealDistanceEnabled then
		task.spawn(function()
			local count = 0
			for _, descendant in ipairs(workspace:GetDescendants()) do
				applyStealDistancePrompt(descendant)
				count = count + 1
				if count % 280 == 0 then
					task.wait()
				end
			end
		end)
	end
	return true
end

function isPromptInteractable(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end
	local allowedDistance = (prompt.MaxActivationDistance or 10) + 1.5
	if stealDistanceEnabled and isStealPrompt(prompt) then
		local requested = tonumber(stealDistanceValue) or 22
		local capped = math.min(requested, tonumber(stealDistanceSafeLimit) or 500)
		allowedDistance = math.max(allowedDistance, capped + 1.5)
	end
	if getPromptDistance(prompt) > allowedDistance then return false end
	if instantInteractBlockShopsEnabled and isShopPrompt(prompt) then return false end
	if instantInteractBlacklistText ~= "" and promptMatchesFilter(prompt, instantInteractBlacklistText) then return false end
	if instantInteractWhitelistText ~= "" and not promptMatchesFilter(prompt, instantInteractWhitelistText) then return false end
	return true
end

function getBestInstantInteractPrompt()
	if stealFocusPrompt and (not isPromptInteractable(stealFocusPrompt) or not isInstantPromptVisible(stealFocusPrompt)) then
		stealFocusPrompt = nil
	end

	local bestPrompt = nil
	local bestPriority = -1
	local bestNumeric = -1
	local bestDistance = math.huge

	for prompt in pairs(instantInteractVisiblePrompts) do
		if isPromptInteractable(prompt) then
			local priority = getPromptPriority(prompt)
			local numeric = getPromptNumericWeight(prompt)
			local isSteal = isStealPrompt(prompt)
			local distance = getPromptDistance(prompt)

			-- For steal prompts, only target values >= configured minimum (default: 20k).
			if (not isSteal) or (numeric >= (tonumber(stealMinTargetValue) or 20000)) then
				local preferWorst = string.lower(tostring(stealTargetMode or "Best")) == "worst"
				local numericBetter = (not preferWorst and numeric > bestNumeric) or (preferWorst and (bestNumeric < 0 or numeric < bestNumeric))
				if priority > bestPriority
					or (priority == bestPriority and prompt == stealFocusPrompt and bestPrompt ~= stealFocusPrompt)
					or (priority == bestPriority and numericBetter)
					or (priority == bestPriority and numeric == bestNumeric and distance < bestDistance) then
					bestPrompt = prompt
					bestPriority = priority
					bestNumeric = numeric
					bestDistance = distance
				end
			end
		else
			instantInteractVisiblePrompts[prompt] = nil
		end
	end

	return bestPrompt
end

function isInstantPromptVisible(prompt)
	return prompt and instantInteractVisiblePrompts[prompt] == true and prompt.Parent and prompt.Enabled
end

function triggerPromptInteraction(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end

	local holdDuration = math.max(prompt.HoldDuration or 0, 0.05)
	local isSteal = isStealPrompt(prompt)
	local releaseAt
	local didStealNudge = false
	local canStealNudge = isSteal and not stealTpUsedForPrompt[prompt]
	if isSteal then
		-- Extra margin for steal prompts so server-side validation has time to complete.
		releaseAt = tick() + math.max(holdDuration, 0.45) + 0.45
	else
		releaseAt = tick() + holdDuration + 0.2
	end
	if prompt.InputHoldBegin and prompt.InputHoldEnd then
		local ok = pcall(function()
			if canStealNudge and stealDistanceEnabled and not didStealNudge and getPromptDistance(prompt) > 6 then
				didStealNudge = tryStealNudgeWithReturn(prompt)
				if didStealNudge then
					stealTpUsedForPrompt[prompt] = true
					stealFocusPrompt = prompt
				end
			end
			prompt:InputHoldBegin()
			while tick() < releaseAt do
				if not instantInteractEnabled or not isInstantPromptVisible(prompt) then
					break
				end
				if canStealNudge and stealDistanceEnabled and not didStealNudge and (releaseAt - tick()) <= 0.22 then
					if getPromptDistance(prompt) > 7 then
						didStealNudge = tryStealNudgeWithReturn(prompt)
						if didStealNudge then
							stealTpUsedForPrompt[prompt] = true
							stealFocusPrompt = prompt
						end
					else
						didStealNudge = true
					end
				end
				task.wait(0.03)
			end
			prompt:InputHoldEnd()
		end)
		if ok then
			return true
		end
	end

	local keyCode = prompt.KeyboardKeyCode
	if keyCode and keyCode ~= Enum.KeyCode.Unknown then
		local ok = pcall(function()
			if canStealNudge and stealDistanceEnabled and not didStealNudge and getPromptDistance(prompt) > 6 then
				didStealNudge = tryStealNudgeWithReturn(prompt)
				if didStealNudge then
					stealTpUsedForPrompt[prompt] = true
					stealFocusPrompt = prompt
				end
			end
			VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
			while tick() < releaseAt do
				if not instantInteractEnabled or not isInstantPromptVisible(prompt) then
					break
				end
				if canStealNudge and stealDistanceEnabled and not didStealNudge and (releaseAt - tick()) <= 0.22 then
					if getPromptDistance(prompt) > 7 then
						didStealNudge = tryStealNudgeWithReturn(prompt)
						if didStealNudge then
							stealTpUsedForPrompt[prompt] = true
							stealFocusPrompt = prompt
						end
					else
						didStealNudge = true
					end
				end
				task.wait(0.03)
			end
			VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
		end)
		if ok then
			return true
		end
	end

	if fireproximityprompt then
		local ok = pcall(function()
			fireproximityprompt(prompt)
		end)
		if ok then
			return true
		end
	end

	return false
end

function tryInstantInteractPrompt(prompt)
	if not instantInteractEnabled or instantInteractBusy then return end
	if not isPromptInteractable(prompt) then return end
	if prompt == instantInteractLastPrompt and (tick() - instantInteractLastTryAt) < 0.03 then return end

	local now = tick()
	local isSteal = isStealPrompt(prompt)
	if isSteal and (now - stealLastCompleteAt) < stealInteractionCooldown then
		return
	end
	if fastStealEnabled and isSteal then
		local lastForPrompt = fastStealPerPromptUseAt[prompt] or 0
		if now - fastStealLastUseAt < fastStealGlobalCooldown then
			return
		end
		if now - lastForPrompt < fastStealSamePromptCooldown then
			return
		end
		if fastStealLastPrompt and fastStealLastPrompt ~= prompt and (now - fastStealLastUseAt) < fastStealSwitchCooldown then
			return
		end
	end

	instantInteractBusy = true
	instantInteractLastPrompt = prompt
	instantInteractLastTryAt = now
	task.spawn(function()
		local interacted = false
		pcall(function()
			interacted = triggerPromptInteraction(prompt) and true or false
		end)
		if interacted and isSteal and not isInstantPromptVisible(prompt) then
			stealLastCompleteAt = tick()
			stealTpUsedForPrompt[prompt] = nil
			if stealFocusPrompt == prompt then
				stealFocusPrompt = nil
			end
		end
		if interacted and fastStealEnabled and isSteal then
			-- Only apply strict steal cooldown after prompt actually closes.
			if not isInstantPromptVisible(prompt) then
				local usedAt = tick()
				fastStealLastUseAt = usedAt
				fastStealLastPrompt = prompt
				fastStealPerPromptUseAt[prompt] = usedAt
			else
				-- If server didn't confirm, back off a bit to avoid infinite hold spam.
				fastStealPerPromptUseAt[prompt] = tick()
			end
		end
		if isSteal and stealReturnPending then
			task.delay(0.12, function()
				pcall(function()
					returnAfterStealNudge()
				end)
			end)
		end
		task.wait(0.03)
		instantInteractBusy = false
	end)
end

