function nmApplySettings(cfg)
	if type(cfg) ~= "table" then return end
	if type(cfg.toggles) == "table" then
		for key, state in pairs(cfg.toggles) do
			local entry = nmToggles[key]
			if entry and entry.setState and type(state) == "boolean" then
				pcall(function() entry.setState(state, "force") end)
			end
		end
	end
	if type(cfg.binds) == "table" then
		for id, data in pairs(cfg.binds) do
			local entry = nmBinds[id]
			if entry and entry.setBind then
				local value, name = nmDecodeBind(data)
				pcall(function()
					entry.setBind(value, name)
					if entry.refreshBindTag then entry.refreshBindTag() end
				end)
			end
		end
	end
	if type(cfg.values) == "table" then
		for key, saved in pairs(cfg.values) do
			if key ~= "friendUserIds" then
				local decoded = nmDecodeValue(saved)
				if decoded ~= nil then nmSetVar(key, decoded) end
			end
		end
		if type(cfg.values.flySpeed) == "number" and FlySystem then
			pcall(function() FlySystem:setSpeed(cfg.values.flySpeed) end)
		end
		if cfg.values.hitboxColor then
			local color = nmDecodeValue(cfg.values.hitboxColor)
			if color then _G.hitboxColor = color end
		end
		if type(cfg.values.friendUserIds) == "table" then
			playerFriendIds = {}
			for _, userId in ipairs(cfg.values.friendUserIds) do playerFriendIds[tostring(userId)] = true end
			pcall(function()
				for _, plr in ipairs(Players:GetPlayers()) do
					updatePlayerFriendVisual(plr)
