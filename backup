-- Spin puro: so rotaciona no eixo Y. NUNCA aplica Jump, bhop ou speed boost.
function betaPureSpinStart()
	betaPureSpinStop()
	betaNoJumpAngle = 0
	betaNoJumpSpinLoop = RunService.RenderStepped:Connect(function()
		if not betaNoJumpSpinEnabled or betaNoSpinEnabled then return end
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum then return end
		if hum.WalkSpeed <= 0 then
			pcall(function() hum.AutoRotate = true end)
			return
		end
		pcall(function() hum.AutoRotate = false end)
		-- Mesmo anti-aim de cabeca do spinbot original, sem mexer na fisica do Root
		pcall(function() applySpinLookDown(char) end)
		betaNoJumpAngle = (betaNoJumpAngle + spinbotSpeed) % 360
		pcall(function()
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(betaNoJumpAngle), 0)
		end)
	end)
end

function betaPureSpinStop()
	pcall(function()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end)
	if betaNoJumpSpinLoop then
		betaNoJumpSpinLoop:Disconnect()
		betaNoJumpSpinLoop = nil
	end
	pcall(function()
		local char = LocalPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum.AutoRotate = true end
		end
	end)
	pcall(restoreSpinLookDown)
end

function betaStartLoop()
	betaStopLoop()
	betaLastShot = 0
	-- Usa o spinbot da aba Combat somente quando o modo "sem salto" NAO esta ativo
	-- (o spinbot da Combat e quem aplica Jump/bhop; no modo sem salto o giro vem de betaPureSpinStart)
	if not betaNoJumpSpinEnabled and not betaNoSpinEnabled then
		pcall(function()
			local spinEntry = nmToggles["spinbot_anti_aim"]
			if spinEntry and spinEntry.getState and spinEntry.setState then
				betaOwnsSpinbot = spinEntry.getState() ~= true
				if betaOwnsSpinbot then spinEntry.setState(true, "force") end
			end
		end)
	end
	-- Terceira pessoa embutida (estilo CS2), usando o Third Person existente
	pcall(function()
		local tpEntry = nmToggles["third_person"]
		if tpEntry and tpEntry.getState and tpEntry.setState then
			betaOwnsThirdPerson = tpEntry.getState() ~= true
			if betaOwnsThirdPerson then tpEntry.setState(true, "force") end
		end
	end)
	betaSpinLoop = RunService.RenderStepped:Connect(function()
		if not betaSpinTriggerEnabled or panelVisible then return end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not root or hum.Health <= 0 then return end
		if hum.WalkSpeed <= 0 then return end

		-- O giro do corpo e feito pelo spinbot existente (o jogo ve o personagem de costas/lado).
		-- A visao do jogador continua livre: a camera so e apontada no instante do tiro.
		local target = betaFindTarget()
		if not target then return end
		local targetRoot = target.root
		if not targetRoot then return end
		local aimPart = target.aimPart or targetRoot
		-- Nao atira se houver QUALQUER parede no meio (sem penetracao)
		local clear = betaHasClearShot(root.Position, targetRoot.Position, {char, target.model, workspace.CurrentCamera})
		-- log de debug do beta removido
		if clear then
			-- SILENT EMBUTIDO: expande a cabeca do alvo antes de atirar
			local hitboxGen = betaExpandHitbox(target.model)
			-- Mesma logica do backup: mira no Root e devolve a camera no frame seguinte
			local cam = workspace.CurrentCamera
			local savedCam = cam and cam.CFrame or nil
			pcall(function()
				if cam then cam.CFrame = CFrame.lookAt(savedCam.Position, targetRoot.Position) end
			end)
			betaFireShot()
			task.spawn(function()
				task.wait()
				pcall(function()
					if cam and cam.Parent and savedCam then cam.CFrame = savedCam end
				end)
			end)
			-- Mantem a hitbox expandida o tempo suficiente para o servidor registrar
			task.spawn(function()
				task.wait(0.2)
				if betaHitboxGen[target.model] == hitboxGen then
					betaRestoreHitbox(target.model)
				end
			end)
		end
	end)
end

function betaStopLoop()
	-- garantir que o cursor volta sempre que o trigger e desligado
	pcall(function()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end)
	if betaSpinLoop then
		betaSpinLoop:Disconnect()
		betaSpinLoop = nil
	end
	betaRestoreAllHitboxes()
	-- Desliga o spinbot existente somente se foi a Chamada Beta que o ligou
	if betaOwnsSpinbot then
		pcall(function()
			local spinEntry = nmToggles["spinbot_anti_aim"]
			if spinEntry and spinEntry.setState then spinEntry.setState(false, "force") end
		end)
		betaOwnsSpinbot = false
	end
	-- Desliga a terceira pessoa somente se foi a Beta que a ligou
	if betaOwnsThirdPerson then
		pcall(function()
			local tpEntry = nmToggles["third_person"]
			if tpEntry and tpEntry.setState then tpEntry.setState(false, "force") end
		end)
		betaOwnsThirdPerson = false
	end
end

-- ================= LOOP LEVE DO MODO "SEM GIRAR" =================
-- Caminho separado do betaStartLoop (nao altera os outros modos): menos trabalho por frame.
function betaNoSpinTargetValid(t, myRoot)
	return t and t.model and t.model.Parent and t.root and t.root.Parent
		and (t.root.Position - myRoot.Position).Magnitude <= betaSpinTriggerRange
end

function betaNoSpinBeginScan(myRoot)
	if not myRoot or not myRoot.Parent then return end
	betaNoSpinScanActive = true
	betaNoSpinScanMyRoot = myRoot
	betaNoSpinScanResults = {}
	betaNoSpinScanStack = {{children = workspace:GetChildren(), index = 1}}
end

-- Processa no maximo ~200 objetos por frame: nenhum frame fica preso na varredura
function betaNoSpinScanStep()
	if not betaNoSpinScanActive then return end
	local myRoot = betaNoSpinScanMyRoot
	if not myRoot or not myRoot.Parent then
		betaNoSpinScanActive = false
		betaNoSpinScanStack = {}
		return
	end
	local budget = 200
	while #betaNoSpinScanStack > 0 and budget > 0 do
		local frame = betaNoSpinScanStack[#betaNoSpinScanStack]
		if frame.index > #frame.children then
			table.remove(betaNoSpinScanStack)
		else
			local obj = frame.children[frame.index]
			frame.index += 1
			budget -= 1
			if obj:IsA("Model") and obj ~= LocalPlayer.Character then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
				if hum and root and root:IsA("BasePart") and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
					local dist = (root.Position - myRoot.Position).Magnitude
					if dist <= math.max(betaSpinTriggerRange, ESP_MAX_DISTANCE) then
						betaNoSpinScanResults[#betaNoSpinScanResults + 1] = {model = obj, humanoid = hum, root = root, distance = dist}
					end
				end
			end
			local children = obj:GetChildren()
			if #children > 0 then
				betaNoSpinScanStack[#betaNoSpinScanStack + 1] = {children = children, index = 1}
			end
		end
	end
	if #betaNoSpinScanStack == 0 then
		betaNoSpinScanActive = false
		betaNoSpinNpcCache = betaNoSpinScanResults
	end
end

function betaNoSpinFindTarget(myRoot)
	local now = tick()
	if betaNoSpinCache and now - betaNoSpinLastScan < 0.1 and betaNoSpinTargetValid(betaNoSpinCache, myRoot) then
		return betaNoSpinCache
	end
	betaNoSpinLastScan = now
	local best, bestDist = nil, math.huge

	-- Players (scan barato)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isEnemy(player) then
			local targetChar = player.Character
			if targetChar and isInSameDimension(targetChar) then
				local hum = targetChar:FindFirstChildOfClass("Humanoid")
				local root = targetChar:FindFirstChild("HumanoidRootPart")
				if hum and root and hum.Health > 0 then
					local dist = (root.Position - myRoot.Position).Magnitude
					if dist <= betaSpinTriggerRange and dist < bestDist then
						best = {model = targetChar, root = root, aimPart = targetChar:FindFirstChild("Head") or root, dist = dist}
						bestDist = dist
					end
				end
			end
		end
	end

	-- NPCs: inicia varredura em pedacos (o passo real roda todo frame no loop)
	if now - betaNoSpinLastNpcScan >= 2 and not betaNoSpinScanActive then
		betaNoSpinLastNpcScan = now
		betaNoSpinBeginScan(myRoot)
	end
	for _, info in ipairs(betaNoSpinNpcCache) do
		local model, root = info.model, info.root
		if model and model.Parent and root and root:IsA("BasePart") then
			local hum = info.humanoid
			if hum and hum.Health > 0 then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist <= betaSpinTriggerRange and dist < bestDist then
					best = {model = model, root = root, aimPart = model:FindFirstChild("Head") or root, dist = dist}
					bestDist = dist
				end
			end
		end
	end

	betaNoSpinCache = best
	return best
end

-- Fumaca nao deve bloquear o tiro, mas paredes solidas continuam bloqueando
function betaNoSpinIsSmokePart(part)
	if not part or not part:IsA("BasePart") then return false end
	local name = string.lower(part.Name)
	if string.find(name, "smoke") or string.find(name, "fumac") or string.find(name, "fog") or string.find(name, "vapor") or string.find(name, "cloud") then
		return true
	end
	-- Nuvens de fumaca costumam ser bem transparentes e sem colisao
	if part.Transparency >= 0.6 and not part.CanCollide then return true end
	return false
end

function betaNoSpinHasClearShot(origin, endPos, char, targetModel)
	local delta = endPos - origin
	local dist = delta.Magnitude
	if dist < 0.01 then return true end
	table.clear(betaNoSpinRayIgnore)
	betaNoSpinRayIgnore[1] = char
	betaNoSpinRayIgnore[2] = targetModel
	betaNoSpinRayIgnore[3] = workspace.CurrentCamera
	betaNoSpinRayParams.FilterDescendantsInstances = betaNoSpinRayIgnore
	local dir = delta.Unit
	local start = origin
	local remaining = dist
	-- Atravessa fumaca (no maximo 8 camadas) e so aborta em parede solida
	for _ = 1, 8 do
		local result = workspace:Raycast(start, dir * remaining, betaNoSpinRayParams)
		if not result then return true end
		if not betaNoSpinIsSmokePart(result.Instance) then return false end
		betaNoSpinRayIgnore[#betaNoSpinRayIgnore + 1] = result.Instance
		betaNoSpinRayParams.FilterDescendantsInstances = betaNoSpinRayIgnore
		local travelled = (result.Position - start).Magnitude
		remaining -= travelled + 0.05
		if remaining <= 0 then return true end
		start = result.Position + dir * 0.05
	end
	return true
end

-- Partes da hitbox em cache (evita GetDescendants a cada tiro)
function betaNoSpinGetParts(model)
	if betaNoSpinPartsCache[model] then return betaNoSpinPartsCache[model] end
	local parts = {}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local n = part.Name
			if n == "Head" then
				parts[#parts + 1] = {part = part, head = true}
			elseif n == "Torso" or n == "UpperTorso" or n == "LowerTorso" then
				parts[#parts + 1] = {part = part, head = false}
			end
		end
	end
	betaNoSpinPartsCache[model] = parts
	return parts
end

function betaNoSpinExpandHitbox(model)
	if not model or betaHitboxBackup[model] then return end
	local backup = {}
	for _, e in ipairs(betaNoSpinGetParts(model)) do
		local part = e.part
		if part and part.Parent then
			backup[part] = {size = part.Size, transparency = part.Transparency}
			if e.head then
				part.Size = Vector3.new(8, 8, 8)
			else
				part.Size = Vector3.new(part.Size.X * 3, part.Size.Y * 3, part.Size.Z * 3)
			end
			part.Transparency = 1
		end
	end
	betaHitboxBackup[model] = backup
	betaHitboxGen[model] = (betaHitboxGen[model] or 0) + 1
end

function betaNoSpinRestoreCam()
	if not betaNoSpinPendingCam then return end
	local p = betaNoSpinPendingCam
	pcall(function()
		if p.cam and p.cam.Parent then p.cam.CFrame = p.cframe end
	end)
	betaNoSpinPendingCam = nil
end

function betaNoSpinStopLoop()
	if betaNoSpinLoop then
		betaNoSpinLoop:Disconnect()
		betaNoSpinLoop = nil
	end
	betaNoSpinRestoreCam()
	betaNoSpinCache = nil
	betaNoSpinNpcCache = {}
	betaNoSpinScanActive = false
	betaNoSpinScanStack = {}
	betaNoSpinScanResults = {}
	betaNoSpinExpire = {}
	betaNoSpinPartsCache = {}
	-- Restaura a camera settings que o modo Sem Girar mudou (sem depender do toggle de Terceira Pessoa)
	pcall(function()
		local s = betaNoSpinSavedTP
		if not s then return end
		if s.cameraMode ~= nil then LocalPlayer.CameraMode = s.cameraMode end
		if s.minZoom ~= nil then LocalPlayer.CameraMinZoomDistance = s.minZoom end
		if s.maxZoom ~= nil then LocalPlayer.CameraMaxZoomDistance = s.maxZoom end
		local cam = workspace.CurrentCamera
		if cam then
			if s.cameraType ~= nil then cam.CameraType = s.cameraType end
			if s.subject ~= nil then cam.CameraSubject = s.subject end
		end
	end)
	betaNoSpinSavedTP = nil
end

function betaNoSpinStartLoop()
	betaNoSpinStopLoop()
	betaStopLoop()
	betaLastShot = 0
	-- Terceira pessoa aplicada UMA unica vez (sem o loop que escreve propriedades todo frame)
	pcall(function()
		local saved = {}
		saved.cameraMode = LocalPlayer.CameraMode
		saved.minZoom = LocalPlayer.CameraMinZoomDistance
		saved.maxZoom = LocalPlayer.CameraMaxZoomDistance
		local cam = workspace.CurrentCamera
		if cam then
			saved.cameraType = cam.CameraType
			saved.subject = cam.CameraSubject
		end
		LocalPlayer.CameraMode = Enum.CameraMode.Classic
		LocalPlayer.CameraMinZoomDistance = 5
		LocalPlayer.CameraMaxZoomDistance = 15
		if cam then
			cam.CameraType = Enum.CameraType.Custom
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then cam.CameraSubject = hum end
		end
		betaNoSpinSavedTP = saved
	end)
	betaNoSpinFrame = 0
	betaNoSpinLoop = RunService.RenderStepped:Connect(function()
		betaNoSpinFrame += 1
		local now = tick()

		-- Varredura de NPCs em pedacos (no maximo ~200 objetos por frame)
		betaNoSpinScanStep()

		-- Devolve a camera no frame seguinte sem criar thread
		if betaNoSpinPendingCam and betaNoSpinFrame >= betaNoSpinPendingCam.frame then
			betaNoSpinRestoreCam()
		end
		-- Restaura hitboxes vencidas no proprio loop (sem task.wait/spawn)
		for model, expire in pairs(betaNoSpinExpire) do
			if now >= expire then
				betaNoSpinExpire[model] = nil
				if betaHitboxBackup[model] then betaRestoreHitbox(model) end
			end
		end

		if not betaNoSpinEnabled or panelVisible then return end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not root or hum.Health <= 0 or hum.WalkSpeed <= 0 then return end
		-- Espaca os tiros (menos input simulado, menos expansao de hitbox e menos mexida na camera)
		if now - betaNoSpinLastShot < betaNoSpinShotDelay then return end

		local target = betaNoSpinFindTarget(root)
		if not target then return end
		local targetRoot = target.root
		if not targetRoot or not targetRoot.Parent then return end

		if not betaNoSpinHasClearShot(root.Position, targetRoot.Position, char, target.model) then return end

		betaNoSpinExpandHitbox(target.model)
		local cam = workspace.CurrentCamera
		if cam then
			betaNoSpinPendingCam = {cam = cam, cframe = cam.CFrame, frame = betaNoSpinFrame + 1}
			pcall(function() cam.CFrame = CFrame.lookAt(betaNoSpinPendingCam.cframe.Position, targetRoot.Position) end)
		end
		betaNoSpinLastShot = now
		betaFireShot()
		betaNoSpinExpire[target.model] = now + 0.2
	end)
end

autofireToggle = createToggle(combatContent, "Autofire (Triggerbot)", function(enabled)
	autofireEnabled = enabled
	if enabled then
		lastAutofireShot = 0
		_G.autofireLoop = RunService.RenderStepped:Connect(function()
			if panelVisible or not autofireEnabled then autofireCandidateSince = 0 return end
			if autofireMode == "Hold" and not autofireKeyHeld then autofireCandidateSince = 0 return end

			local camera = workspace.CurrentCamera
			if not camera then autofireCandidateSince = 0 return end

			local localCharacter = LocalPlayer.Character
			local localHumanoid = localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")
			if not localCharacter or not localHumanoid or localHumanoid.Health <= 0 then autofireCandidateSince = 0 return end

			local targetPlayer = currentAimbotTarget
			if not canTriggerOnPlayer(targetPlayer) then
				local origin = camera.CFrame.Position
				local dir = camera.CFrame.LookVector * 1000

				local rayParams = RaycastParams.new()
				rayParams.FilterDescendantsInstances = {localCharacter, camera}
				rayParams.FilterType = Enum.RaycastFilterType.Exclude
				rayParams.IgnoreWater = true

				local result = workspace:Raycast(origin, dir, rayParams)
				if result and result.Instance then
					local char = result.Instance:FindFirstAncestorOfClass("Model")
					targetPlayer = Players:GetPlayerFromCharacter(char)
				end
			end

			local canShoot = false
			if canTriggerOnPlayer(targetPlayer) and crosshairOnModel(targetPlayer.Character, 1000, true) then
				local origin = camera.CFrame.Position
				local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
				if targetRoot and hasClearShot(origin, targetRoot.Position, {localCharacter, camera, targetPlayer.Character}) then
					canShoot = true
				end
			end

			if not canShoot then autofireCandidateSince = 0 return end

			-- So dispara depois que o alvo ficou na mira pelo delay configurado
			local now = tick()
			if autofireCandidateSince == 0 then autofireCandidateSince = now end
			if now - autofireCandidateSince < autofireTriggerDelay then return end

			fireAutofireShot()
		end)
	else
		if _G.autofireLoop then _G.autofireLoop:Disconnect() end
	end
end, "Fires automatically when Aimbot has a clear target.", {
	bindId = "autofire",
	getBindValue = function() return autofireBind end,
	getBindName = function() return autofireBindString end,
	setBind = function(bindValue, bindName)
