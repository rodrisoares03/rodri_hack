weaponDisplayCache = setmetatable({}, {__mode = "k"}) -- [character] = {text, at}

function getEquippedWeaponDisplay(character)
	if not character then return nil end
	local cached = weaponDisplayCache[character]
	if cached and tick() - cached.at < 0.4 then return cached.text end

	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("Tool") then tool = obj break end
		end
	end
	local result = nil
	if tool then
		local name = tool:GetAttribute("DisplayName") or tool.Name
		if type(name) == "string" and name ~= "" then result = "[ " .. name .. " ]" end
	end
	weaponDisplayCache[character] = {text = result, at = tick()}
	return result
end

