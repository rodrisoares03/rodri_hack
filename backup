function getClosestPlayer()
	if not aimbotEnabled then return nil end

	local closestPlayer = nil
	local closestDistance = aimbotFOV * 1.5
	local camera = workspace.CurrentCamera
	local centerPos = aimbotMobile and UserInputService:GetMouseLocation() or Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isValidPlayer(player) and isEnemy(player) then
			local data = syncPlayerCharacter(player)
			if data and data.character then
				local character = data.character

				if not isInSameDimension(character) then
					continue
				end

				local targetPart = (aimbotTarget == "Head") and character:FindFirstChild("Head") or (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"))

				if targetPart then
					local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
					if onScreen then
						local distance = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
						if distance <= closestDistance then
							if aimbotOnlyVisible then
								local highlight = highlights[character]
								if not highlight or highlight.FillColor ~= Color3.fromRGB(0, 255, 0) then
									continue
								end
							end
							closestDistance = distance
							closestPlayer = player
						end
					end
				end
			end
		end
	end

	return closestPlayer
end

-- Aimbot aim function
function aimAt(targetPlayer)
	if not targetPlayer or not targetPlayer.Character or isMenuFriend(targetPlayer) then return end

	local camera = workspace.CurrentCamera
	local character = targetPlayer.Character

	local targetPart = nil
if aimbotTarget == "Head" then
		targetPart = character:FindFirstChild("Head")
elseif aimbotTarget == "Chest" then
		targetPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	end

	if not targetPart then return end

	local targetPos = targetPart.Position
	local camPos = camera.CFrame.Position
	local targetCFrame = CFrame.lookAt(camPos, targetPos)

	local smoothFactor = (20 - aimbotSmooth) / 20
	if smoothFactor < 0.05 then smoothFactor = 1 end

	camera.CFrame = camera.CFrame:Lerp(targetCFrame, smoothFactor)
end

-- ========= SILENT AIM / NO RECOIL / NO SPREAD - ENGINE =========
silentTargetCache = nil
silentTargetCacheAt = 0

function getSilentTargetPart(character)
	if not character then return nil end
	if silentTargetPart == "Chest" then
		return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	elseif silentTargetPart == "Root" then
		return character:FindFirstChild("HumanoidRootPart")
	end
	return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

function getSilentTarget()
	local now = tick()
	if silentTargetCache and now - silentTargetCacheAt < 0.06 then
		local cachedPart = silentTargetCache.part
		if cachedPart and cachedPart.Parent then return silentTargetCache end
	end
	silentTargetCache = nil

	local characterLocal = LocalPlayer.Character
	local myRoot = characterLocal and characterLocal:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local best, bestDist = nil, silentMaxDistance
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and not isMenuFriend(player) and isEnemy(player) then
			local targetChar = player.Character
			local humanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
			if targetChar and humanoid and humanoid.Health > 0 and isInSameDimension(targetChar) then
				local part = getSilentTargetPart(targetChar)
				if part then
					local dist = (part.Position - myRoot.Position).Magnitude
					if dist <= bestDist then
						bestDist = dist
						best = { part = part, position = part.Position, character = targetChar }
					end
				end
			end
		end
	end

	-- Players e NPCs entram na mesma disputa: vence o mais perto do jogador
	if silentIncludeNPCs then
		for _, info in ipairs(npcEspCachedModels) do
			local model = info.model
			local root = info.root
			if model and model.Parent and root and root:IsA("BasePart") and info.humanoid and info.humanoid.Health > 0 then
				local part = getSilentTargetPart(model) or root
				local dist = (part.Position - myRoot.Position).Magnitude
				if dist <= bestDist then
					bestDist = dist
					best = { part = part, position = part.Position, character = model }
				end
			end
		end
	end

	silentTargetCache = best
	silentTargetCacheAt = now
	return best
end

function updateSilentStatus()
	if not silentStatusLabel then return end
	local supported = type(getrawmetatable) == "function" and type(setreadonly) == "function"
		and type(newcclosure) == "function" and type(getnamecallmethod) == "function"
	local hookText = silentHookInstalled and "HOOK ATIVO" or (supported and "HOOK PRONTO" or "SEM SUPORTE")
	local function tag(on) return on and "ON" or "OFF" end
	silentStatusLabel.Text = string.format("SILENT %s | NPC %s | RECOIL %s | SPREAD %s | %s",
		tag(silentAimEnabled), tag(silentIncludeNPCs), tag(noRecoilEnabled), tag(noSpreadEnabled), hookText)
	silentStatusLabel.TextColor3 = silentHookInstalled and Color3.fromRGB(170, 255, 170) or C.TxtWhite
end

function ensureSilentHooks()
	local wantAny = silentAimEnabled or noRecoilEnabled or noSpreadEnabled
	if not wantAny then
		if silentHookCleanup then
			pcall(silentHookCleanup)
			silentHookCleanup = nil
		end
		silentHookInstalled = false
		silentTargetInstance = nil
		updateSilentStatus()
		return true
	end
	if silentHookInstalled then return true end

	if type(getrawmetatable) ~= "function" or type(setreadonly) ~= "function"
		or type(newcclosure) ~= "function" or type(getnamecallmethod) ~= "function" then
		updateSilentStatus()
		pcall(function()
			showMenuToast("Silent/Bypass", "Executor sem suporte a hook de metatable.", Color3.fromRGB(255, 170, 70))
		end)
		return false
	end

	local ok, err = pcall(function()
		local mt = getrawmetatable(game)
		if not mt then error("metatable indisponivel") end
		local originalNamecall = mt.__namecall
		local hasCheckCaller = type(checkcaller) == "function"
		setreadonly(mt, false)

		local function lower(v) return tostring(v or ""):lower() end
		local function contains(hay, needle) return lower(hay):find(needle, 1, true) ~= nil end

		local function isFireMethod(method)
			local m = lower(method)
			return contains(m, "fireserver") or contains(m, "invoke")
				or (contains(m, "fire") and not contains(m, "client"))
		end

		local function remoteIsWeapon(obj)
			local n = lower(obj and obj.Name)
			return contains(n, "fire") or contains(n, "shoot") or contains(n, "bullet")
				or contains(n, "weapon") or contains(n, "gun") or contains(n, "attack")
				or contains(n, "damage") or contains(n, "hit") or contains(n, "projectile")
				or contains(n, "swing") or contains(n, "cast")
		end

		local function isRecoilRemote(obj, method)
			local n = lower(obj and obj.Name)
			local m = lower(method)
			return contains(n, "recoil") or contains(n, "viewkick") or contains(n, "shake")
				or contains(n, "camerakick") or contains(m, "recoil")
		end

		local function rewriteArg(value, origin, targetPos, remoteName, depth)
			depth = depth or 0
			if depth > 2 then return value end
			local kind = typeof(value)

			if silentAimEnabled and targetPos then
				if kind == "CFrame" then
					if (value.Position - targetPos).Magnitude > 0.001 then
						return CFrame.lookAt(value.Position, targetPos)
					end
				elseif kind == "Vector3" then
					local mag = value.Magnitude
					local fromOrigin = (value - origin).Magnitude
					if (mag >= 0.5 and mag <= 1.5 and fromOrigin <= 2.5) or silentAggressiveBypass then
						local dir = targetPos - origin
						if dir.Magnitude > 0.001 then return dir.Unit end
					elseif fromOrigin > 2.5 and (silentAggressiveBypass or mag > 2.5) then
						return targetPos
					end
				elseif kind == "Instance" and value:IsA("BasePart") then
					local model = value:FindFirstAncestorWhichIsA("Model")
					if model and model:FindFirstChildOfClass("Humanoid") and silentTargetInstance then
						return silentTargetInstance
					end
				elseif type(value) == "table" then
					for k, sub in pairs(value) do value[k] = rewriteArg(sub, origin, targetPos, remoteName, depth + 1) end
					return value
				end
			end

			if noSpreadEnabled then
				if kind == "Vector3" and value.Magnitude <= 0.5 then
					return Vector3.zero
				elseif type(value) == "number" and value > 0
					and (contains(remoteName, "spread") or contains(remoteName, "accuracy") or contains(remoteName, "random")) then
					return 0
				end
			end
			return value
		end

		mt.__namecall = newcclosure(function(self, ...)
			local method = getnamecallmethod()
			local count = select("#", ...)
			local args = { ... }

			local skipSelf = false
			if hasCheckCaller and silentBypassEnabled then
				local okCc, cc = pcall(checkcaller)
				skipSelf = okCc and cc == true
			end

			-- NO RECOIL: bloqueia remotos exclusivos de recuo/view-kick
			if not skipSelf and noRecoilEnabled and isRecoilRemote(self, method) then
				return nil
			end

			-- SILENT: redireciona raycasts do proprio workflow de armas
			if not skipSelf and silentAimEnabled and method == "Raycast" and self == workspace then
				local target = getSilentTarget()
				local origin = args[1]
				if target and typeof(origin) == "Vector3" then
					local dir = target.position - origin
					if dir.Magnitude > 0.001 then
						return originalNamecall(self, origin, dir.Unit, args[3], args[4])
					end
				end
			end

			-- SILENT: redireciona raios vindos da camera (ScreenPointToRay / ViewportPointToRay)
			if not skipSelf and silentAimEnabled and typeof(self) == "Instance" and self:IsA("Camera")
				and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
				local ray = originalNamecall(self, ...)
				local target = getSilentTarget()
				if ray and target then
					local dir = target.position - ray.Origin
					if dir.Magnitude > 0.001 then
						return Ray.new(ray.Origin, dir.Unit)
					end
				end
				return ray
			end

			-- SILENT + NO SPREAD: reescreve argumentos de remotos de tiro
			if not skipSelf and (silentAimEnabled or noSpreadEnabled) and isFireMethod(method) and remoteIsWeapon(self) then
				local target = silentAimEnabled and getSilentTarget() or nil
				local targetPos = target and target.position or nil
				silentTargetInstance = target and target.part or nil

				local origin = Vector3.zero
				local cam = workspace.CurrentCamera
				if cam then origin = cam.CFrame.Position end
				for i = 1, count do
					local v = args[i]
					if typeof(v) == "CFrame" then origin = v.Position break end
					if typeof(v) == "Vector3" and v.Magnitude > 2 then origin = v break end
				end

				for i = 1, count do
					args[i] = rewriteArg(args[i], origin, targetPos, lower(self and self.Name), 0)
				end

				-- Bypass agressivo: neutraliza math.random apenas durante o disparo
				if silentAggressiveBypass and type(math.random) == "function" then
					local originalRandom = math.random
					math.random = function(a, b)
						if a ~= nil then return originalRandom(a, b) end
						return 0.5
					end
					local okCall, packed = pcall(originalNamecall, self, table.unpack(args, 1, count))
					math.random = originalRandom
					if not okCall then error(packed) end
					return table.unpack(packed, 1, packed.n)
				end

				return originalNamecall(self, table.unpack(args, 1, count))
			end

			return originalNamecall(self, ...)
		end)

		silentHookCleanup = function()
			pcall(function()
				setreadonly(mt, false)
				mt.__namecall = originalNamecall
				setreadonly(mt, true)
			end)
		end
		nightRegisterCleanup(function()
			if silentHookCleanup then silentHookCleanup() end
		end)
		silentHookInstalled = true
	end)

	if not ok then
		silentHookInstalled = false
		updateSilentStatus()
		pcall(function()
			showMenuToast("Silent/Bypass", "Falha ao instalar hook: " .. tostring(err), Color3.fromRGB(255, 120, 120))
		end)
		return false
	end
	updateSilentStatus()
	return true
end

