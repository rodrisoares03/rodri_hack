-- ========= ANTI CLICK-THROUGH =========
-- Cliques/taps que caiam sobre o menu são absorvidos e nunca chegam ao jogo.
function isNightPointOverMenu(pos)
	if not panelVisible or not mainFrame or not mainFrame.Visible then
		return false
	end
	local ap, as = mainFrame.AbsolutePosition, mainFrame.AbsoluteSize
	if pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
		return true
	end
	if restoreButton and restoreButton.Visible and restoreButton.Parent then
		local rap, ras = restoreButton.AbsolutePosition, restoreButton.AbsoluteSize
		if pos.X >= rap.X and pos.X <= rap.X + ras.X and pos.Y >= rap.Y and pos.Y <= rap.Y + ras.Y then
			return true
		end
	end
	return false
end

ContextActionService:BindActionAtPriority(
	"NightMenuClickShield",
	function(_, inputState)
		local ok, over = pcall(function()
			return isNightPointOverMenu(UserInputService:GetMouseLocation())
		end)
		if ok and over then
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end,
	false,
	Enum.ContextActionPriority.High.Value + 1,
	Enum.UserInputType.MouseButton1,
	Enum.UserInputType.MouseButton2,
	Enum.UserInputType.Touch
)

