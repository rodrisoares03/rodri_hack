function soloDimAnimateBody(fake, moving, airborne, clock)
	if not fake then return end
	local swing = moving and math.sin(clock * 9) * 0.72 or 0
	local bob = moving and math.abs(math.sin(clock * 9)) * 0.045 or 0
	for _, joint in ipairs(fake:GetDescendants()) do
		if joint:IsA("Motor6D") then
			if not soloDimJointBase[joint] then
				soloDimJointBase[joint] = joint.Transform
			end
			local base = soloDimJointBase[joint]
			local name = string.lower(joint.Name)
			local angle = 0
			if name:find("left shoulder") or name:find("leftshoulder") then
				angle = swing
			elseif name:find("right shoulder") or name:find("rightshoulder") then
				angle = -swing
			elseif name:find("left hip") or name:find("lefthip") then
				angle = -swing
			elseif name:find("right hip") or name:find("righthip") then
				angle = swing
			elseif name:find("left knee") or name:find("leftknee") then
				angle = math.max(0, -swing) * 0.35
			elseif name:find("right knee") or name:find("rightknee") then
				angle = math.max(0, swing) * 0.35
			elseif name == "waist" or name == "root" then
				joint.Transform = base * CFrame.new(0, -bob, 0)
				continue
			end
			if airborne and (name:find("shoulder") or name:find("hip") or name:find("knee")) then
				angle = 0
			end
			joint.Transform = base * CFrame.Angles(angle, 0, 0)
		end
	end
end

function soloDimSyncRealPose(realChar, fake)
	if not realChar or not fake then return end
	local hasTool = realChar:FindFirstChildOfClass("Tool") ~= nil
	local realJoints = {}
	for _, joint in ipairs(realChar:GetDescendants()) do
		if joint:IsA("Motor6D") then
			local key = joint.Name .. "|" .. (joint.Part0 and joint.Part0.Name or "") .. "|" .. (joint.Part1 and joint.Part1.Name or "")
			realJoints[key] = joint
		end
	end
	for _, joint in ipairs(fake:GetDescendants()) do
		if joint:IsA("Motor6D") then
			local name = string.lower(joint.Name)
			local isLeg = name:find("hip") or name:find("knee") or name:find("ankle") or name:find("leg") or name:find("foot")
			local isArm = name:find("shoulder") or name:find("elbow") or name:find("wrist") or name:find("arm") or name:find("hand")
			
			if soloDimBodyMoving or soloDimBodyAirborne then
				if isLeg then continue end
				if isArm and not hasTool then continue end
				if name:find("root") or name == "waist" then continue end
			end
			
			local key = joint.Name .. "|" .. (joint.Part0 and joint.Part0.Name or "") .. "|" .. (joint.Part1 and joint.Part1.Name or "")
			local source = realJoints[key]
			if source then joint.Transform = source.Transform end
		end
	end
end

function soloDimSetupAnimations(fakeHum)
	if not fakeHum then return end
	soloDimJointBase = {}
	pcall(function()
		local oldAnimator = fakeHum:FindFirstChildOfClass("Animator")
		if oldAnimator then oldAnimator:Destroy() end
		local animator = Instance.new("Animator")
		animator.Parent = fakeHum
		
		local function getPlayerAnim(animType, fallback)
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("Animate") then
				local folder = char.Animate:FindFirstChild(animType)
				if folder then
					local anim = folder:FindFirstChildOfClass("Animation")
					if anim and anim.AnimationId ~= "" then
						return anim.AnimationId
					end
				end
			end
			return "rbxassetid://" .. tostring(fallback)
		end

		local idleId = getPlayerAnim("idle", 507766666)
		local walkId = getPlayerAnim("walk", 180426354)
		if walkId == "rbxassetid://180426354" then walkId = getPlayerAnim("run", 180426354) end
		local jumpId = getPlayerAnim("jump", 125750702)

		local function loadTrack(animIdStr, looped, priority)
			local animation = Instance.new("Animation")
			animation.AnimationId = animIdStr
			local track = animator:LoadAnimation(animation)
			track.Looped = looped
			track.Priority = priority
			return track
		end

		soloDimIdleTrack = loadTrack(idleId, true, Enum.AnimationPriority.Idle)
		soloDimWalkTrack = loadTrack(walkId, true, Enum.AnimationPriority.Movement)
		soloDimJumpTrack = loadTrack(jumpId, false, Enum.AnimationPriority.Action)
		
		if soloDimIdleTrack then soloDimIdleTrack:Play(0.15) end
	end)
end

