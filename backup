-- Função simples para criar botão de jogador
function createPlayerButton(player)
	if not player or player == LocalPlayer then return end
	if not playersList or not playersList.Parent then return end
	
	-- Verificar se já existe botão para este jogador
	if playerButtons[player] then
		return playerButtons[player]
	end
	
	-- Remover botão antigo se existir (por nome)
	local existingBtn = playersList:FindFirstChild(player.Name .. "_Simple")
	if existingBtn then
		existingBtn:Destroy()
	end

	local btn = Instance.new("TextButton")
	btn.Name = player.Name .. "_Simple"
	btn.Size = UDim2.new(1, 0, 0, 64)
	btn.BackgroundColor3 = SAKURA.buttonBg
	btn.Text = ""
	btn.Parent = playersList
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

	local avatar = Instance.new("ImageLabel")
	avatar.Size = UDim2.new(0, 52, 0, 52)
	avatar.Position = UDim2.new(0, 8, 0, 6)
	avatar.BackgroundColor3 = SAKURA.surfaceLight
	avatar.BorderSizePixel = 0
	avatar.Image = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
	avatar.Parent = btn
	Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, -168, 1, -12)
	nameLabel.Position = UDim2.new(0, 66, 0, 6)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 16
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextYAlignment = Enum.TextYAlignment.Center
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	if player.DisplayName and player.DisplayName ~= "" and player.DisplayName ~= player.Name then
		nameLabel.Text = player.DisplayName .. " - @" .. player.Name
	else
		nameLabel.Text = "@" .. player.Name
	end
	nameLabel.Parent = btn

	local friendBadge = Instance.new("TextLabel")
	friendBadge.Name = "FriendBadge"
	friendBadge.Size = UDim2.new(0, 88, 0, 24)
	friendBadge.Position = UDim2.new(1, -98, 0.5, -12)
	friendBadge.BackgroundColor3 = Color3.fromRGB(43, 45, 53)
	friendBadge.BorderSizePixel = 0
	friendBadge.Font = Enum.Font.GothamBold
	friendBadge.TextSize = 9
	friendBadge.Text = "FRIEND"
	friendBadge.TextColor3 = FRIEND_ESP_COLOR
	friendBadge.Visible = isMenuFriend(player)
	friendBadge.Parent = btn
	Instance.new("UICorner", friendBadge).CornerRadius = UDim.new(0, 6)

	local selectionIndicator = Instance.new("Frame")
	selectionIndicator.Name = "SelectionIndicator"
	selectionIndicator.Size = UDim2.new(0, 4, 1, -8)
	selectionIndicator.Position = UDim2.new(0, 2, 0, 4)
	selectionIndicator.BackgroundColor3 = SAKURA.primary
	selectionIndicator.Visible = false
	selectionIndicator.Parent = btn
	Instance.new("UICorner", selectionIndicator).CornerRadius = UDim.new(0, 2)

	if selectedPlayer == player then
		selectionIndicator.Visible = true
		btn.BackgroundColor3 = SAKURA.surfaceLight
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
	updatePlayerFriendVisual(player)

	btn.MouseButton1Click:Connect(function()
		-- Verificar se o player ainda existe
		if not player or not player.Parent then
			selectedPlayer = nil
			if actionsPanel then actionsPanel.Visible = false end
			if tpBtn then tpBtn.Visible = false end
			if spectateToggle then spectateToggle.Visible = false end
			if infinitePushBtn then infinitePushBtn.Visible = false end
			stopInfinitePush()
			return
		end
		
		for _, button in ipairs(playersList:GetChildren()) do
			if button:IsA("TextButton") then
				local indicator = button:FindFirstChild("SelectionIndicator")
				local label = button:FindFirstChild("NameLabel")
				local isSelected = button == btn
				if indicator then indicator.Visible = isSelected end
				button.BackgroundColor3 = isSelected and SAKURA.surfaceLight or SAKURA.buttonBg
				if label then label.TextColor3 = Color3.fromRGB(255, 255, 255) end
			end
		end
		selectedPlayer = player
		updatePlayerFriendVisual(player)
		if actionsPanel then actionsPanel.Visible = true end
		if tpBtn then tpBtn.Visible = true end
		if friendToggleBtn then friendToggleBtn.Visible = true end
		if spectateToggle then spectateToggle.Visible = true end
		if infinitePushBtn then infinitePushBtn.Visible = true end
		if spectateActive then
			spectateActive = false
			stopSpectate()
		end
	end)

	playerButtons[player] = btn
	updatePlayerFriendVisual(player)
	return btn
end

