	if typeof(VirtualUser) == "Instance" then
		pcall(function()
			VirtualUser:Button1Down(Vector2.new(cx, cy))
			VirtualUser:Button1Up(Vector2.new(cx, cy))
		end)
	end
end

-- ========= CHAMADA BETA: spin + trigger 360 (nao mexe no autofire/trigger existentes) =========
function betaFindTarget()
	local char = LocalPlayer.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end
	local best, bestDist = nil, math.huge

	-- Players (inimigos)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isEnemy(player) then
			local targetChar = player.Character
			if targetChar and isInSameDimension(targetChar) then
				local hum = targetChar:FindFirstChildOfClass("Humanoid")
				local root = targetChar:FindFirstChild("HumanoidRootPart")
				if hum and root and hum.Health > 0 then
					local dist = (root.Position - myRoot.Position).Magnitude
					if dist <= betaSpinTriggerRange and dist < bestDist then
						-- Silent aim mira SEMPRE na cabeca
						local head = targetChar:FindFirstChild("Head") or root
						best = {model = targetChar, root = root, aimPart = head, dist = dist}
						bestDist = dist
					end
				end
			end
		end
	end

	-- NPCs: scan proprio com throttling (nao depende do ESP/NPC trigger estar ligado)
	if tick() - betaLastNpcScan >= 0.2 then
		betaLastNpcScan = tick()
		local scanned = getNPCsFromWorkspace()
		if scanned then betaNpcCache = scanned end
	end
	for _, info in ipairs(betaNpcCache) do
		local model = info.model
		local root = info.root
		if model and model.Parent and root and root:IsA("BasePart") then
			local hum = info.humanoid
			if hum and hum.Health > 0 then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist <= betaSpinTriggerRange and dist < bestDist then
					local head = model:FindFirstChild("Head") or root
					best = {model = model, root = root, aimPart = head, dist = dist}
					bestDist = dist
				end
			end
		end
	end

	return best
end

