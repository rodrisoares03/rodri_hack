-- NOVO: Spinbot
spinbotSpeed = 500 -- Velocidade MAIS SUAVE (Pedida pelo usuário)
spinbotLookDown = 75 -- Inclina a CABEÇA para baixo (olhar para o chão / anti-aim). A câmara do jogador não é alterada.

-- Inclinar so a cabeca atraves dos joints (Neck/Waist). NUNCA inclinar o HumanoidRootPart:
-- isso enterrava o corpo no chao e a fisica da Roblox atirava o personagem para cima.
_G.spinLookDownJoints = {}
_G.spinNeckOriginals = {}

function getSpinLookDownJoints(char)
	if _G.spinLookDownJoints[char] then return _G.spinLookDownJoints[char] end
	local neck, waist
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("Motor6D") then
			if obj.Name == "Neck" and not neck then neck = obj end
			if obj.Name == "Waist" and not waist then waist = obj end
		end
	end
	local joints = {neck = neck, waist = waist}
	_G.spinLookDownJoints[char] = joints
	return joints
end

function applySpinLookDown(char)
	local joints = getSpinLookDownJoints(char)
	local function tilt(joint, degrees)
		if not joint or not joint.Parent then return end
		if _G.spinNeckOriginals[joint] == nil then
			_G.spinNeckOriginals[joint] = joint.C0
		end
		joint.C0 = _G.spinNeckOriginals[joint] * CFrame.Angles(math.rad(degrees), 0, 0)
	end
	tilt(joints.neck, -spinbotLookDown)
	tilt(joints.waist, -spinbotLookDown * 0.35)
end

function restoreSpinLookDown()
	for joint, c0 in pairs(_G.spinNeckOriginals) do
		pcall(function()
			if joint and joint.Parent then joint.C0 = c0 end
		end)
	end
	_G.spinNeckOriginals = {}
	_G.spinLookDownJoints = {}
end

spinbotToggle = createToggle(combatContent, "Spinbot (Anti-Aim)", function(enabled)
	if enabled then
		_G.spinAngle = 0
		_G.spinLoop = RunService.RenderStepped:Connect(function()
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local hum = char:FindFirstChild("Humanoid")
				local root = char.HumanoidRootPart
				if hum then
					-- SÓ ATIVA QUANDO O ROUND COMEÇA (WalkSpeed > 0)
					if hum.WalkSpeed <= 0 then
						hum.AutoRotate = true
						return
					end

					hum.AutoRotate = false -- Previne a tentativa de ficar de pé da engine
					if hum.FloorMaterial ~= Enum.Material.Air then
						hum.Jump = true -- Força a saltar normal
					else
						-- BHOP CS2: Puxado para o chão suavemente na queda
						local vel = root.AssemblyLinearVelocity
						if vel.Y <= 0 then
							root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y - 2, vel.Z)
						end
					end
					
					-- Andar mais rápido enquanto gira (CFrame Speed EQUILIBRADO)
					if hum.MoveDirection.Magnitude > 0 then
						local rayParams = RaycastParams.new()
						rayParams.FilterDescendantsInstances = {char}
						rayParams.FilterType = Enum.RaycastFilterType.Exclude
						
						-- Verificar se há uma parede/barreira no caminho antes de teleportar
						local rayResult = workspace:Raycast(root.Position, hum.MoveDirection * 2, rayParams)
						if not rayResult then
							root.CFrame = root.CFrame + (hum.MoveDirection * 0.15)
						end
					end
				end
				
				-- Inclina apenas a cabeca/tronco (anti-aim: olha para o chao). O Root continua direito.
				-- A camara nao e tocada, por isso a tua visao continua normal.
				pcall(function() applySpinLookDown(char) end)

				-- Rotação Pura, Matemática (Impossível de deitar ou bugar física)
				_G.spinAngle = _G.spinAngle + spinbotSpeed
				if _G.spinAngle >= 360 then _G.spinAngle = _G.spinAngle - 360 end

				-- Mantém a posição rodado apenas no eixo Y (sem inclinar o Root)
				root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(_G.spinAngle), 0)
			end
		end)
	else
		if _G.spinLoop then _G.spinLoop:Disconnect() end
		
		-- Restaurar estado natural do personagem
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("Humanoid") then
			char.Humanoid.AutoRotate = true
		end
		pcall(restoreSpinLookDown)
	end
end, "Spins your character quickly to throw off enemy aim.", {
	bindId = "spinbot",
	getBindValue = function() return spinbotBind end,
	getBindName = function() return spinbotBindString end,
	setBind = function(bindValue, bindName)
		spinbotBind = bindValue
		spinbotBindString = bindDisplayName(bindValue, bindName)
	end,
})

