function createTab(name, text, icon, order)
	local active = (name == "UPDATES")
	local tab = New("TextButton", {
		Name = name .. "Tab",
		LayoutOrder = order,
		BackgroundColor3 = active and C.ActiveTabBg or C.BgSidebar,
		BackgroundTransparency = active and 0.0 or 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		AutoButtonColor = false,
	}, sidebarScroll)
	Corner(8, tab)
	local bar = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(45, 26, 4),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.2, 0),
		Size = UDim2.new(0, 3, 0.6, 0),
		BackgroundTransparency = active and 0 or 1,
	}, tab)
	Corner(2, bar)
	local tabLabel = New("TextLabel", {
		Text = text,
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextColor3 = active and Color3.fromRGB(30, 18, 3) or Color3.fromRGB(205, 206, 214),
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(1, -20, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, tab)
	tab.MouseEnter:Connect(function()
		if currentTab ~= name then
			UI_Tween(tab, {BackgroundTransparency = 0.6, BackgroundColor3 = C.TabHover}, 0.15)
			UI_Tween(tabLabel, {TextColor3 = Color3.fromRGB(230, 230, 238)}, 0.15)
		end
	end)
	tab.MouseLeave:Connect(function()
		if currentTab ~= name then
			UI_Tween(tab, {BackgroundTransparency = 1, BackgroundColor3 = C.BgSidebar}, 0.15)
			UI_Tween(tabLabel, {TextColor3 = Color3.fromRGB(205, 206, 214)}, 0.15)
		end
	end)
	tab.MouseButton1Click:Connect(function() setTab(name) end)
	tabs[name] = {tab, nil, tabLabel, nil, bar}
	return tab
end

function setTab(tabName)
	for name, tabData in pairs(tabs) do
		local tab, icon, label = tabData[1], tabData[2], tabData[3]
		local indicator = tabData[5]
		if name == tabName then
			UI_Tween(tab, {BackgroundColor3 = C.ActiveTabBg, BackgroundTransparency = 0.0}, 0.2)
			UI_Tween(label, {TextColor3 = Color3.fromRGB(30, 18, 3)}, 0.2)
			if indicator then indicator.Visible = true indicator.BackgroundTransparency = 0 end
			pages[name].Visible = true
			pages[name].CanvasPosition = Vector2.new(0, 0)
			currentTab = name
		else
			UI_Tween(tab, {BackgroundTransparency = 1, BackgroundColor3 = C.BgSidebar}, 0.2)
			UI_Tween(label, {TextColor3 = Color3.fromRGB(205, 206, 214)}, 0.2)
			if indicator then indicator.Visible = false indicator.BackgroundTransparency = 1 end
			pages[name].Visible = false
		end
	end

	if tabName == "UTIL" then
		task.defer(function()
			bindAutoSize(movementSubCategory, movementLayout)
			bindAutoSize(boostsSubCategory, boostsLayout)
			bindAutoSize(utilsSubCategory, utilsLayout)
			refreshUtilCanvas()
		end)
	end

	if not suppressThemeFeedback then
		saveInterfaceSettings()
	end
end
