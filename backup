-- Tenta usar o alcance real da arma (atributos/values comuns) e limita ao valor do menu
function getAutofireRange()
	if autofireMaxDistance <= 0 then return math.huge end
	local myChar = LocalPlayer.Character
	local tool = myChar and myChar:FindFirstChildOfClass("Tool")
	if tool then
		for _, name in ipairs({"Range", "MaxRange", "AttackRange", "WeaponRange"}) do
			local attr = tool:GetAttribute(name)
			if type(attr) == "number" and attr > 0 then return math.min(attr, autofireMaxDistance) end
			local val = tool:FindFirstChild(name)
			if val and type(val.Value) == "number" and val.Value > 0 then return math.min(val.Value, autofireMaxDistance) end
		end
	end
	return autofireMaxDistance
end

function canTriggerOnPlayer(player)
	if player and isMenuFriend(player) then return false end
	if not player or player == LocalPlayer or not isEnemy(player) then return false end
	if not player.Character or not isInSameDimension(player.Character) then return false end

	local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
	local root = player.Character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then return false end

	-- So atira se o tiro alcanca o alvo (evita trigger em player muito longe)
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local maxRange = getAutofireRange()
	if myRoot and maxRange ~= math.huge and (root.Position - myRoot.Position).Magnitude > maxRange then return false end

	return true
end

-- So confirma o tiro se a mira (centro da tela) estiver realmente no model
function crosshairOnModel(model, maxDist, strict)
	local camera = workspace.CurrentCamera
	if not camera or not model then return false end
	local vp = camera.ViewportSize
	local ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	local limit = maxDist or 1000

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = {model}
	params.IgnoreWater = true
	local hit = workspace:Raycast(ray.Origin, ray.Direction * limit, params)
	if hit and hit.Instance then
		if hit.Instance:FindFirstAncestorOfClass("Model") == model then return true end
	end

	-- Fallback: distancia do centro da mira ate o root do model
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if root then
		local to = root.Position - ray.Origin
		local along = to:Dot(ray.Direction)
		if along > 0 and along <= limit then
			local closest = ray.Origin + ray.Direction * along
			local off = (root.Position - closest).Magnitude
			-- No trigger exige mira practically em cima (evita tiro no vazio)
			if strict then return off <= 2 end
			if off <= math.clamp(2.5 + along * 0.02, 3, 9) then return true end
		end
	end
	return false
end

-- Jogos tipo CS2: paredes finas/materiais macios sao perfuraveis pela bala.
TRIGGER_WALL_PENETRATION = true

PENETRABLE_MATERIALS = {
	Wood = true, WoodPlanks = true, Plastic = true, Glass = true,
	Ice = true, Snow = true, Fabric = true, Paper = true,
	Cardboard = true, Foliage = true, LeafyGrass = true,
	Grass = true, Sand = true, Slate = true, Aluminum = true,
}

function isPenetrablePart(part)
	if not part or not part:IsA("BasePart") then return false end
	-- Personagens nunca contam como parede
	local model = part:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then return false end
	if part:GetAttribute("Penetrable") == true or part:GetAttribute("CanPenetrate") == true
		or part:GetAttribute("BulletPenetration") == true then return true end
	if PENETRABLE_MATERIALS[part.Material and part.Material.Name or ""] then
		-- Mesmo material macio so e perfurado se a parede for fina
		local s = part.Size
		return math.min(s.X, s.Y, s.Z) <= 2
	end
	return false
end

-- Raycast que ignora paredes perfuraveis e devolve o primeiro bloqueio solido
function raycastSkipPenetrable(origin, direction, maxDist, ignored)
	local ignore = {}
	for _, v in ipairs(ignored or {}) do if v then table.insert(ignore, v) end end
	local start = origin
	local travelled = 0
	for _ = 1, 6 do
		local remain = maxDist - travelled
		if remain <= 0.05 then return nil end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = ignore
		params.IgnoreWater = true
		local hit = workspace:Raycast(start, direction * remain, params)
		if not hit then return nil end
		travelled = travelled + (hit.Position - start).Magnitude
		if not TRIGGER_WALL_PENETRATION or not isPenetrablePart(hit.Instance) then return hit end
		table.insert(ignore, hit.Instance)
		start = hit.Position + direction * 0.05
	end
	return nil
end

function hasClearShot(origin, endPos, ignored)
	local delta = endPos - origin
	local dist = delta.Magnitude
	if dist < 0.01 then return true end
	return raycastSkipPenetrable(origin, delta.Unit, dist, ignored) == nil
end

function fireAutofireShot()
	local now = tick()
	if now - lastAutofireShot < autofireCooldown then return end
	lastAutofireShot = now

	local character = LocalPlayer.Character
	if character then
		local tool = character:FindFirstChildOfClass("Tool")
		if tool then
			pcall(function() tool:Activate() end)
		end
	end

	if mouse1click then
		pcall(function() mouse1click() end)
	end

	-- Clique no CENTRO da tela (0,0 atirava para o canto/chao em alguns jogos)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local cx, cy = vp.X / 2, vp.Y / 2

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
		VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
