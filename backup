-- ========= CUSTOM X CURSOR (ScreenGui - immune to game) =========
cursorGui = nil
cursorFrames = {}
cursorTrackPos = Vector2.new(0.5, 0.5)
cursorInited = false

local function initCursorGui()
	if cursorGui and cursorGui.Parent then return end
	cursorGui = Instance.new("ScreenGui")
	cursorGui.Name = "NightCursorX"
	cursorGui.IgnoreGuiInset = true
	cursorGui.DisplayOrder = 99999
	cursorGui.ResetOnSpawn = false
	cursorGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	cursorGui.Parent = game:GetService("CoreGui")

	local armLen = 20
	local gap = 3
	local thick = 2
	local col = Color3.fromRGB(255, 255, 255)
	local vp = workspace.CurrentCamera.ViewportSize

	local function makeArm(name, dx, dy)
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundColor3 = col
		f.BorderSizePixel = 0
		f.ZIndex = 99999
		f.Parent = cursorGui
		local len = math.sqrt(dx * dx + dy * dy)
		local ang = math.atan2(dy, dx)
		f.Size = UDim2.new(0, thick, 0, len)
		f.Rotation = math.deg(ang)
		table.insert(cursorFrames, f)
		return f
	end

	makeArm("TL", -armLen, -armLen)
	makeArm("BR", armLen, armLen)
	makeArm("TR", armLen, -armLen)
	makeArm("BL", -armLen, armLen)

	cursorTrackPos = Vector2.new(vp.X / 2, vp.Y / 2)
	cursorInited = true
end

local function updateCursorPos()
	if not cursorGui or not cursorGui.Parent then return end
	if not cursorInited then return end

	local delta = UserInputService:GetMouseDelta()
	local vp = workspace.CurrentCamera.ViewportSize
	if vp.X > 0 and vp.Y > 0 then
		cursorTrackPos = Vector2.new(
			math.clamp(cursorTrackPos.X + delta.X, 10, vp.X - 10),
			math.clamp(cursorTrackPos.Y + delta.Y, 10, vp.Y - 10)
		)
	end

	for _, f in ipairs(cursorFrames) do
		f.Position = UDim2.new(0, cursorTrackPos.X, 0, cursorTrackPos.Y)
	end
end

local function setCursorVisible(visible)
	for _, f in ipairs(cursorFrames) do
		f.Visible = visible
	end
end

local function destroyCursorGui()
	cursorInited = false
	if cursorGui and cursorGui.Parent then
		cursorGui:Destroy()
	end
	cursorGui = nil
	cursorFrames = {}
end

-- Mostrar/ocultar painel Solix (com fade-in ao abrir)
function showPanel(show)
	if panelVisible == show then
		if show and mainFrame and not mainFrame.Visible then
			mainFrame.Visible = true
		elseif not show and mainFrame then
			mainFrame.Visible = false
		end
		return
	end
	panelVisible = show
	hideAllInlineHints()
	hideAllBindHints()
	activeBindCapture = nil
	mainFrame.Visible = show and not menuIsMinimized

	if show then
		mainFrame.BackgroundTransparency = 1
		TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency = 0}):Play()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		pcall(function() LocalPlayer:GetMouse().Icon = "" end)
		pcall(function() LocalPlayer.DevEnableMouseLock = false end)
		initCursorGui()
		cursorTrackPos = UserInputService:GetMouseLocation()
		local vp = workspace.CurrentCamera.ViewportSize
		if vp.X > 0 and vp.Y > 0 then
			cursorTrackPos = Vector2.new(cursorTrackPos.X / vp.X, cursorTrackPos.Y / vp.Y)
		end
		if type(setCursorVisible) == "function" then pcall(setCursorVisible, true) end

		if _G._nightCursorForceLoop then
			pcall(function() RunService:UnbindFromRenderStep("NightCursorForce") end)
			if _G._nightCursorStepped then _G._nightCursorStepped:Disconnect() _G._nightCursorStepped = nil end
			if _G._nightCursorHeartbeat then _G._nightCursorHeartbeat:Disconnect() _G._nightCursorHeartbeat = nil end
			_G._nightCursorForceLoop = nil
		end
		_G._nightCursorForceLoop = true
		pcall(function()
			RunService:BindToRenderStep("NightCursorForce", Enum.RenderPriority.Last.Value + 1, function()
				if _G.nightMenuUnloaded then
					pcall(function() RunService:UnbindFromRenderStep("NightCursorForce") end)
					return
				end
				if not panelVisible then
					pcall(function() RunService:UnbindFromRenderStep("NightCursorForce") end)
					_G._nightCursorForceLoop = nil
					if type(setCursorVisible) == "function" then pcall(setCursorVisible, false) end
					return
				end
				UserInputService.MouseIconEnabled = true
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				pcall(function() LocalPlayer:GetMouse().Icon = "" end)
				if type(updateCursorPos) == "function" then updateCursorPos() end
			end)
		end)
		_G._nightCursorStepped = RunService.Stepped:Connect(function()
			if not panelVisible then
				if _G._nightCursorStepped then _G._nightCursorStepped:Disconnect() _G._nightCursorStepped = nil end
				return
			end
			UserInputService.MouseIconEnabled = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			pcall(function() LocalPlayer:GetMouse().Icon = "" end)
		end)
		_G._nightCursorHeartbeat = RunService.Heartbeat:Connect(function()
			if not panelVisible then
				if _G._nightCursorHeartbeat then _G._nightCursorHeartbeat:Disconnect() _G._nightCursorHeartbeat = nil end
				return
			end
			UserInputService.MouseIconEnabled = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			pcall(function() LocalPlayer:GetMouse().Icon = "" end)
		end)
	else
		if _G._nightCursorForceLoop then
			pcall(function() RunService:UnbindFromRenderStep("NightCursorForce") end)
			_G._nightCursorForceLoop = nil
		end
		if _G._nightCursorStepped then _G._nightCursorStepped:Disconnect() _G._nightCursorStepped = nil end
		if _G._nightCursorHeartbeat then _G._nightCursorHeartbeat:Disconnect() _G._nightCursorHeartbeat = nil end
		pcall(function() LocalPlayer.DevEnableMouseLock = true end)
		if type(setCursorVisible) == "function" then pcall(setCursorVisible, false) end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end

