			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local viewportSize = cam.ViewportSize
				local ray = cam:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)

				-- Mira prioriza players: chao/paredes nunca viram alvo
				local function getTargetPlayer()
					-- 1) raycast somente nos personagens (ignora chao e paredes)
					local chars = {}
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer and p.Character then
							table.insert(chars, p.Character)
						end
					end
					if #chars > 0 then
						local charParams = RaycastParams.new()
						charParams.FilterType = Enum.RaycastFilterType.Include
						charParams.FilterDescendantsInstances = chars
						charParams.IgnoreWater = true
						local charHit = workspace:Raycast(ray.Origin, ray.Direction * 2000, charParams)
						if charHit and charHit.Instance then
							local model = charHit.Instance:FindFirstAncestorOfClass("Model")
							local found = model and Players:GetPlayerFromCharacter(model)
							if found and found ~= LocalPlayer then return found end
						end
					end
					-- 2) fallback geometrico (funciona mesmo com CanCollide desligado)
					local best, bestAlong = nil, math.huge
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer then
							local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
							if root then
								local to = root.Position - ray.Origin
								local along = to:Dot(ray.Direction)
								if along > 0 and along < 2000 and along < bestAlong then
									local closest = ray.Origin + ray.Direction * along
									local off = (root.Position - closest).Magnitude
									local tolerance = math.clamp(2.5 + along * 0.02, 3, 9)
									if off <= tolerance then
										best, bestAlong = p, along
									end
								end
							end
						end
					end
					return best
				end

				local targetPlayer = getTargetPlayer()

				-- Raycast normal apenas como fallback de posicao do Teleport
				local groundParams = RaycastParams.new()
				groundParams.FilterType = Enum.RaycastFilterType.Exclude
				groundParams.FilterDescendantsInstances = {LocalPlayer.Character}
				groundParams.IgnoreWater = true
				local groundHit = workspace:Raycast(ray.Origin, ray.Direction * 2000, groundParams)

				local myChar = LocalPlayer.Character
				local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

				if currentFreecamAction == "Teleport" then
					if myRoot then
						local tpPos
						if targetPlayer then
							local targetRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
							if targetRoot then tpPos = (targetRoot.CFrame * CFrame.new(0, 0, 3)).Position end
						end
						if not tpPos and groundHit then tpPos = groundHit.Position end
						if not tpPos then tpPos = ray.Origin + ray.Direction * 50 end
						myRoot.Velocity = Vector3.zero
						myRoot.CFrame = CFrame.new(tpPos + Vector3.new(0, 3, 0))
						showMenuToast("Freecam", targetPlayer and ("Teleportado ate " .. targetPlayer.DisplayName) or "Teleportado", C.TxtWhite)
					end
				elseif currentFreecamAction == "Push" then
					local hitPart = targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					if hitPart then
						local hitModel = hitPart:FindFirstAncestorOfClass("Model")
						if hitModel then
							local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
							if hitPlayer and hitPlayer ~= LocalPlayer then
								local targetRoot = hitModel:FindFirstChild("HumanoidRootPart")
								if myRoot and targetRoot then
									local myChar = LocalPlayer.Character
									local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
									-- Save freecam state
									local savedCFrame = myRoot.CFrame
									local savedVel = myRoot.AssemblyLinearVelocity
									-- Restore physics for fling to work
									if myHum then myHum.WalkSpeed = 16 end
									myRoot.Anchored = false
									-- Teleport near target
									myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
									task.wait(0.15)
									-- Execute kick push (saves/restores internally)
									kickPushIsExecuting = false
									pcall(function()
										performKickPush(hitPlayer)
									end)
									-- Wait for fling + recovery
									task.wait(kickPushFlingTime + kickPushRecoveryDelay + 0.3)
									-- Restore freecam state
									if myHum then myHum.WalkSpeed = 0 end
									myRoot.CFrame = savedCFrame
									myRoot.AssemblyLinearVelocity = Vector3.zero
									showMenuToast("Freecam", "Empurrou " .. hitPlayer.DisplayName, C.TxtWhite)
									return
								end
							end
						end
					end
					showMenuToast("Freecam", "Aponte para um player para empurrar", Color3.fromRGB(255, 170, 70))
				elseif currentFreecamAction == "Spectate" then
					-- Toggle spectate off if already spectating
					if freecamSpectating then
						freecamSpectating = false
						workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
						workspace.CurrentCamera.CameraSubject = nil
						UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
						UserInputService.MouseIconEnabled = false
						showMenuToast("Freecam", "Spectate desligado", C.TxtWhite)
						return
					end
					-- Find player at crosshair
					local hitPart = targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					if hitPart then
						local hitModel = hitPart:FindFirstAncestorOfClass("Model")
						if hitModel then
							local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
							if hitPlayer and hitPlayer ~= LocalPlayer then
								local targetChar = hitPlayer.Character
								local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
								if targetHum then
									freecamSpectating = true
									workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
									workspace.CurrentCamera.CameraSubject = targetHum
									showMenuToast("Freecam", "Observando " .. hitPlayer.DisplayName .. " (clique de novo para parar)", C.TxtWhite)
									return
								end
							end
						end
					end
					showMenuToast("Freecam", "Aponte para um player para observar", Color3.fromRGB(255, 170, 70))
				end
			end
		end)

		-- Scroll wheel to cycle actions
		if _G._freecamScrollConn then _G._freecamScrollConn:Disconnect() end
		_G._freecamScrollConn = UserInputService.InputChanged:Connect(function(input)
			if not freecamEnabled then return end
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				if input.Position.Z > 0 then
