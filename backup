	if type(candidate) ~= "table" or candidate.aimbotFOV == nil then
		candidate = _ENV or _G
	end
	if type(candidate) ~= "table" or candidate.aimbotFOV == nil then
		candidate = _G
	end
	NM_GLOBAL_ENV = candidate
end

-- Le/escreve diretamente nas variaveis e tambem em ambos os environments.
function nmGetVar(key)
	local entry = NM_VARS[key]
	if entry and entry.get then
		local ok, val = pcall(entry.get)
		if ok and val ~= nil then return val end
	end
	local ok, value = pcall(function() return NM_GLOBAL_ENV[key] end)
	if ok and value ~= nil then return value end
	local ok2, value2 = pcall(function() return _G[key] end)
	if ok2 then return value2 end
	return nil
end

function nmSetVar(key, value)
	local entry = NM_VARS[key]
	if entry and entry.set then
		pcall(entry.set, value)
	end
	pcall(function() NM_GLOBAL_ENV[key] = value end)
	pcall(function()
		if _G[key] ~= value then _G[key] = value end
	end)
end

