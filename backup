function clickAction()
	local x, y = 0, 0
	if autoclickerMode == "Follow Cursor" then
		local mousePos = UserInputService:GetMouseLocation()
		x = mousePos.X
		y = mousePos.Y
	else
		x = tonumber(autoclickerFixedX) or 0
		y = tonumber(autoclickerFixedY) or 0
	end

	local buttonVal = 0 -- 0: Left, 1: Right, 2: Middle
	if autoclickerButton == "Right" then
		buttonVal = 1
	elseif autoclickerButton == "Middle" then
		buttonVal = 2
	end

	-- Executor-specific click simulation
	if buttonVal == 0 then
		if mouse1click then
			pcall(function() mouse1click() end)
		end
	elseif buttonVal == 1 then
		if mouse2click then
			pcall(function() mouse2click() end)
		end
	end

	-- VirtualInputManager clicking
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, buttonVal, true, game, 1)
		VirtualInputManager:SendMouseButtonEvent(x, y, buttonVal, false, game, 1)
	end)

	-- VirtualUser clicking fallback
	if typeof(VirtualUser) == "Instance" then
		pcall(function()
			if buttonVal == 0 then
				VirtualUser:Button1Down(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
				task.wait()
				VirtualUser:Button1Up(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
			elseif buttonVal == 1 then
				VirtualUser:Button2Down(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
				task.wait()
				VirtualUser:Button2Up(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
			end
		end)
	end
	
	-- Fast Hit Integration
	if fastHitEnabled and buttonVal == 0 then
		local character = LocalPlayer.Character
		if character then
			local tool = character:FindFirstChildOfClass("Tool")
			if tool then
				tool.Enabled = true
				pcall(function() tool:Activate() end)
				
				-- The Unequip/Equip trick to bypass internal tool cooldowns!
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					pcall(function()
						tool.Parent = LocalPlayer.Backpack
						tool.Parent = character
					end)
				end
			end
		end
	end
end

function startAutoclickerLoop()
	task.spawn(function()
		while autoclickerEnabled do
			pcall(clickAction)
			local delaySec = (tonumber(autoclickerInterval) or 100) / 1000
			if delaySec <= 0 then
				RunService.Heartbeat:Wait()
			else
				task.wait(delaySec)
			end
		end
	end)
end

function fastHitAction()
	local character = LocalPlayer.Character
	if not character then return end

	-- Force unlock cooldown on all tools
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			child.Enabled = true
			pcall(function() child.ManualActivationOnly = false end)
			pcall(function() child.RequiresHandle = false end)
		end
	end

	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") then
				child.Enabled = true
				pcall(function() child.ManualActivationOnly = false end)
				pcall(function() child.RequiresHandle = false end)
			end
		end
	end

	-- Also scan for any ClickDetector / ProximityPrompt cooldowns
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("ClickDetector") then
			pcall(function() desc.MaxActivationDistance = 999 end)
		end
	end
end

function startFastHitLoop()
	task.spawn(function()
		while fastHitEnabled do
			pcall(fastHitAction)
			local delaySec = (tonumber(fastHitInterval) or 50) / 1000
			if delaySec <= 0 then
				RunService.Heartbeat:Wait()
			else
				task.wait(delaySec)
			end
		end
	end)
end

function attackTargetWithTool(tool, myRoot, targetRoot, attackStage)
	if not tool or not myRoot or not targetRoot then return end

	equipTool(tool)
	extendToolRange(tool, 45)

	local offsets = {
		CFrame.new(0, 0, 1.1),
		CFrame.new(0, 0.15, 0.55),
		CFrame.new(0.9, 0, 0.9),
		CFrame.new(-0.9, 0, 0.9),
		CFrame.new(0, 0, 4.5),
		CFrame.new(0, 0, 7)
	}

	local attackIndex = ((attackStage or 0) % #offsets) + 1
	local baseCFrame = CFrame.lookAt(targetRoot.Position, myRoot.Position)
	myRoot.CFrame = baseCFrame * offsets[attackIndex]
	myRoot.AssemblyLinearVelocity = Vector3.zero

	for _ = 1, 3 do
		triggerDamageTool(tool)
		task.wait(0.015)
	end
end

function stopKilling()
	if killConnection then
		killConnection:Disconnect()
		killConnection = nil
	end
	killingPlayer = false
	killTargetPlayer = nil
	killCycleState = 0
	killCycleTimer = 0
end

function killPlayer(targetPlayer)
	if not targetPlayer or targetPlayer == LocalPlayer then return end
	if isMenuFriend and isMenuFriend(targetPlayer) then return end
	if not targetPlayer.Character then return end
	
	local character = LocalPlayer.Character
	if not character then return end
	
	local myRoot = character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	
	local weapon = equipTool(findWeaponOrKnife())
	
	if weapon and killRangeEnabled then
		extendToolRange(weapon, 35)
	end
	
	stopKilling()
	
	killingPlayer = true
	killTargetPlayer = targetPlayer
	killCycleState = 0
	killCycleTimer = 0
	local killAttackStage = 0
	
	killConnection = RunService.Heartbeat:Connect(function(dt)
		if not killingPlayer or not killTargetPlayer then
			stopKilling()
			return
		end
		
		local char = LocalPlayer.Character
		local tChar = killTargetPlayer.Character
		
		if not char or not tChar then
			stopKilling()
			return
		end
		
		local root = char:FindFirstChild("HumanoidRootPart")
		local tRoot = tChar:FindFirstChild("HumanoidRootPart")
		local tHum = tChar:FindFirstChildOfClass("Humanoid")
		
		if not root or not tRoot or not tHum or tHum.Health <= 0 then
			stopKilling()
			return
		end
		
		killCycleTimer = killCycleTimer + dt
		
		if killCycleState == 0 then
			local wpn = findWeaponOrKnife()
			if wpn then
				attackTargetWithTool(wpn, root, tRoot, killAttackStage)
				killAttackStage = killAttackStage + 1
			else
				local targetPos = tRoot.Position
				root.CFrame = CFrame.new(targetPos) * CFrame.new(0, 0, 2)
				root.AssemblyLinearVelocity = Vector3.zero
			end
			
			if killCycleTimer >= 0.55 then
				killCycleState = 1
				killCycleTimer = 0
			end
		else
			root.CFrame = CFrame.new(tRoot.Position.X, -600, tRoot.Position.Z)
			root.AssemblyLinearVelocity = Vector3.zero
			
			if killCycleTimer >= 0.25 then
				killCycleState = 0
				killCycleTimer = 0
			end
		end
	end)
end

