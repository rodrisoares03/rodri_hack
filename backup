function soloDimMakeFakeVisible(fake)
	if not fake then return end
	for _, desc in ipairs(fake:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.LocalTransparencyModifier = 0
			if desc.Name ~= "HumanoidRootPart" then
				desc.Transparency = 0
			end
			desc.CanCollide = false
			desc.Anchored = true
		elseif desc:IsA("ForceField") then
			desc:Destroy()
		end
	end
	local hum = fake:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
end

function soloDimEnable()
	if soloDimensionEnabled then return true end
	local failMsg = nil
	local ok, err = pcall(function()
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not char or not root or not hum then
			failMsg = "Personagem invalido"
			return false
		end

		if soloDimFakeChar then
			pcall(function() soloDimFakeChar:Destroy() end)
			soloDimFakeChar = nil
		end

		local cam = workspace.CurrentCamera
		soloDimOldCamSubject = cam and cam.CameraSubject
		soloDimOldCamType = cam and cam.CameraType

		local fake = nil
		pcall(function()
			local oldArchivable = char.Archivable
			char.Archivable = true
			fake = char:Clone()
			char.Archivable = oldArchivable
		end)
		local fakeRoot, fakeHum
		if fake and typeof(fake) == "Instance" then
			pcall(function()
				fake.Name = (char.Name or "SoloDim") .. "_SoloDim"
				for _, desc in ipairs(fake:GetDescendants()) do
					if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
						desc:Destroy()
					end
				end
				fake.Parent = workspace
			end)
			fakeRoot = fake:FindFirstChild("HumanoidRootPart")
			fakeHum = fake:FindFirstChildOfClass("Humanoid")
			if fakeRoot then
				soloDimMakeFakeVisible(fake)
			end
		end

		if not fake or not fakeRoot then
			if fake then pcall(function() fake:Destroy() end) end
			fake = Instance.new("Model")
			fake.Name = "SoloDimProxy"
			fakeRoot = Instance.new("Part")
			fakeRoot.Name = "HumanoidRootPart"
			fakeRoot.Size = Vector3.new(2, 2, 1)
			fakeRoot.Transparency = 1
			fakeRoot.Anchored = true
			fakeRoot.CanCollide = false
			fakeRoot.CFrame = root.CFrame
			fakeRoot.Parent = fake
			local head = Instance.new("Part")
			head.Name = "Head"
			head.Size = Vector3.new(1.2, 1.2, 1.2)
			head.Transparency = 1
			head.Anchored = true
			head.CanCollide = false
			head.CFrame = root.CFrame * CFrame.new(0, 1.5, 0)
			head.Parent = fake
			fakeHum = Instance.new("Humanoid")
			fakeHum.Parent = fake
			fake.Parent = workspace
		end

		if fakeRoot then
			fakeRoot.Anchored = true
			fakeRoot.CFrame = root.CFrame
			fakeRoot.CanCollide = false
		end
			if fakeHum then
				pcall(function()
					fakeHum.WalkSpeed = 16
					fakeHum.AutoRotate = false
					fakeHum.PlatformStand = false
					fakeHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
					fakeHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
				end)
				soloDimSetupAnimations(fakeHum)
			end
		soloDimFakeChar = fake

		soloDimStoredOffset = Vector3.new(0, 100000, 0)
		soloDimSetAnchored(char, true)
		soloDimShiftAssembly(char, soloDimStoredOffset)
		soloDimLastRealCF = root.CFrame

		if cam then
			pcall(function()
				cam.CameraType = Enum.CameraType.Custom
				cam.CameraSubject = fakeHum or fakeRoot
			end)
		end

			soloDimensionEnabled = true
			soloDimBindBodyAnimation()

		if soloDimLoopConn then
			soloDimLoopConn:Disconnect()
			soloDimLoopConn = nil
		end
		soloDimLoopConn = RunService.RenderStepped:Connect(function(dt)
			if not soloDimensionEnabled then return end
			local cam2 = workspace.CurrentCamera
			local charNow = LocalPlayer.Character
			local realRoot = charNow and charNow:FindFirstChild("HumanoidRootPart")
			-- Personagem foi recriado (respawn): para a ponte e espera o handler desativar
			if not hum or not hum.Parent then return end
			if cam2 then
				pcall(function()
					if fakeHum and fakeHum.Parent then
						cam2.CameraSubject = fakeHum
					elseif fakeRoot and fakeRoot.Parent then
						cam2.CameraType = Enum.CameraType.Scriptable
						cam2.CFrame = CFrame.new(fakeRoot.Position + Vector3.new(0, 5, 10), fakeRoot.Position)
					end
				end)
			end

			-- Ponte de movimentação: espelha no corpo visível qualquer Fly/TP/Boost aplicado no corpo real
			if realRoot and fakeRoot and fakeRoot.Parent then
				local realNowCF = realRoot.CFrame
				local realDelta = realNowCF.Position - soloDimLastRealCF.Position
				if math.abs(realNowCF.Position.Y) < 40000 then
					-- Escrita absoluta (TP Waypoint/Cursor/steal): corpo real foi movido para coordenadas do mapa
					soloDimMoveFake(fake, CFrame.new(realNowCF.Position) * soloDimRotationOnly(realNowCF))
				elseif realDelta.Magnitude > 0.001 then
					-- Escrita relativa (Fly/Boost/Kidnap): corpo real continua escondido no offset, espelha o deslocamento
					soloDimMoveFake(fake, CFrame.new(fakeRoot.Position + realDelta) * soloDimRotationOnly(realNowCF))
				end

				-- Caminhada manual do corpo visível
					if hum and hum.Parent and hum.MoveDirection and hum.MoveDirection.Magnitude > 0.05 then
						local walkSpeed = (hum.WalkSpeed and hum.WalkSpeed > 0 and hum.WalkSpeed) or 16
						local moveDir = hum.MoveDirection
						local currentCF = fakeRoot.CFrame
						local targetLook = currentCF.Position + moveDir
						local targetCF = CFrame.lookAt(currentCF.Position, targetLook)
						local newCF = currentCF:Lerp(targetCF, 15 * (dt or 0.016))
						newCF = newCF + moveDir * walkSpeed * (dt or 0.016)
						soloDimMoveFake(fake, newCF)
					end

					-- Física vertical do corpo visível: aplica gravidade e corrige a altura no chão.
					local step = math.clamp(dt or 0.016, 0, 0.1)
					local isFlying = (FlySystem and FlySystem.flying) or freeflyOn
					local isGrounded = true
					
					if not isFlying then
						local rayParams = RaycastParams.new()
						rayParams.FilterType = Enum.RaycastFilterType.Exclude
						rayParams.FilterDescendantsInstances = {fake, charNow}
						local groundHit = workspace:Raycast(fakeRoot.Position, Vector3.new(0, -6, 0), rayParams)
						local groundY = groundHit and (groundHit.Position.Y + 3)
						isGrounded = groundY and fakeRoot.Position.Y <= groundY + 0.12 and soloDimVerticalVelocity <= 0
						if not isGrounded or soloDimVerticalVelocity > 0 then
							soloDimVerticalVelocity = soloDimVerticalVelocity - workspace.Gravity * step
							soloDimMoveFake(fake, fakeRoot.CFrame + Vector3.new(0, soloDimVerticalVelocity * step, 0))
							fakeRoot = fake:FindFirstChild("HumanoidRootPart") or fakeRoot
							if groundY and fakeRoot.Position.Y <= groundY then
								soloDimMoveFake(fake, CFrame.new(fakeRoot.Position.X, groundY, fakeRoot.Position.Z) * soloDimRotationOnly(fakeRoot.CFrame))
								soloDimVerticalVelocity = 0
								isGrounded = true
							end
						end
					else
						soloDimVerticalVelocity = 0
						isGrounded = false
					end
					
					soloDimGrounded = isGrounded and true or false
					soloDimBodyMoving = hum.MoveDirection.Magnitude > 0.05 or realDelta.Magnitude > 0.01
					soloDimBodyAirborne = not soloDimGrounded
					if soloDimWalkTrack and hum.MoveDirection.Magnitude > 0.05 and soloDimGrounded then
						if not soloDimWalkTrack.IsPlaying then soloDimWalkTrack:Play(0.12) end
					elseif soloDimWalkTrack and soloDimWalkTrack.IsPlaying then
						soloDimWalkTrack:Stop(0.12)
					end
					if soloDimIdleTrack and soloDimGrounded and hum.MoveDirection.Magnitude <= 0.05 and not soloDimIdleTrack.IsPlaying then
						soloDimIdleTrack:Play(0.12)
					end
					-- soloDimAnimateBody has been removed because it overrides the real Animator tracks

					-- Trava o corpo real escondido atrás do corpo visível, preservando a rotação escolhida pelo sistema
				pcall(function()
					realRoot.CFrame = CFrame.new(fakeRoot.Position + soloDimStoredOffset) * soloDimRotationOnly(realNowCF)
					realRoot.AssemblyLinearVelocity = Vector3.zero
					realRoot.AssemblyAngularVelocity = Vector3.zero
				end)
				soloDimLastRealCF = realRoot.CFrame
			end
			end)

					soloDimJumpRequestConn = UserInputService.JumpRequest:Connect(function()
					if not soloDimensionEnabled or not soloDimFakeChar then return end
					local isFlying = (FlySystem and FlySystem.flying) or freeflyOn
					if isFlying then return end
					if soloDimGrounded or infiniteJumpEnabled then
						soloDimVerticalVelocity = 52
						soloDimGrounded = false
						if soloDimIdleTrack and soloDimIdleTrack.IsPlaying then soloDimIdleTrack:Stop(0.05) end
						if soloDimWalkTrack and soloDimWalkTrack.IsPlaying then soloDimWalkTrack:Stop(0.05) end
						if soloDimJumpTrack then soloDimJumpTrack:Play(0.05) end
					end
				end)
		end)

		if not ok and not failMsg then
			failMsg = tostring(err)
	end

	if soloDimensionEnabled then
		pcall(function() soloDimShowBanner(true) end)
		return true
	end
	if failMsg and showMenuToast then
		showMenuToast("Dimensão Solo", failMsg, Color3.fromRGB(255, 100, 100))
	end
	return false
end
_G._soloDimEnable = soloDimEnable

function soloDimDisable()
	if not soloDimensionEnabled then return end
	pcall(function()
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")

		if root and soloDimFakeChar then
			local fakeRoot = soloDimFakeChar:FindFirstChild("HumanoidRootPart")
			if fakeRoot then
				local delta = fakeRoot.Position - root.Position
				soloDimShiftAssembly(char, delta)
			else
				soloDimShiftAssembly(char, -soloDimStoredOffset)
			end
		elseif root then
			soloDimShiftAssembly(char, -soloDimStoredOffset)
		end

		if char then soloDimSetAnchored(char, false) end
	end)

	pcall(function()			if soloDimLoopConn then
				soloDimLoopConn:Disconnect()
				soloDimLoopConn = nil
			end
				if soloDimJumpRequestConn then
					soloDimJumpRequestConn:Disconnect()
					soloDimJumpRequestConn = nil
				end
				soloDimUnbindBodyAnimation()
				soloDimStopAnimations()
			soloDimVerticalVelocity = 0
			soloDimGrounded = true
			if soloDimFakeChar then
			soloDimFakeChar:Destroy()
			soloDimFakeChar = nil
		end
	end)

	pcall(function()
		local cam = workspace.CurrentCamera
		if soloDimOldCamType then
			cam.CameraType = soloDimOldCamType
		end
		local restoreSubject = soloDimOldCamSubject
		if not restoreSubject or not restoreSubject.Parent then
			local curHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			restoreSubject = curHum
		end
		if restoreSubject then
			cam.CameraSubject = restoreSubject
		end
		soloDimOldCamType = nil
		soloDimOldCamSubject = nil
	end)

	soloDimensionEnabled = false
	pcall(function() soloDimShowBanner(false) end)
end
_G._soloDimDisable = soloDimDisable

