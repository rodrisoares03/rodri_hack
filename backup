	pcall(function()
		spawnMultiWaypointPortal(position)
	end)

	-- Explosao roxa no jogador ao sair do portal
	pcall(function()
		local character = LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local burstPart = Instance.new("Part")
		burstPart.Name = "PortalArrivalBurst"
		burstPart.Anchored = true
		burstPart.CanCollide = false
		burstPart.CanTouch = false
		burstPart.CanQuery = false
		burstPart.Transparency = 1
		burstPart.Size = Vector3.new(0.2, 0.2, 0.2)
		burstPart.CFrame = root.CFrame
		burstPart.Parent = workspace

		local burst = Instance.new("ParticleEmitter")
		burst.Color = ColorSequence.new(Color3.fromRGB(185, 110, 255), Color3.fromRGB(90, 30, 180))
		burst.LightEmission = 1
		burst.Enabled = false
		burst.Lifetime = NumberRange.new(0.4, 0.9)
		burst.Speed = NumberRange.new(10, 22)
		burst.SpreadAngle = Vector2.new(180, 180)
