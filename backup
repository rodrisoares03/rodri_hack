function nmFindColorIndex(colors, target)
	if typeof(target) ~= "Color3" or type(colors) ~= "table" then return nil end
	for i, col in ipairs(colors) do
		if typeof(col) == "Color3" then
			if math.abs(col.R - target.R) < 0.02 and math.abs(col.G - target.G) < 0.02 and math.abs(col.B - target.B) < 0.02 then
				return i
			end
		end
	end
	return nil
end

