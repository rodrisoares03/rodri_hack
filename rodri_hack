function saveCurrentWaypoint()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return false end

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {character}
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist

	local rayResult = workspace:Raycast(root.Position, Vector3.new(0, -300, 0), rayParams)
	if rayResult then
		waypointPosition = rayResult.Position
	else
		waypointPosition = root.Position - Vector3.new(0, 3, 0)
	end

	createWaypointMarker(waypointPosition)
	return true
end

function teleportToWaypoint()
	if not waypointPosition then return false end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return false end

	root.CFrame = CFrame.new(waypointPosition + Vector3.new(0, 4, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

function clearWaypoint()
	waypointPosition = nil
	clearWaypointMarker()
end

function getPromptPart(prompt)
	local promptParent = prompt and prompt.Parent
	return promptParent and (promptParent:IsA("BasePart") and promptParent or promptParent:FindFirstAncestorWhichIsA("BasePart"))
end

function getPromptDistance(prompt)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local promptPart = getPromptPart(prompt)
	if not root or not promptPart then
		return math.huge
	end

	return (promptPart.Position - root.Position).Magnitude
end

function nudgeToPromptForSteal(prompt)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local promptPart = getPromptPart(prompt)
	if not root or not promptPart then
		return false
	end

	local targetPos = promptPart.Position + Vector3.new(0, 2.5, 0)
	root.CFrame = CFrame.new(targetPos)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
