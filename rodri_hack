function getNPCsFromWorkspace()
	local npcs = {}
	local myChar = LocalPlayer.Character
	local myRoot = myChar and getPrimaryPart(myChar)
	local camera = workspace.CurrentCamera

	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model") and model ~= myChar then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = getPrimaryPart(model)
			if humanoid and root and root:IsA("BasePart") and humanoid.Health > 0 then
				local isPlayer = Players:GetPlayerFromCharacter(model)
				if not isPlayer then
					if myRoot then
						local dist = (root.Position - myRoot.Position).Magnitude
						if dist <= ESP_MAX_DISTANCE then
							if camera then
								local _, onScreen = camera:WorldToViewportPoint(root.Position)
								if onScreen then
									table.insert(npcs, {model = model, humanoid = humanoid, root = root, distance = dist})
								end
							end
						end
					end
				end
			end
		end
	end
	return npcs
end

function ensureNpcHighlight(model)
	if not model or not model.Parent then
		if npcHighlights[model] then
