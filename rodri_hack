-- ========= CUSTOM X CURSOR (ScreenGui - immune to game) =========
local cursorGui = nil
local cursorFrames = {}
local cursorTrackPos = Vector2.new(0.5, 0.5)
local cursorInited = false

local function initCursorGui()
	if cursorGui and cursorGui.Parent then return end
	cursorGui = Instance.new("ScreenGui")
	cursorGui.Name = "NightCursorX"
	cursorGui.IgnoreGuiInset = true
	cursorGui.DisplayOrder = 99999
	cursorGui.ResetOnSpawn = false
	cursorGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	cursorGui.Parent = game:GetService("CoreGui")

	local armLen = 20
	local gap = 3
	local thick = 2
	local col = Color3.fromRGB(255, 255, 255)
	local vp = workspace.CurrentCamera.ViewportSize

	local function makeArm(name, dx, dy)
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundColor3 = col
		f.BorderSizePixel = 0
		f.ZIndex = 99999
		f.Parent = cursorGui
		local len = math.sqrt(dx * dx + dy * dy)
		local ang = math.atan2(dy, dx)
		f.Size = UDim2.new(0, thick, 0, len)
		f.Rotation = math.deg(ang)
		table.insert(cursorFrames, f)
		return f
	end

	makeArm("TL", -armLen, -armLen)
	makeArm("BR", armLen, armLen)
	makeArm("TR", armLen, -armLen)
	makeArm("BL", -armLen, armLen)

	cursorTrackPos = Vector2.new(vp.X / 2, vp.Y / 2)
	cursorInited = true
end

local function updateCursorPos()
	if not cursorGui or not cursorGui.Parent then return end
	if not cursorInited then return end

	local delta = UserInputService:GetMouseDelta()
	local vp = workspace.CurrentCamera.ViewportSize
	if vp.X > 0 and vp.Y > 0 then
		cursorTrackPos = Vector2.new(
			math.clamp(cursorTrackPos.X + delta.X, 10, vp.X - 10),
			math.clamp(cursorTrackPos.Y + delta.Y, 10, vp.Y - 10)
		)
	end

	for _, f in ipairs(cursorFrames) do
		f.Position = UDim2.new(0, cursorTrackPos.X, 0, cursorTrackPos.Y)
	end
end

local function setCursorVisible(visible)
	for _, f in ipairs(cursorFrames) do
		f.Visible = visible
	end
end

local function destroyCursorGui()
	cursorInited = false
	if cursorGui and cursorGui.Parent then
		cursorGui:Destroy()
	end
	cursorGui = nil
	cursorFrames = {}
end

