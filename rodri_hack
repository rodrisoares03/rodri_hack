function importConfig(configName)
	local rawText = configCodeBox and configCodeBox.Text or ""
	if rawText == "" then
		setConfigStatus("paste Lua text first", Color3.fromRGB(255, 120, 120))
		return false
	end

	local loader = loadstring or load
	if not loader then
		setConfigStatus("loadstring unavailable", Color3.fromRGB(255, 120, 120))
		return false
	end

	local chunkSuccess, chunkOrErr = pcall(function()
		return loader(rawText)
	end)
	if not chunkSuccess or not chunkOrErr then
		setConfigStatus("invalid import text", Color3.fromRGB(255, 120, 120))
		return false
	end

	local runSuccess, payload = pcall(chunkOrErr)
	if not runSuccess or type(payload) ~= "table" then
		setConfigStatus("invalid imported config", Color3.fromRGB(255, 120, 120))
		return false
	end

	local importedConfig = payload.data or payload
	if type(importedConfig) ~= "table" then
		setConfigStatus("import has no config data", Color3.fromRGB(255, 120, 120))
		return false
	end

	local cleanName = sanitizeConfigName(configName or (configNameInput and configNameInput.Text) or payload.name or selectedConfigName)
	if not cleanName then
		setConfigStatus("insert a config name first", Color3.fromRGB(255, 120, 120))
		return false
	end

	local libraryData, err = readConfigLibrary()
	if type(libraryData) ~= "table" then
		setConfigStatus(err or "unable to open config list", Color3.fromRGB(255, 120, 120))
		return false
	end

	if libraryData.configs[cleanName] and pendingImportName ~= cleanName then
		pendingImportName = cleanName
		setConfigStatus("name exists, click Import again to overwrite", Color3.fromRGB(255, 210, 120))
		showMenuToast("Import Warning", cleanName .. " already exists", Color3.fromRGB(255, 210, 120))
		return false
	end

	pendingImportName = nil
	importedConfig.createdAt = importedConfig.createdAt or makeConfigTimestamp()
	importedConfig.lastUsed = importedConfig.lastUsed or "--"
	libraryData.configs[cleanName] = importedConfig
	libraryData.lastSelected = cleanName

	local success, saveErr = writeConfigLibrary(libraryData)
	if not success then
		setConfigStatus("import failed: " .. tostring(saveErr), Color3.fromRGB(255, 120, 120))
		return false
	end

	selectConfigName(cleanName)
	refreshConfigList()
	setConfigStatus("config imported: " .. cleanName, Color3.fromRGB(170, 255, 170))
	showMenuToast("Config Imported", cleanName, Color3.fromRGB(170, 255, 170))
	return true
end

function renameConfig(newName)
	if not selectedConfigName then
		setConfigStatus("select a config to rename", Color3.fromRGB(255, 120, 120))
		return false
	end

	local cleanName = sanitizeConfigName(newName or (configNameInput and configNameInput.Text))
	if not cleanName then
		setConfigStatus("insert a new config name", Color3.fromRGB(255, 120, 120))
		return false
	end

	local libraryData, err = readConfigLibrary()
	if type(libraryData) ~= "table" then
		setConfigStatus(err or "unable to read config list", Color3.fromRGB(255, 120, 120))
		return false
	end

	local oldData = libraryData.configs and libraryData.configs[selectedConfigName]
	if type(oldData) ~= "table" then
		setConfigStatus("selected config no longer exists", Color3.fromRGB(255, 120, 120))
		return false
	end

	if cleanName ~= selectedConfigName and libraryData.configs[cleanName] and pendingRenameName ~= cleanName then
		pendingRenameName = cleanName
		setConfigStatus("name exists, click Rename again to overwrite", Color3.fromRGB(255, 210, 120))
		showMenuToast("Rename Warning", cleanName .. " already exists", Color3.fromRGB(255, 210, 120))
		return false
	end

	pendingRenameName = nil
	libraryData.configs[selectedConfigName] = nil
	oldData.createdAt = oldData.createdAt or makeConfigTimestamp()
	oldData.lastUsed = oldData.lastUsed or "--"
	libraryData.configs[cleanName] = oldData
	libraryData.lastSelected = cleanName

	local success, saveErr = writeConfigLibrary(libraryData)
	if not success then
		setConfigStatus("rename failed: " .. tostring(saveErr), Color3.fromRGB(255, 120, 120))
		return false
	end

	selectConfigName(cleanName)
	refreshConfigList()
	setConfigStatus("config renamed: " .. cleanName, Color3.fromRGB(170, 255, 170))
	showMenuToast("Config Renamed", cleanName, Color3.fromRGB(170, 255, 170))
	return true
end

-- Continuous aiming
RunService.RenderStepped:Connect(function()
	-- NPC Aimbot
	if npcAimbotEnabled then
		if tick() - lastNpcTargetUpdateTime >= 0.15 then
			currentNpcAimbotTarget = getClosestNPC()
			lastNpcTargetUpdateTime = tick()
		end
		if currentNpcAimbotTarget and npcAimbotKeyHeld then
			aimAtNPC(currentNpcAimbotTarget)
		end
	else
		currentNpcAimbotTarget = nil
	end

	if aimbotEnabled then
		-- Sempre procurar alvo se o Aimbot estiver ligado (para o Autofire usar)
		if tick() - lastTargetUpdateTime >= 0.15 then
			currentAimbotTarget = getClosestPlayer()
			lastTargetUpdateTime = tick()
		end
		
		-- SÃƒÂ³ trava a mira na tela se a tecla estiver segurada ou em veÃƒÂ­culo
		if currentAimbotTarget and (aimbotKeyHeld or isInMovingVehicle()) then
			aimAt(currentAimbotTarget)
		end
	else
		currentAimbotTarget = nil
	end
	
	-- ESP with automatic cleanup
	if espEnabled then
		local validChars = {}
		for _, player in ipairs(Players:GetPlayers()) do
			local data = syncPlayerCharacter(player)
			if player ~= LocalPlayer and isEnemy(player) then
				local character = data and data.character or player.Character
				if character then
					local humanoid = data and data.humanoid or character:FindFirstChildOfClass("Humanoid")
					local root = data and data.root or character:FindFirstChild("HumanoidRootPart")
					if humanoid and root and humanoid.Health > 0 then
						validChars[character] = true
						pcall(function()
							if showSkeleton then ensureHighlight(character) end
							if showBox3D then ensureBox3D(character) end
							if showTracers then ensureTracer(character) end
							if showEspDistance then ensureDistanceLabel(character) end
							if showName then ensureNameLabel(character, player) end
							if showHealth then ensureHealthBar(character) end
						end)
					end
				end
			end
		end
		for char, _ in pairs(highlights) do
			if not validChars[char] then
				pcall(function() highlights[char]:Destroy() end)
				highlights[char] = nil
			end
		end
		for char, _ in pairs(boxes) do
			if not validChars[char] then
				pcall(function() boxes[char]:Remove() end)
				boxes[char] = nil
			end
		end
		for char, _ in pairs(nameLabels) do
			if not validChars[char] then
				pcall(function() nameLabels[char]:Remove() end)
				nameLabels[char] = nil
			end
		end
		for char, _ in pairs(distanceLabels) do
			if not validChars[char] then
				pcall(function() distanceLabels[char]:Remove() end)
				distanceLabels[char] = nil
			end
		end
		for char, _ in pairs(tracers) do
			if not validChars[char] then
				pcall(function() tracers[char]:Remove() end)
				tracers[char] = nil
			end
		end
		for char, bar in pairs(healthBars) do
			if not validChars[char] then
				pcall(function()
					if bar.bg then bar.bg:Remove() end
					if bar.fill then bar.fill:Remove() end
				end)
				healthBars[char] = nil
			end
		end
		else
		clearAllESPVisuals()
	end

	-- NPC ESP (throttled scan) — also scan when aimbot needs targets
	if npcEspEnabled or npcAimbotEnabled then
		local now = tick()
		if now - npcEspLastScanTime >= npcEspScanInterval then
			npcEspLastScanTime = now
			npcEspCachedModels = getNPCsFromWorkspace()
		end
		local validNpcs = {}
		for _, npcInfo in ipairs(npcEspCachedModels) do
			local model = npcInfo.model
			if model and model.Parent and npcInfo.humanoid and npcInfo.humanoid.Health > 0 then
				validNpcs[model] = true
				pcall(function()
					if npcShowSkeleton then ensureNpcHighlight(model) end
					if npcShowBox then ensureNpcHighlight(model) end
					if npcShowBox then ensureNpcBox3D(model) end
					if npcShowTracers then ensureNpcTracer(model) end
					if npcShowDistance then ensureNpcDistanceLabel(model) end
					if npcShowName then ensureNpcNameLabel(model) end
					if npcShowHealth then ensureNpcHealthBar(model) end
				end)
			end
		end
		-- Cleanup orphaned NPC ESP
		for m, _ in pairs(npcHighlights) do
			if not validNpcs[m] then
				pcall(function() npcHighlights[m]:Destroy() end)
				npcHighlights[m] = nil
			end
		end
		for m, _ in pairs(npcBoxes) do
			if not validNpcs[m] then
				pcall(function() npcBoxes[m]:Destroy() end)
				npcBoxes[m] = nil
			end
		end
		for m, _ in pairs(npcNameLabels) do
			if not validNpcs[m] then
				pcall(function() npcNameLabels[m]:Remove() end)
				npcNameLabels[m] = nil
			end
		end
		for m, _ in pairs(npcDistanceLabels) do
			if not validNpcs[m] then
				pcall(function() npcDistanceLabels[m]:Remove() end)
				npcDistanceLabels[m] = nil
			end
		end
		if npcTracers then
			for m, _ in pairs(npcTracers) do
				if not validNpcs[m] then
					pcall(function() npcTracers[m]:Remove() end)
					npcTracers[m] = nil
				end
			end
		end
		for m, bar in pairs(npcHealthBars) do
			if not validNpcs[m] then
				pcall(function()
					if bar.bg then bar.bg:Remove() end
					if bar.fill then bar.fill:Remove() end
				end)
				npcHealthBars[m] = nil
			end
		end
	else
		clearAllNpcESP()
		npcEspCachedModels = {}
	end
end)

