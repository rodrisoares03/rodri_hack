end

function applyFastStealPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not isStealPrompt(prompt) then
		return
	end

	if fastStealPromptRestore[prompt] == nil then
		fastStealPromptRestore[prompt] = prompt.HoldDuration
	end
	local originalHold = fastStealPromptRestore[prompt] or 0.5
	-- Slight speed-up while staying on a safer profile.
	prompt.HoldDuration = math.clamp(originalHold * 0.85, 0.3, 2.0)
end

function restoreFastStealPrompts()
	for prompt, holdDuration in pairs(fastStealPromptRestore) do
		if prompt and prompt.Parent then
			pcall(function()
				prompt.HoldDuration = holdDuration
			end)
		end
		fastStealPromptRestore[prompt] = nil
	end
end

function setFastStealEnabled(enabled)
	fastStealEnabled = enabled and true or false

	if fastStealPromptConnection then
		fastStealPromptConnection:Disconnect()
		fastStealPromptConnection = nil
	end

	if not fastStealEnabled then
		restoreFastStealPrompts()
		fastStealLastUseAt = 0
		fastStealLastPrompt = nil
		fastStealPerPromptUseAt = {}
		return
	end

	for _, descendant in ipairs(workspace:GetDescendants()) do
		applyFastStealPrompt(descendant)
	end

	fastStealPromptConnection = workspace.DescendantAdded:Connect(function(descendant)
		applyFastStealPrompt(descendant)
	end)
end

function applyStealDistancePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not isStealPrompt(prompt) then
		return
	end

	if stealDistancePromptRestore[prompt] == nil then
		stealDistancePromptRestore[prompt] = prompt.MaxActivationDistance
	end

	local baseDistance = tonumber(prompt.MaxActivationDistance) or 10
	local desired = math.clamp(tonumber(stealDistanceValue) or 22, 8, 500)
	if desired > baseDistance then
		prompt.MaxActivationDistance = desired
	end
end

function restoreStealDistancePrompts()
	for prompt, maxDistance in pairs(stealDistancePromptRestore) do
		if prompt and prompt.Parent then
			pcall(function()
				prompt.MaxActivationDistance = maxDistance
			end)
		end
		stealDistancePromptRestore[prompt] = nil
	end
end

function setStealDistanceEnabled(enabled)
	stealDistanceEnabled = enabled and true or false

	if stealDistancePromptConnection then
		stealDistancePromptConnection:Disconnect()
		stealDistancePromptConnection = nil
	end

	if not stealDistanceEnabled then
		restoreStealDistancePrompts()
		return
	end

	task.spawn(function()
		local count = 0
		for _, descendant in ipairs(workspace:GetDescendants()) do
			applyStealDistancePrompt(descendant)
			count = count + 1
			if count % 280 == 0 then
				task.wait()
			end
		end
	end)

	stealDistancePromptConnection = workspace.DescendantAdded:Connect(function(descendant)
		applyStealDistancePrompt(descendant)
	end)
end

function setStealDistanceValue(newValue)
	local parsed = tonumber(newValue)
	if not parsed then
		return false
	end
	parsed = math.clamp(math.floor(parsed), 8, 500)
	stealDistanceValue = parsed
	if stealDistanceEnabled then
		task.spawn(function()
			local count = 0
			for _, descendant in ipairs(workspace:GetDescendants()) do
				applyStealDistancePrompt(descendant)
				count = count + 1
				if count % 280 == 0 then
					task.wait()
				end
			end
		end)
	end
	return true
end

