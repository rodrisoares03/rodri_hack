local freecamGui = nil
local freecamRightHeld = false -- deprecated, kept for compat
local freecamYaw = 0
local freecamPitch = 0
local freecamSpectating = false

local function disableFreecam()
	freecamEnabled = false
	freecamSpectating = false
	if _G._freecamConn then _G._freecamConn:Disconnect() _G._freecamConn = nil end
	if _G._freecamInputConn then _G._freecamInputConn:Disconnect() _G._freecamInputConn = nil end
	if _G._freecamClickConn then _G._freecamClickConn:Disconnect() _G._freecamClickConn = nil end
	if _G._freecamScrollConn then _G._freecamScrollConn:Disconnect() _G._freecamScrollConn = nil end

	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	-- Reset camera subject to local player
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
		hum.WalkSpeed = 16
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true

	if freecamGui then freecamGui:Destroy() freecamGui = nil end
end

freecamToggle = createToggle(trollCategory, "Freecam", function(enabled)
	freecamEnabled = enabled
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if enabled then
		if humanoid then humanoid.WalkSpeed = 0 end
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		if root then cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + root.CFrame.LookVector) end

		freecamYaw = 0
		freecamPitch = 0

		-- Lock mouse to center (Shift Lock style) - set BEFORE connections
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false

		if _G._freecamConn then _G._freecamConn:Disconnect() end
		_G._freecamConn = RunService.RenderStepped:Connect(function(dt)
			if not freecamEnabled then return end

			-- Skip camera control when spectating (let Roblox handle it)
			if freecamSpectating then return end

			-- Force lock every frame (other scripts can override it)
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false

			local cam = workspace.CurrentCamera
			local moveDir = Vector3.zero
			local speed = freecamSpeed
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 2.5 end

			-- Rotate camera from mouse delta (Shift Lock style)
			local md = UserInputService:GetMouseDelta()
			freecamYaw = freecamYaw - md.X * 0.3
			freecamPitch = math.clamp(freecamPitch - md.Y * 0.3, -80, 80)
			cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.Angles(0, math.rad(freecamYaw), 0) * CFrame.Angles(math.rad(freecamPitch), 0, 0)

			local look = cam.CFrame.LookVector
			local right = cam.CFrame.RightVector
			local up = Vector3.new(0, 1, 0)

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + look end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - look end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + up end

			if moveDir.Magnitude > 0 then
				cam.CFrame = cam.CFrame + (moveDir.Unit * speed * dt)
			end
		end)

		-- Escape exits freecam if no bind set
		if _G._freecamInputConn then _G._freecamInputConn:Disconnect() end
		_G._freecamInputConn = UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.KeyCode == Enum.KeyCode.Escape and (freecamBindString == "None" or not freecamBind) then
				disableFreecam()
				if freecamToggle and freecamToggle.Parent then
					local api = freecamToggle
					if api and api.setState then api.setState(false) end
				end
			end
		end)

		-- Freecam Mini Menu (bottom center)
