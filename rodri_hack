		crossH.Position = UDim2.new(0.5, -crossLen/2, 0.5, -crossSize/2)
		crossH.BackgroundColor3 = crossColor
		crossH.BorderSizePixel = 0
		crossH.Parent = freecamGui

		local dot = Instance.new("Frame")
		dot.Name = "Dot"
		dot.Size = UDim2.new(0, 4, 0, 4)
		dot.Position = UDim2.new(0.5, -2, 0.5, -2)
