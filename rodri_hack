local function toggleLanguageDropdown()
	if languageDropdown then
		languageDropdown.Visible = not languageDropdown.Visible
		if languageDropdown.Visible then
			refreshLanguageDropdownPosition()
			task.defer(refreshLanguageDropdownPosition)
		end
		refreshLanguageOptionButtons()
	end
end

function refreshLanguageDropdownPosition()
	if not languageDropdown or not languageButton or not languageButton.Parent then
		return
	end
	local buttonPos = languageButton.AbsolutePosition
	local buttonSize = languageButton.AbsoluteSize
	if not buttonPos or not buttonSize then
		return
	end
	local dropdownWidth = 148
	languageDropdown.Position = UDim2.new(
		0,
		math.max(0, buttonPos.X + buttonSize.X - dropdownWidth),
		0,
		buttonPos.Y + buttonSize.Y + 6
	)
end

