function applyStoredMenuSettings()
	local libraryData = readConfigLibrary()
	if type(libraryData) ~= "table" then
		updateThemeStatus()
		if autoExecuteEnabled then
			setupAutoExecute()
		end
		return
	end

	suppressThemeFeedback = true
	if type(libraryData.settings) == "table" then
		if libraryData.settings.autoExecuteEnabled ~= nil then
			autoExecuteEnabled = libraryData.settings.autoExecuteEnabled and true or false
		end
		if libraryData.settings.hasCustomSizePreference ~= nil then
			hasCustomSizePreference = libraryData.settings.hasCustomSizePreference and true or false
		end
		if libraryData.settings.themeName and THEME_PRESETS[libraryData.settings.themeName] then
			applyThemePreset(libraryData.settings.themeName)
		end
		if libraryData.settings.themeStyle and THEME_STYLES[libraryData.settings.themeStyle] then
			applyThemeStyle(libraryData.settings.themeStyle)
		end
		if hasCustomSizePreference and libraryData.settings.sizeIndex and menuSizes and menuSizes[libraryData.settings.sizeIndex] then
			applyThemeSize(libraryData.settings.sizeIndex)
		end
	end
	suppressThemeFeedback = false

	updateThemeStatus()
	if autoExecuteEnabled then
		setupAutoExecute()
	end
end

