function readConfigLibrary()
	if not isfile or not readfile or not isfile(MENU_CONFIG_FILE) then
		return {configs = {}}
	end

	local readSuccess, fileContent = pcall(function()
		return readfile(MENU_CONFIG_FILE)
	end)
	if not readSuccess then
		return nil, fileContent
	end

	local loader = loadstring or load
	if not loader then
		return nil, "loadstring unavailable"
	end

	local chunkSuccess, chunkOrErr = pcall(function()
		return loader(fileContent)
	end)
	if not chunkSuccess or not chunkOrErr then
		return nil, chunkOrErr or "invalid config chunk"
	end

	local runSuccess, data = pcall(chunkOrErr)
	if not runSuccess or type(data) ~= "table" then
		return nil, data or "invalid config data"
	end

	if type(data.configs) ~= "table" then
		data.configs = {}
	end
	if type(data.settings) ~= "table" then
		data.settings = {}
	end

	return data
end

function writeConfigLibrary(libraryData)
	if not writefile then
		return false, "executor has no writefile"
	end

	local serialized = "return " .. serializeLuaValue(libraryData)
	local success, err = pcall(function()
		writefile(MENU_CONFIG_FILE, serialized)
	end)
	if not success then
		return false, err
	end

	return true
end

function getSortedConfigNames(libraryData)
	local names = {}
	if type(libraryData) ~= "table" or type(libraryData.configs) ~= "table" then
		return names
	end

	for configName in pairs(libraryData.configs) do
		table.insert(names, configName)
	end

	table.sort(names, function(a, b)
		return tostring(a):lower() < tostring(b):lower()
	end)

	return names
end

