		closeBtn.AutoButtonColor = false
		closeBtn.Parent = barFrame
		Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)
		closeBtn.MouseButton1Click:Connect(function()
			disableFreecam()
			if freecamToggle and freecamToggle.Parent then
				local api = freecamToggle
				if api and api.setState then api.setState(false) end
			end
		end)

		updateFreecamAction()

		-- Scroll to change action + Click to execute action on crosshair position
		if _G._freecamClickConn then _G._freecamClickConn:Disconnect() end
		_G._freecamClickConn = UserInputService.InputBegan:Connect(function(input, gpe)
			if not freecamEnabled then return end
			if gpe then return end

			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local cam = workspace.CurrentCamera
				-- Raycast from center of screen (crosshair)
				local viewportSize = cam.ViewportSize
				local ray = cam:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
				local rayParams = RaycastParams.new()
				rayParams.FilterType = Enum.RaycastFilterType.Exclude
				rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
				local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams)

				local myChar = LocalPlayer.Character
				local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

				if currentFreecamAction == "Teleport" then
					if myRoot then
						local tpPos
						if result then
							tpPos = result.Position
						else
							tpPos = ray.Origin + ray.Direction * 50
						end
						-- Teleport to where crosshair points
						myRoot.Velocity = Vector3.zero
						myRoot.CFrame = CFrame.new(tpPos + Vector3.new(0, 3, 0))
						showMenuToast("Freecam", "Teleportado", C.TxtWhite)
					end
				elseif currentFreecamAction == "Push" then
					local hitPart = result and result.Instance
					if hitPart then
						local hitModel = hitPart:FindFirstAncestorOfClass("Model")
						if hitModel then
							local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
							if hitPlayer and hitPlayer ~= LocalPlayer then
								local targetRoot = hitModel:FindFirstChild("HumanoidRootPart")
								if myRoot and targetRoot then
									local myChar = LocalPlayer.Character
									local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
									-- Save freecam state
									local savedCFrame = myRoot.CFrame
									local savedVel = myRoot.AssemblyLinearVelocity
									-- Restore physics for fling to work
									if myHum then myHum.WalkSpeed = 16 end
									myRoot.Anchored = false
									-- Teleport near target
									myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
									task.wait(0.15)
									-- Execute kick push (saves/restores internally)
									kickPushIsExecuting = false
									pcall(function()
										performKickPush(hitPlayer)
									end)
									-- Wait for fling + recovery
									task.wait(kickPushFlingTime + kickPushRecoveryDelay + 0.3)
									-- Restore freecam state
									if myHum then myHum.WalkSpeed = 0 end
									myRoot.CFrame = savedCFrame
									myRoot.AssemblyLinearVelocity = Vector3.zero
									showMenuToast("Freecam", "Empurrou " .. hitPlayer.DisplayName, C.TxtWhite)
									return
								end
							end
						end
					end
					showMenuToast("Freecam", "Aponte para um player para empurrar", Color3.fromRGB(255, 170, 70))
				elseif currentFreecamAction == "Spectate" then
					-- Toggle spectate off if already spectating
					if freecamSpectating then
						freecamSpectating = false
						workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
						workspace.CurrentCamera.CameraSubject = nil
						UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
						UserInputService.MouseIconEnabled = false
						showMenuToast("Freecam", "Spectate desligado", C.TxtWhite)
						return
					end
					-- Find player at crosshair
					local hitPart = result and result.Instance
					if hitPart then
						local hitModel = hitPart:FindFirstAncestorOfClass("Model")
						if hitModel then
							local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
							if hitPlayer and hitPlayer ~= LocalPlayer then
								local targetChar = hitPlayer.Character
								local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
								if targetHum then
									freecamSpectating = true
									workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
									workspace.CurrentCamera.CameraSubject = targetHum
									showMenuToast("Freecam", "Observando " .. hitPlayer.DisplayName .. " (clique de novo para parar)", C.TxtWhite)
									return
								end
							end
						end
					end
					showMenuToast("Freecam", "Aponte para um player para observar", Color3.fromRGB(255, 170, 70))
				end
			end
		end)

		-- Scroll wheel to cycle actions
		if _G._freecamScrollConn then _G._freecamScrollConn:Disconnect() end
		_G._freecamScrollConn = UserInputService.InputChanged:Connect(function(input)
			if not freecamEnabled then return end
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				if input.Position.Z > 0 then
					freecamActionIndex = freecamActionIndex - 1
					if freecamActionIndex < 1 then freecamActionIndex = #freecamActions end
				else
					freecamActionIndex = freecamActionIndex + 1
					if freecamActionIndex > #freecamActions then freecamActionIndex = 1 end
				end
				updateFreecamAction()
			end
		end)

		showMenuToast("Freecam", "WASD=move | Dir=olhar | Click=selecionar/player | Scroll=mudar ação", C.TxtWhite)
	else
		disableFreecam()
	end
end, "Camera freefly com WASD, Shift e botão direito. Mini menu no fim da tela.", {
	bindId = "freecam",
	getBindValue = function() return freecamBind end,
	getBindName = function() return freecamBindString end,
	setBind = function(bindValue, bindName)
		freecamBind = bindValue
