function clickAction()
	local x, y = 0, 0
	if autoclickerMode == "Follow Cursor" then
		local mousePos = UserInputService:GetMouseLocation()
		x = mousePos.X
		y = mousePos.Y
	else
		x = tonumber(autoclickerFixedX) or 0
		y = tonumber(autoclickerFixedY) or 0
	end

	local buttonVal = 0 -- 0: Left, 1: Right, 2: Middle
	if autoclickerButton == "Right" then
		buttonVal = 1
	elseif autoclickerButton == "Middle" then
		buttonVal = 2
	end

	-- Executor-specific click simulation
	if buttonVal == 0 then
		if mouse1click then
			pcall(function() mouse1click() end)
		end
	elseif buttonVal == 1 then
		if mouse2click then
			pcall(function() mouse2click() end)
		end
	end

	-- VirtualInputManager clicking
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, buttonVal, true, game, 1)
		VirtualInputManager:SendMouseButtonEvent(x, y, buttonVal, false, game, 1)
	end)

	-- VirtualUser clicking fallback
	if typeof(VirtualUser) == "Instance" then
		pcall(function()
			if buttonVal == 0 then
				VirtualUser:Button1Down(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
				task.wait()
				VirtualUser:Button1Up(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
			elseif buttonVal == 1 then
				VirtualUser:Button2Down(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
				task.wait()
				VirtualUser:Button2Up(Vector2.new(x, y), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
			end
		end)
	end
	
	-- Fast Hit Integration
	if fastHitEnabled and buttonVal == 0 then
		local character = LocalPlayer.Character
		if character then
			local tool = character:FindFirstChildOfClass("Tool")
			if tool then
				tool.Enabled = true
				pcall(function() tool:Activate() end)
				
				-- The Unequip/Equip trick to bypass internal tool cooldowns!
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					pcall(function()
						tool.Parent = LocalPlayer.Backpack
						tool.Parent = character
					end)
				end
			end
		end
	end
end

