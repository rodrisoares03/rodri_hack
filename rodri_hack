function returnAfterStealNudge()
	if not stealReturnPending or not stealReturnCFrame then
		return false
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	root.CFrame = stealReturnCFrame
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	stealReturnCFrame = nil
	stealReturnPending = false
	task.defer(function()
		pcall(resetCharacterPoseNoDeath)
	end)
	return true
end

function tryStealNudgeWithReturn(prompt)
	local captured = captureStealReturnPosition()
	local nudged = nudgeToPromptForSteal(prompt)
	if nudged then
