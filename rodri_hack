chatSpammerToggle = createToggle(nil, "Chat Spammer", function(enabled)
	chatSpammerEnabled = enabled
	if enabled then
		if _G._chatSpammerThread then task.cancel(_G._chatSpammerThread) _G._chatSpammerThread = nil end
		_G._chatSpammerThread = task.spawn(function()
			local attemptsWithoutSend = 0

			while chatSpammerEnabled do
				local text = chatSpammerMessage
				local sent = false

				-- 1. Tentar TextChatService RBXGeneral
				pcall(function()
					if TextChatService.TextChannels then
						local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
						if ch then
							ch:SendAsync(text)
							sent = true
						end
					end
				end)

				-- 2. Tentar SayMessageRequest legado
				if not sent then
					pcall(function()
						local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
						if events then
							local sayReq = events:FindFirstChild("SayMessageRequest")
							if sayReq then
								sayReq:FireServer(text, "All")
								sent = true
							end
						end
					end)
				end

				-- 3. Tentar WhisperChat + CanChatWith
				if not sent then
					pcall(function()
						local expChat = ReplicatedStorage:FindFirstChild("ExperienceChat")
						if expChat then
							local whisperChat = expChat:FindFirstChild("WhisperChat")
							if whisperChat and whisperChat:IsA("RemoteFunction") then
								local canChatWith = ReplicatedStorage:FindFirstChild("CanChatWith")
								for _, player in ipairs(Players:GetPlayers()) do
									if player ~= LocalPlayer then
										if canChatWith and canChatWith:IsA("RemoteEvent") then
											pcall(function() canChatWith:FireServer(player) end)
										end
										pcall(function() whisperChat:InvokeServer(player.Name, text) end)
									end
								end
								sent = true
							end
						end
					end)
				end

				if sent then
					attemptsWithoutSend = 0
				else
					attemptsWithoutSend = attemptsWithoutSend + 1
					if attemptsWithoutSend >= 5 then
						warn("[NIGHT MENU] Chat Spammer: Nenhum sistema de chat encontrado apos 5 tentativas.")
						showMenuToast("Chat Spammer", "Chat nao suportado", Color3.fromRGB(255, 100, 100))
						chatSpammerEnabled = false
						pcall(function()
							if chatSpammerToggle and chatSpammerToggle.Parent then
								local api = chatSpammerToggle
								if api and api.setState then api.setState(false) end
							end
						end)
						return
					end
				end

				task.wait(chatSpammerInterval)
			end
		end)
		showMenuToast("Chat Spammer", "Enviando a cada " .. chatSpammerInterval .. "s", C.TxtWhite)
	else
		if _G._chatSpammerThread then task.cancel(_G._chatSpammerThread) _G._chatSpammerThread = nil end
	end
end, "Spam automático no chat com intervalo configurável.", {
	bindId = "chatSpammer",
	getBindValue = function() return chatSpammerBind end,
	getBindName = function() return chatSpammerBindString end,
	setBind = function(bindValue, bindName)
		chatSpammerBind = bindValue
		chatSpammerBindString = bindDisplayName(bindValue, bindName)
	end,
})
