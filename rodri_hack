local function slugifyText(text)
	local key = string.lower(tostring(text or ""))
	key = key:gsub("[^%w]+", "_")
	key = key:gsub("^_+", "")
	key = key:gsub("_+$", "")
	return key
end

local function getLocalizedText(section, key, fallback)
	local langPack = LOCALIZED_TEXT[currentUILanguage] or LOCALIZED_TEXT.PT
	local sectionPack = langPack[section] or {}
	local value = sectionPack[key]
	if value ~= nil then
		return value
	end
	local fallbackPack = (LOCALIZED_TEXT.PT[section] or {})
	return fallbackPack[key] or fallback or ""
end

