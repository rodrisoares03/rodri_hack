local function getRestoreButtonDefaultPosition()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(960, 600)
	return UDim2.new(0, math.max(12, viewport.X - 160), 0, 16)
end

local function clampRestoreButtonPosition(x, y)
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(960, 600)
	local buttonSize = restoreButton and restoreButton.AbsoluteSize or Vector2.new(140, 38)
	local maxX = math.max(12, viewport.X - buttonSize.X - 12)
	local maxY = math.max(12, viewport.Y - buttonSize.Y - 12)
	return math.clamp(x, 12, maxX), math.clamp(y, 12, maxY)
end

local function findTopButton(offset)
