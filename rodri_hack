		configCodeBox.Text = textValue or ""
	end
end

function saveLibrarySettings()
	local libraryData, err = readConfigLibrary()
	if type(libraryData) ~= "table" then
		return false, err
	end

	libraryData.settings.themeName = currentThemeName
	libraryData.settings.themeStyle = currentThemeStyle
	libraryData.settings.sizeIndex = currentSizeIndex
	libraryData.settings.hasCustomSizePreference = hasCustomSizePreference and true or false
	libraryData.settings.autoExecuteEnabled = autoExecuteEnabled

	return writeConfigLibrary(libraryData)
end

function refreshConfigList()
	if not configListScroll then return end

	for _, child in ipairs(configListScroll:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	local libraryData, err = readConfigLibrary()
	if type(libraryData) ~= "table" then
		setConfigStatus(err or "unable to read config list", Color3.fromRGB(255, 120, 120))
		return
	end

	local names = getSortedConfigNames(libraryData)
	local searchText = string.lower((configSearchInput and configSearchInput.Text) or "")
	if #names == 0 then
		local emptyLabel = New("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 26),
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = C.TxtWhite,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = getPageText("config", "no_saved_configs", "No saved configs yet."),
		}, configListScroll)
		return
	end

	local shownCount = 0
	for _, configName in ipairs(names) do
		local configData = libraryData.configs and libraryData.configs[configName]
		if searchText == "" or string.find(string.lower(configName), searchText, 1, true) then
			shownCount = shownCount + 1
			local row = New("Frame", {
				BackgroundColor3 = selectedConfigName == configName and C.BindActive or C.BgCard,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 0, 54),
			}, configListScroll)
			Corner(8, row)
			Stroke(C.Divider, 1, row).Transparency = 0.25

			local rowName = New("TextButton", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 4),
				Size = UDim2.new(1, -92, 0, 20),
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = C.TxtWhite,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = configName,
				AutoButtonColor = false,
			}, row)

			New("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 24),
				Size = UDim2.new(1, -92, 0, 22),
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				TextColor3 = C.TxtWhite,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = "Created: " .. getConfigTimestampText(configData and configData.createdAt) .. " | Last Use: " .. getConfigTimestampText(configData and configData.lastUsed),
			}, row)

			local loadBtn = New("TextButton", {
				BackgroundColor3 = C.BindBg,
				BorderSizePixel = 0,
				Position = UDim2.new(1, -74, 0.5, -11),
				Size = UDim2.new(0, 64, 0, 22),
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = C.TxtWhite,
				Text = "Load",
				AutoButtonColor = false,
			}, row)
			Corner(6, loadBtn)

			rowName.MouseButton1Click:Connect(function()
				selectConfigName(configName)
				refreshConfigList()
			end)

			loadBtn.MouseButton1Click:Connect(function()
				loadConfig(configName)
			end)
		end
	end

	if shownCount == 0 then
		local emptySearchLabel = New("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 26),
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = C.TxtWhite,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "No configs match your search.",
		}, configListScroll)
	end
end

function saveConfig(configName)
	if not writefile then
		setConfigStatus("executor has no writefile", Color3.fromRGB(255, 120, 120))
		return false
	end

	local cleanName = sanitizeConfigName(configName or (configNameInput and configNameInput.Text) or selectedConfigName)
	if not cleanName then
		setConfigStatus("insert a config name first", Color3.fromRGB(255, 120, 120))
		return false
	end

	local libraryData, err = readConfigLibrary()
	if type(libraryData) ~= "table" then
		setConfigStatus(err or "unable to open config list", Color3.fromRGB(255, 120, 120))
		return false
	end

	if libraryData.configs[cleanName] and cleanName ~= selectedConfigName and pendingOverwriteName ~= cleanName then
		pendingOverwriteName = cleanName
		setConfigStatus("name exists, click Save again to overwrite", Color3.fromRGB(255, 210, 120))
		showMenuToast("Save Warning", cleanName .. " already exists", Color3.fromRGB(255, 210, 120))
		return false
	end

	pendingOverwriteName = nil
	local existingConfig = libraryData.configs[cleanName]
	local configPayload = collectMenuConfig()
	configPayload.createdAt = existingConfig and existingConfig.createdAt or makeConfigTimestamp()
	configPayload.lastUsed = existingConfig and existingConfig.lastUsed or "--"
	libraryData.configs[cleanName] = configPayload
	libraryData.lastSelected = cleanName

	local success, saveErr = writeConfigLibrary(libraryData)
	if not success then
		setConfigStatus("save failed: " .. tostring(saveErr), Color3.fromRGB(255, 120, 120))
		return false
	end

	selectConfigName(cleanName)
	refreshConfigList()
	setConfigStatus("config saved: " .. cleanName, Color3.fromRGB(170, 255, 170))
	showMenuToast("Config Saved", cleanName, Color3.fromRGB(170, 255, 170))
	return true
end

function loadConfig(configName)
	local cleanName = sanitizeConfigName(configName or (configNameInput and configNameInput.Text) or selectedConfigName)
	if not cleanName then
		setConfigStatus("select or type a config name", Color3.fromRGB(255, 120, 120))
		return false
	end

	local libraryData, err = readConfigLibrary()
	if type(libraryData) ~= "table" then
		setConfigStatus(err or "unable to read config list", Color3.fromRGB(255, 120, 120))
		return false
	end

	local configData = libraryData.configs and libraryData.configs[cleanName]
	if type(configData) ~= "table" then
		setConfigStatus("config not found: " .. cleanName, Color3.fromRGB(255, 120, 120))
		return false
	end

	if type(configData.binds) == "table" then
		for bindId, bindData in pairs(configData.binds) do
			local entry = configBindRegistry[bindId]
			if entry and entry.setBind then
				local bindValue, bindName = deserializeBindValue(bindData)
				entry.setBind(bindValue, bindName)
				if entry.refreshBindTag then
					entry.refreshBindTag()
				end
			end
		end
		if refreshKeybindManager then task.defer(refreshKeybindManager) end
	end

	if type(configData.toggles) == "table" then
		for key, savedState in pairs(configData.toggles) do
			local canonicalKey = CONFIG_TOGGLE_KEY_ALIASES[key] or key
			local entry = configToggleRegistry[canonicalKey]
			if entry and entry.setState and type(savedState) == "boolean" then
				entry.setState(savedState, "force")
			end
		end
	end

	if type(configData.values) == "table" then
		if type(configData.values.instantInteractWhitelistText) == "string" then
			instantInteractWhitelistText = configData.values.instantInteractWhitelistText
			if instantInteractWhitelistInput then
				instantInteractWhitelistInput.Text = instantInteractWhitelistText
			end
		end
		if type(configData.values.instantInteractBlacklistText) == "string" then
			instantInteractBlacklistText = configData.values.instantInteractBlacklistText
			if instantInteractBlacklistInput then
				instantInteractBlacklistInput.Text = instantInteractBlacklistText
			end
			instantInteractBlockShopsEnabled = instantInteractBlacklistText == instantInteractDefaultShopBlacklist
			if syncInstantInteractBlockShopsButton then
				syncInstantInteractBlockShopsButton()
			end
		end
		if type(configData.values.stealDistanceValue) == "number" then
			setStealDistanceValue(configData.values.stealDistanceValue)
			if stealDistanceInput then
				stealDistanceInput.Text = tostring(stealDistanceValue)
			end
			if stealDistanceLabel then
				stealDistanceLabel.Text = "Steal Distance: " .. tostring(stealDistanceValue)
			end
		end
		if type(configData.values.stealTargetMode) == "string" then
			local mode = string.lower(configData.values.stealTargetMode)
			if mode == "best" or mode == "worst" then
				stealTargetMode = (mode == "worst") and "Worst" or "Best"
				if stealTargetModeBtn then
					stealTargetModeBtn.Text = "Steal Target Mode: " .. tostring(stealTargetMode)
				end
			end
		end
		if type(configData.values.tpCursorCooldownSeconds) == "number" then
			tpCursorCooldownSeconds = math.clamp(configData.values.tpCursorCooldownSeconds, 0.5, 30)
			if tpCursorCooldownInput then
				tpCursorCooldownInput.Text = tostring(tpCursorCooldownSeconds)
			end
		end
		if type(configData.values.autoclickerInterval) == "number" then
			autoclickerInterval = configData.values.autoclickerInterval
			if autoclickerIntervalInput then
				autoclickerIntervalInput.Text = tostring(autoclickerInterval)
			end
		end
		if type(configData.values.autoclickerMode) == "string" then
			autoclickerMode = configData.values.autoclickerMode
			if autoclickerModeBtn then
				autoclickerModeBtn.Text = "Click Mode: " .. autoclickerMode
			end
			if autoclickerFixedFrame then
				autoclickerFixedFrame.Visible = (autoclickerMode == "Fixed Location")
			end
		end
		if type(configData.values.autoclickerButton) == "string" then
			autoclickerButton = configData.values.autoclickerButton
			if autoclickerButtonBtn then
				autoclickerButtonBtn.Text = "Click Button: " .. autoclickerButton
			end
		end
		if type(configData.values.autoclickerFixedX) == "number" then
			autoclickerFixedX = configData.values.autoclickerFixedX
			if autoclickerFixedXInput then
				autoclickerFixedXInput.Text = tostring(autoclickerFixedX)
			end
		end
		if type(configData.values.autoclickerFixedY) == "number" then
			autoclickerFixedY = configData.values.autoclickerFixedY
			if autoclickerFixedYInput then
				autoclickerFixedYInput.Text = tostring(autoclickerFixedY)
			end
		end
		if type(configData.values.fastHitInterval) == "number" then
			fastHitInterval = configData.values.fastHitInterval
			if fastHitIntervalInput then
				fastHitIntervalInput.Text = tostring(fastHitInterval)
			end
		end
	end

	configData.lastUsed = makeConfigTimestamp()
	libraryData.configs[cleanName] = configData
	libraryData.lastSelected = cleanName
	writeConfigLibrary(libraryData)
	selectConfigName(cleanName)
	refreshConfigList()
	setConfigStatus("config loaded: " .. cleanName, Color3.fromRGB(170, 255, 170))
	showMenuToast("Config Loaded", cleanName, Color3.fromRGB(170, 220, 255))
	return true
end

function deleteConfig(configName)
	local cleanName = sanitizeConfigName(configName or (configNameInput and configNameInput.Text) or selectedConfigName)
	if not cleanName then
		setConfigStatus("select or type a config name", Color3.fromRGB(255, 120, 120))
		return false
	end

	local libraryData, err = readConfigLibrary()
	if type(libraryData) ~= "table" then
		setConfigStatus(err or "unable to read config list", Color3.fromRGB(255, 120, 120))
		return false
	end

	if not libraryData.configs or not libraryData.configs[cleanName] then
		setConfigStatus("config not found: " .. cleanName, Color3.fromRGB(255, 120, 120))
		return false
	end

	libraryData.configs[cleanName] = nil
	if libraryData.lastSelected == cleanName then
		libraryData.lastSelected = nil
	end

	local success, saveErr = writeConfigLibrary(libraryData)
	if not success then
		setConfigStatus("delete failed: " .. tostring(saveErr), Color3.fromRGB(255, 120, 120))
		return false
	end

	selectConfigName(nil)
	refreshConfigList()
	setConfigStatus("config deleted: " .. cleanName, Color3.fromRGB(170, 255, 170))
	showMenuToast("Config Deleted", cleanName, Color3.fromRGB(255, 160, 160))
	return true
end

