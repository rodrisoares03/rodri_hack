	end
	if captured then
		stealReturnCFrame = nil
		stealReturnPending = false
	end
	return false
end

function getPromptPriority(prompt)
	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
	local objectText = string.lower(tostring(prompt and prompt.ObjectText or ""))
	local combined = actionText .. " " .. objectText

	if combined:find("roubar") or combined:find("steal") or combined:find("colet") or combined:find("collect") or combined:find("pegar") or combined:find("take") or combined:find("loot") then
		return 3
	end

	if combined:find("abrir") or combined:find("open") or combined:find("claim") or combined:find("pickup") then
		return 2
	end

	if combined:find("shop") or combined:find("loja") or combined:find("buy") or combined:find("compr") or combined:find("sell") or combined:find("vender") then
		return 0
	end

	return 1
end

function getPromptNumericWeight(prompt)
	local actionText = tostring(prompt and prompt.ActionText or "")
	local objectText = tostring(prompt and prompt.ObjectText or "")
	local combined = actionText .. " " .. objectText

	local function parseToken(rawNumber, rawSuffix)
		local suffix = string.lower(tostring(rawSuffix or ""))
		local cleaned = tostring(rawNumber or ""):gsub("%s+", ""):gsub(",", "")
		local numeric = tonumber(cleaned)
		if not numeric then
			return nil
		end
		if suffix == "k" then
			numeric = numeric * 1000
		elseif suffix == "m" then
			numeric = numeric * 1000000
		elseif suffix == "b" then
			numeric = numeric * 1000000000
		end
		return numeric
	end

	local best = 0

	-- Prefer right-side value in current/max patterns (supports suffixes: K/M/B).
	for _, rightNumber, rightSuffix in combined:gmatch("(%d[%d%.,]*)%s*[kKmMbB]?%s*/%s*(%d[%d%.,]*)%s*([kKmMbB]?)") do
		local numeric = parseToken(rightNumber, rightSuffix)
		if numeric and numeric > best then
			best = numeric
		end
	end

	for rawNumber, rawSuffix in combined:gmatch("(%d[%d%.,]*)%s*([kKmMbB]?)") do
		local numeric = parseToken(rawNumber, rawSuffix)
		if numeric and numeric > best then
			best = numeric
		end
	end

	return math.floor(best)
end

function splitPromptFilterList(rawText)
	local tokens = {}
	local lowered = string.lower(tostring(rawText or ""))
	for token in lowered:gmatch("[^,%s]+") do
		table.insert(tokens, token)
	end
	return tokens
end

function promptMatchesFilter(prompt, rawText)
	local tokens = splitPromptFilterList(rawText)
	if #tokens == 0 then
		return false
	end

	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
	local objectText = string.lower(tostring(prompt and prompt.ObjectText or ""))
	local combined = actionText .. " " .. objectText

	for _, token in ipairs(tokens) do
		if token ~= "" and combined:find(token, 1, true) then
			return true
		end
	end

	return false
end

function isStealPrompt(prompt)
	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
	local objectText = string.lower(tostring(prompt and prompt.ObjectText or ""))
	local combined = actionText .. " " .. objectText

	return combined:find("roubar", 1, true)
		or combined:find("steal", 1, true)
		or combined:find("rob", 1, true)
end

function isShopPrompt(prompt)
	local actionText = string.lower(tostring(prompt and prompt.ActionText or ""))
