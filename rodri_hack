function createRageSubTabButton(tabName, order)
	local button = New("TextButton", {
		Name = tabName .. "SubTab",
		LayoutOrder = order,
		BackgroundColor3 = C.BgInput,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Size = UDim2.new(0.45, 0, 1, 0),
		Text = tabName,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = C.TxtWhite,
	}, rageSubTabBar)
	Corner(6, button)
	Stroke(C.Divider, 1, button).Transparency = 0.25
	local activeMarker = New("Frame", {
		Name = "ActiveMarker",
		BackgroundColor3 = C.Purple,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 10, 1, -3),
		Size = UDim2.new(1, -20, 0, 2),
		Visible = false,
	}, button)
	Corner(1, activeMarker)
	local isActiveAtStart = activeRageSubPageName == tabName
	button.BackgroundColor3 = isActiveAtStart and Color3.fromRGB(35, 35, 42) or C.BgInput
	button.BackgroundTransparency = isActiveAtStart and 0.85 or 0.05
	activeMarker.Visible = isActiveAtStart
	button.MouseButton1Click:Connect(function()
		for name, page in pairs(rageSubPages) do
			page.Visible = name == tabName
		end
		activeRageSubPageName = tabName
		for _, btn in pairs(rageSubTabButtons) do
			local isActive = btn.Name == tabName .. "SubTab"
			btn.BackgroundColor3 = isActive and Color3.fromRGB(35, 35, 42) or C.BgInput
			btn.BackgroundTransparency = isActive and 0.85 or 0.05
			btn.TextColor3 = isActive and C.TxtWhite or C.TxtWhite
			local marker = btn:FindFirstChild("ActiveMarker")
			if marker then
				marker.Visible = isActive
			end
		end
		task.defer(refreshRageCanvas)
	end)
	rageSubTabButtons[tabName .. "SubTab"] = button
	return button
end

