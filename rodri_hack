local function stopInfinitePush()
	infinitePushEnabled = false
	infinitePushTarget = nil
	infinitePushToken = infinitePushToken + 1
	updateInfinitePushButton()
end

function toggleInfinitePush(enabled)
	if not enabled then
		stopInfinitePush()
		return
	end

	local targetPlayer = selectedPlayer
	if not targetPlayer or targetPlayer == LocalPlayer then
		return false
	end

	if infinitePushEnabled then
		return true
	end

	infinitePushEnabled = true
	infinitePushTarget = targetPlayer
	infinitePushToken = infinitePushToken + 1
	local token = infinitePushToken
	updateInfinitePushButton()

	task.spawn(function()
		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
		if not myChar or not myRoot or not myHumanoid then
			if token == infinitePushToken then
				stopInfinitePush()
			end
			return
		end

		local savedAutoRotate = myHumanoid.AutoRotate
		local savedPlatformStand = myHumanoid.PlatformStand
		local savedRootCanCollide = myRoot.CanCollide
		local savedPhysicalProps = myRoot.CustomPhysicalProperties
		local savedParts = {}
		forEachCharacterPart(myChar, function(part)
			savedParts[part] = part.CanCollide
			if part.Name ~= "HumanoidRootPart" then
				part.CanCollide = false
			end
		end)

		local flingCollider = Instance.new("Part")
		flingCollider.Name = "InfinitePushCollider"
		flingCollider.Size = Vector3.new(2, 2, 2)
		flingCollider.Transparency = 1
		flingCollider.CanCollide = true
		flingCollider.Massless = true
		flingCollider.CollisionGroup = "Default"
		flingCollider.CFrame = myRoot.CFrame
		flingCollider.Parent = myChar

		local flingWeld = Instance.new("WeldConstraint")
		flingWeld.Part0 = myRoot
		flingWeld.Part1 = flingCollider
		flingWeld.Parent = flingCollider

		myRoot.CanCollide = true
		myRoot.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
		myHumanoid.AutoRotate = false
		myHumanoid.PlatformStand = false
		myHumanoid.Sit = false
		myHumanoid:ChangeState(Enum.HumanoidStateType.Physics)

		local restoreState = function()
			pcall(function()
				if flingCollider then
					flingCollider:Destroy()
				end
			end)

			for part, canCollide in pairs(savedParts) do
				if part and part.Parent then
					part.CanCollide = canCollide
				end
			end

			if myRoot and myRoot.Parent then
				myRoot.CanCollide = savedRootCanCollide
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
				myRoot.RotVelocity = Vector3.zero
				if savedPhysicalProps ~= nil then
					myRoot.CustomPhysicalProperties = savedPhysicalProps
				else
					myRoot.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
				end
			end

			if myHumanoid and myHumanoid.Parent then
				myHumanoid.AutoRotate = savedAutoRotate
				myHumanoid.PlatformStand = savedPlatformStand
				myHumanoid.Sit = false
				myHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end

		while infinitePushEnabled and token == infinitePushToken do
			local target = infinitePushTarget
			if not target or target == LocalPlayer or not target.Parent then
				break
			end

			local targetCharacter = target.Character
			local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
			local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
			if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
				setAntiFlyingBypass(kickPushFlingTime + kickPushRecoveryDelay + 0.35)
				pcall(function()
					if not requestKickPushServer(target) then
						performKickPush(target)
					end
				end)
				task.wait(math.max(0.04, kickPushFlingTime * 0.2))
			else
				task.wait(0.12)
			end
		end

		restoreState()
		if token == infinitePushToken then
			stopInfinitePush()
		end
		task.defer(function()
			pcall(resetCharacterPoseNoDeath)
		end)
	end)

	return true
end

