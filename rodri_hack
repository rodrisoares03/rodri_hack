	avatar.Image = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
	avatar.Parent = btn
	Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

