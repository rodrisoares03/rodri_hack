-- Function to minimize the menu and show restore button
local function minimizeMenu()
	if not sidebar or not content then return end
	isMinimized = true
	menuIsMinimized = true
	hideAllInlineHints()
	hideAllBindHints()
	activeBindCapture = nil
	if languageDropdown then
		languageDropdown.Visible = false
	end
	mainFrame.Visible = false
	restoreButton.Visible = true
	restoreButton.Position = restoreButtonDefaultPosition or getRestoreButtonDefaultPosition()
	UI_Tween(restoreButton, {Position = restoreButton.Position, BackgroundTransparency = 0.06}, 0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	sidebar.Visible = false
	content.Visible = false
end

-- Function to restore the menu from minimized state
function restoreMenu()
	if not sidebar or not content then return end
	isMinimized = false
	menuIsMinimized = false
	mainFrame.Visible = true
	mainFrame.BackgroundTransparency = 0
	if restoreButton then
		restoreButtonDefaultPosition = restoreButton.Position
		UI_Tween(restoreButton, {Position = restoreButton.Position, BackgroundTransparency = 0.06}, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.18, function()
			if restoreButton then
				restoreButton.Visible = false
			end
		end)
	end
	sidebar.Visible = true
	content.Visible = true
	
	-- Restore position and size
	mainFrame.Size = menuExpandedSize
	mainFrame.Position = menuExpandedPosition
end

-- Handle minimize via M key (UI_TOGGLE_KEY) to restore/minimize the main menu
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if inputMatchesBind(input, UI_TOGGLE_KEY) then
		if menuIsMinimized then
			restoreMenu()
			showPanel(true)
		elseif panelVisible then
			minimizeMenu()
			showPanel(false)
		else
			showPanel(true)
		end
		return
	end
end)

