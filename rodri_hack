	for _, desc in ipairs(gui:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextBox") then
			local text = desc.Text
			local timer = tonumber(text:match("(%d+)"))
			if timer and timer <= 60 then
				return timer
