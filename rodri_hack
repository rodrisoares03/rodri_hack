function isPromptInteractable(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end
	local allowedDistance = (prompt.MaxActivationDistance or 10) + 1.5
	if stealDistanceEnabled and isStealPrompt(prompt) then
		local requested = tonumber(stealDistanceValue) or 22
		local capped = math.min(requested, tonumber(stealDistanceSafeLimit) or 500)
		allowedDistance = math.max(allowedDistance, capped + 1.5)
	end
	if getPromptDistance(prompt) > allowedDistance then return false end
	if instantInteractBlockShopsEnabled and isShopPrompt(prompt) then return false end
	if instantInteractBlacklistText ~= "" and promptMatchesFilter(prompt, instantInteractBlacklistText) then return false end
	if instantInteractWhitelistText ~= "" and not promptMatchesFilter(prompt, instantInteractWhitelistText) then return false end
	return true
end

function getBestInstantInteractPrompt()
	if stealFocusPrompt and (not isPromptInteractable(stealFocusPrompt) or not isInstantPromptVisible(stealFocusPrompt)) then
		stealFocusPrompt = nil
	end

	local bestPrompt = nil
	local bestPriority = -1
	local bestNumeric = -1
	local bestDistance = math.huge

	for prompt in pairs(instantInteractVisiblePrompts) do
		if isPromptInteractable(prompt) then
			local priority = getPromptPriority(prompt)
			local numeric = getPromptNumericWeight(prompt)
			local isSteal = isStealPrompt(prompt)
			local distance = getPromptDistance(prompt)

			-- For steal prompts, only target values >= configured minimum (default: 20k).
			if (not isSteal) or (numeric >= (tonumber(stealMinTargetValue) or 20000)) then
				local preferWorst = string.lower(tostring(stealTargetMode or "Best")) == "worst"
				local numericBetter = (not preferWorst and numeric > bestNumeric) or (preferWorst and (bestNumeric < 0 or numeric < bestNumeric))
				if priority > bestPriority
					or (priority == bestPriority and prompt == stealFocusPrompt and bestPrompt ~= stealFocusPrompt)
					or (priority == bestPriority and numericBetter)
					or (priority == bestPriority and numeric == bestNumeric and distance < bestDistance) then
					bestPrompt = prompt
					bestPriority = priority
					bestNumeric = numeric
					bestDistance = distance
				end
			end
		else
			instantInteractVisiblePrompts[prompt] = nil
		end
	end

	return bestPrompt
end

function isInstantPromptVisible(prompt)
	return prompt and instantInteractVisiblePrompts[prompt] == true and prompt.Parent and prompt.Enabled
end

function triggerPromptInteraction(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end

	local holdDuration = math.max(prompt.HoldDuration or 0, 0.05)
	local isSteal = isStealPrompt(prompt)
	local releaseAt
	local didStealNudge = false
	local canStealNudge = isSteal and not stealTpUsedForPrompt[prompt]
	if isSteal then
		-- Extra margin for steal prompts so server-side validation has time to complete.
		releaseAt = tick() + math.max(holdDuration, 0.45) + 0.45
	else
		releaseAt = tick() + holdDuration + 0.2
	end
	if prompt.InputHoldBegin and prompt.InputHoldEnd then
		local ok = pcall(function()
			if canStealNudge and stealDistanceEnabled and not didStealNudge and getPromptDistance(prompt) > 6 then
				didStealNudge = tryStealNudgeWithReturn(prompt)
				if didStealNudge then
					stealTpUsedForPrompt[prompt] = true
					stealFocusPrompt = prompt
				end
			end
			prompt:InputHoldBegin()
			while tick() < releaseAt do
				if not instantInteractEnabled or not isInstantPromptVisible(prompt) then
					break
				end
				if canStealNudge and stealDistanceEnabled and not didStealNudge and (releaseAt - tick()) <= 0.22 then
					if getPromptDistance(prompt) > 7 then
						didStealNudge = tryStealNudgeWithReturn(prompt)
						if didStealNudge then
							stealTpUsedForPrompt[prompt] = true
							stealFocusPrompt = prompt
						end
					else
						didStealNudge = true
					end
				end
				task.wait(0.03)
			end
			prompt:InputHoldEnd()
		end)
		if ok then
			return true
		end
	end

	local keyCode = prompt.KeyboardKeyCode
	if keyCode and keyCode ~= Enum.KeyCode.Unknown then
		local ok = pcall(function()
			if canStealNudge and stealDistanceEnabled and not didStealNudge and getPromptDistance(prompt) > 6 then
				didStealNudge = tryStealNudgeWithReturn(prompt)
				if didStealNudge then
					stealTpUsedForPrompt[prompt] = true
					stealFocusPrompt = prompt
				end
			end
			VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
			while tick() < releaseAt do
				if not instantInteractEnabled or not isInstantPromptVisible(prompt) then
					break
				end
				if canStealNudge and stealDistanceEnabled and not didStealNudge and (releaseAt - tick()) <= 0.22 then
					if getPromptDistance(prompt) > 7 then
						didStealNudge = tryStealNudgeWithReturn(prompt)
						if didStealNudge then
							stealTpUsedForPrompt[prompt] = true
							stealFocusPrompt = prompt
						end
					else
						didStealNudge = true
					end
				end
				task.wait(0.03)
			end
			VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
		end)
		if ok then
			return true
		end
	end

	if fireproximityprompt then
		local ok = pcall(function()
			fireproximityprompt(prompt)
		end)
		if ok then
			return true
		end
	end

	return false
end

function tryInstantInteractPrompt(prompt)
	if not instantInteractEnabled or instantInteractBusy then return end
	if not isPromptInteractable(prompt) then return end
	if prompt == instantInteractLastPrompt and (tick() - instantInteractLastTryAt) < 0.03 then return end

	local now = tick()
	local isSteal = isStealPrompt(prompt)
	if isSteal and (now - stealLastCompleteAt) < stealInteractionCooldown then
		return
	end
	if fastStealEnabled and isSteal then
		local lastForPrompt = fastStealPerPromptUseAt[prompt] or 0
		if now - fastStealLastUseAt < fastStealGlobalCooldown then
			return
		end
		if now - lastForPrompt < fastStealSamePromptCooldown then
			return
		end
		if fastStealLastPrompt and fastStealLastPrompt ~= prompt and (now - fastStealLastUseAt) < fastStealSwitchCooldown then
			return
		end
	end

	instantInteractBusy = true
	instantInteractLastPrompt = prompt
	instantInteractLastTryAt = now
	task.spawn(function()
		local interacted = false
		pcall(function()
			interacted = triggerPromptInteraction(prompt) and true or false
		end)
		if interacted and isSteal and not isInstantPromptVisible(prompt) then
			stealLastCompleteAt = tick()
			stealTpUsedForPrompt[prompt] = nil
			if stealFocusPrompt == prompt then
				stealFocusPrompt = nil
			end
		end
		if interacted and fastStealEnabled and isSteal then
			-- Only apply strict steal cooldown after prompt actually closes.
			if not isInstantPromptVisible(prompt) then
				local usedAt = tick()
				fastStealLastUseAt = usedAt
				fastStealLastPrompt = prompt
				fastStealPerPromptUseAt[prompt] = usedAt
			else
				-- If server didn't confirm, back off a bit to avoid infinite hold spam.
				fastStealPerPromptUseAt[prompt] = tick()
			end
		end
		if isSteal and stealReturnPending then
			task.delay(0.12, function()
				pcall(function()
					returnAfterStealNudge()
				end)
			end)
		end
		task.wait(0.03)
		instantInteractBusy = false
	end)
end

