function serializeBindValue(bindValue)
	if typeof(bindValue) == "EnumItem" then
		return {kind = "KeyCode", value = bindValue.Name}
	end

	if type(bindValue) == "string" and bindValue ~= "" then
		return {kind = "Mouse", value = bindValue}
	end

	return nil
end

function deserializeBindValue(bindData)
	if type(bindData) ~= "table" then
		return nil, "None"
	end

	if bindData.kind == "KeyCode" and type(bindData.value) == "string" then
		local keyCode = Enum.KeyCode[bindData.value]
		if keyCode then
			return keyCode, bindData.value
		end
	elseif bindData.kind == "Mouse" and type(bindData.value) == "string" then
		return bindData.value, bindData.value
	end

	return nil, "None"
end

function serializeLuaValue(value, depth)
	depth = depth or 0
	local valueType = type(value)

	if valueType == "table" then
		local keys = {}
		for key in pairs(value) do
			table.insert(keys, key)
		end
		table.sort(keys, function(a, b)
			return tostring(a) < tostring(b)
		end)

		local indent = string.rep("\t", depth)
		local childIndent = string.rep("\t", depth + 1)
		local parts = {"{"}
		for _, key in ipairs(keys) do
			local serializedKey
			if type(key) == "string" and key:match("^[%a_][%w_]*$") then
				serializedKey = key
			else
				serializedKey = "[" .. serializeLuaValue(key, depth + 1) .. "]"
			end
			table.insert(parts, childIndent .. serializedKey .. " = " .. serializeLuaValue(value[key], depth + 1) .. ",")
		end
		table.insert(parts, indent .. "}")
		return table.concat(parts, "\n")
	elseif valueType == "string" then
		return string.format("%q", value)
	elseif valueType == "number" or valueType == "boolean" then
		return tostring(value)
	end

	return "nil"
end

