			if _G._nightCursorHeartbeat then _G._nightCursorHeartbeat:Disconnect() _G._nightCursorHeartbeat = nil end
			_G._nightCursorForceLoop = nil
		end
		_G._nightCursorForceLoop = true
		pcall(function()
			RunService:BindToRenderStep("NightCursorForce", Enum.RenderPriority.Last.Value + 1, function()
				if not panelVisible then
					pcall(function() RunService:UnbindFromRenderStep("NightCursorForce") end)
					_G._nightCursorForceLoop = nil
					setCursorVisible(false)
					return
