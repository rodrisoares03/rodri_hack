function getClosestNPC()
	if not npcAimbotEnabled then return nil end

	local closestNPC = nil
	local closestDistance = npcAimbotFOV * 1.5
	local camera = workspace.CurrentCamera
	local centerPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	local myChar = LocalPlayer.Character
	local myRoot = myChar and getPrimaryPart(myChar)
	if not myRoot then return nil end

	for _, npcInfo in ipairs(npcEspCachedModels) do
		local model = npcInfo.model
		local root = npcInfo.root
		if model and model.Parent and root and root:IsA("BasePart") and npcInfo.humanoid.Health > 0 then
			local dist = (root.Position - myRoot.Position).Magnitude
			if dist <= ESP_MAX_DISTANCE then
				local targetPart = nil
				if npcAimbotTarget == "Head" then
					targetPart = model:FindFirstChild("Head")
				elseif npcAimbotTarget == "Chest" then
					targetPart = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
				end
				if not targetPart then targetPart = root end

				local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
				if onScreen then
					local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
					if screenDist <= closestDistance then
						closestDistance = screenDist
						closestNPC = model
					end
				end
			end
		end
	end
	return closestNPC
end

function aimAtNPC(npcModel)
	if not npcModel or not npcModel.Parent then return end

	local camera = workspace.CurrentCamera
	local targetPart = nil
	if npcAimbotTarget == "Head" then
		targetPart = npcModel:FindFirstChild("Head")
	elseif npcAimbotTarget == "Chest" then
		targetPart = npcModel:FindFirstChild("UpperTorso") or npcModel:FindFirstChild("Torso")
	end
	if not targetPart then targetPart = getPrimaryPart(npcModel) end
	if not targetPart then return end

	local targetPos = targetPart.Position
	local camPos = camera.CFrame.Position
	local targetCFrame = CFrame.lookAt(camPos, targetPos)

	local smoothFactor = (20 - npcAimbotSmooth) / 20
	if smoothFactor < 0.05 then smoothFactor = 1 end

	camera.CFrame = camera.CFrame:Lerp(targetCFrame, smoothFactor)
end

