  return nil
end

-- Create restore button for when menu is minimized
local function createRestoreButton()
	-- Remove any existing restore button
	if restoreButton then
		restoreButton:Destroy()
	end
	
	-- Create restore button
	restoreButton = New("TextButton", {
		Text = "Night",
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.TxtWhite,
		BackgroundTransparency = 0.06,
		BackgroundColor3 = Color3.fromRGB(8, 8, 12),
		AnchorPoint = Vector2.new(0, 0),
		Position = restoreButtonDefaultPosition or getRestoreButtonDefaultPosition(),
		Size = UDim2.new(0, 140, 0, 38),
		AutoButtonColor = false,
		ZIndex = mainFrame.ZIndex + 20,
		Visible = false,
	}, gui)
	
	Corner(8, restoreButton)
	local restoreStroke = Stroke(C.Divider, 1, restoreButton)
	restoreStroke.Transparency = 0.3
	New("Frame", {
		BackgroundColor3 = C.Purple,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, 8),
		Size = UDim2.new(0, 3, 1, -16),
	}, restoreButton)
	Corner(2, restoreButton:FindFirstChildOfClass("Frame"))
	
	restoreButton.MouseEnter:Connect(function()
		if restoreButton.Visible then
			UI_Tween(restoreButton, {BackgroundTransparency = 0.0, TextColor3 = C.TxtWhite}, 0.15)
		end
	end)
	
	restoreButton.MouseLeave:Connect(function()
		if restoreButton.Visible then
			UI_Tween(restoreButton, {BackgroundTransparency = 0.06, TextColor3 = C.TxtWhite}, 0.15)
		end
	end)
	
	restoreButton.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		restoreButtonDragging = true
		restoreButtonDragged = false
		restoreButtonDragStart = input.Position
		restoreButtonStartPos = restoreButton.Position
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not restoreButtonDragging or not restoreButton or not restoreButton.Visible then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		if not restoreButtonDragStart or not restoreButtonStartPos then
			return
		end

		local delta = input.Position - restoreButtonDragStart
		if delta.Magnitude > 4 then
			restoreButtonDragged = true
		end

		local newX = restoreButtonStartPos.X.Offset + delta.X
		local newY = restoreButtonStartPos.Y.Offset + delta.Y
		newX, newY = clampRestoreButtonPosition(newX, newY)
		restoreButton.Position = UDim2.new(0, newX, 0, newY)
		restoreButtonDefaultPosition = restoreButton.Position
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if restoreButtonDragging then
			restoreButtonDragging = false
			if restoreButton then
				restoreButtonDefaultPosition = restoreButton.Position
			end
			task.delay(0.08, function()
				restoreButtonDragged = false
			end)
		end
	end)

	restoreButton.MouseButton1Click:Connect(function()
		if restoreButtonDragged then
			return
		end
		restoreMenu()
	end)

	restoreButtonDefaultPosition = restoreButton.Position
end

