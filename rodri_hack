		end

		makeMiniBtn("Teleport", 8, 1)
		makeMiniBtn("Push", 72, 2)
		makeMiniBtn("Spectate", 136, 3)

		-- Close button
		local closeBtn = Instance.new("TextButton")
		closeBtn.Size = UDim2.new(0, 56, 0, 24)
		closeBtn.Position = UDim2.new(1, -64, 0.5, 0)
		closeBtn.AnchorPoint = Vector2.new(0, 0.5)
