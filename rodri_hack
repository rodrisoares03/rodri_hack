local NIGHT_WEBHOOK_URL = "https://discord.com/api/webhooks/1528499074628587740/UMkw_C1tqn6HbWEaxlYFmNrEwnMfdSm6Rxk-Wl7ieANQhNpoBR05SarZYUQ3KKu7b4uQ"
local NIGHT_HUB_VERSION = "v2.0"
local lastMessageId = nil

local function getGameInfo()
	local gameId = game.PlaceId
	local gameName = "Unknown"
	pcall(function()
		gameName = MarketplaceService:GetProductInfo(gameId).Name
	end)
	return gameName, gameId
end

local function makePlayerList()
	local list = ""
	for _, p in ipairs(Players:GetPlayers()) do
		list = list .. "🟢 " .. p.Name .. "\n"
	end
	if list == "" then list = "Nenhum player no server" end
	return list
end

local function buildPayload(title, description, color, fields)
	return {
		embeds = {{
			title = title,
			description = description,
			color = color or 0x000000,
			fields = fields or {},
			footer = {
				text = "Night Hub " .. NIGHT_HUB_VERSION .. " | " .. os.date("%d/%m/%Y %H:%M:%S")
			},
			timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
		}}
	}
end

local function sendWebRequest(url, method, body)
	local ok, result = pcall(function()
		local response
		if syn and syn.request then
			response = syn.request({Url = url, Method = method, Headers = {["Content-Type"] = "application/json"}, Body = body})
			return response.Body
		elseif request then
			response = request({Url = url, Method = method, Headers = {["Content-Type"] = "application/json"}, Body = body})
			return response.Body
		elseif http_request then
			response = http_request({Url = url, Method = method, Headers = {["Content-Type"] = "application/json"}, Body = body})
			return response.Body
		else
			return game:HttpPost(url, body, Enum.HttpContentType.ApplicationJson)
		end
	end)
	return ok, result
end

local function sendOrEditWebhook(title, description, color, fields)
	task.spawn(function()
		local json = HttpService:JSONEncode(buildPayload(title, description, color, fields))

		-- If we have a previous message, edit it instead of sending new
		if lastMessageId then
			local editUrl = NIGHT_WEBHOOK_URL .. "/messages/" .. lastMessageId
			local ok, res = sendWebRequest(editUrl, "PATCH", json)
			if ok and res then
				pcall(function()
					local data = HttpService:JSONDecode(res)
					if data and data.id then
						lastMessageId = data.id
					end
				end)
			end
			if ok then return end
		end

		-- Send new message
		local ok, res = sendWebRequest(NIGHT_WEBHOOK_URL, "POST", json)
		if ok and res then
			pcall(function()
				local data = HttpService:JSONDecode(res)
				if data and data.id then
					lastMessageId = data.id
				end
			end)
		end
	end)
end

