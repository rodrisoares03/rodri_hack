local function setAntiFlyingBypass(duration)
	antiFlyingBypassUntil = math.max(antiFlyingBypassUntil or 0, tick() + (duration or 0))
end

local function shouldBypassAntiFlying()
	if tick() < (antiFlyingBypassUntil or 0) then
		return true
	end
	return kickPushIsExecuting or (FlySystem and FlySystem.flying) or freeflyOn
end

local function setAntiFlyingLastSafe(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	if humanoid.FloorMaterial ~= Enum.Material.Air then
		antiFlyingLastSafeCFrame = root.CFrame
	end
end

local function startAntiFlying()
	if antiFlyingConnection then
		antiFlyingConnection:Disconnect()
		antiFlyingConnection = nil
	end

	antiFlyingConnection = RunService.Heartbeat:Connect(function()
		if not antiFlyingEnabled then
			return
		end

		local character = LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 then
			return
		end

		setAntiFlyingLastSafe(character)
		if shouldBypassAntiFlying() then
			return
		end

		local velocity = root.AssemblyLinearVelocity
		local angularVelocity = root.AssemblyAngularVelocity
		local isBeingLaunched = velocity.Magnitude > 32 or math.abs(velocity.Y) > 18 or angularVelocity.Magnitude > 25
		if isBeingLaunched and antiFlyingLastSafeCFrame then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.RotVelocity = Vector3.zero
			root.CFrame = antiFlyingLastSafeCFrame
		end
	end)
end

local function stopAntiFlying()
	if antiFlyingConnection then
		antiFlyingConnection:Disconnect()
		antiFlyingConnection = nil
	end
	antiFlyingLastSafeCFrame = nil
end

function toggleAntiFlying(enabled)
	antiFlyingEnabled = enabled and true or false
	if antiFlyingEnabled then
		startAntiFlying()
	else
		stopAntiFlying()
	end
end

