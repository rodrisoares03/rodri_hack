function refreshEspCanvas()
	task.defer(function()
		local activePage = espSubPages[activeEspSubPageName]
		if activePage and activePage.Parent then
			espPage.CanvasSize = UDim2.new(0, 0, 0, math.max(0, activePage.AbsoluteSize.Y + 80))
		end
	end)
end

