function updateThemeStatus()
	if themePresetLabel then
		themePresetLabel.Text = getPageText("theme", "theme_prefix", "Theme: ") .. tostring(currentThemeName)
	end
	if themeStyleLabel then
		themeStyleLabel.Text = getPageText("theme", "style_prefix", "Style: ") .. tostring(currentThemeStyle)
	end
	if themeSizeLabel and menuSizes and menuSizes[currentSizeIndex] then
		themeSizeLabel.Text = getPageText("theme", "size_prefix", "Size: ") .. tostring(menuSizes[currentSizeIndex].name)
	end
	if themeStatusLabel then
		themeStatusLabel.Text = getPageText("theme", "active_theme_prefix", "Active theme: ") .. tostring(currentThemeName) .. " / " .. tostring(currentThemeStyle)
	end
	if autoExecThemeBtn then
		autoExecThemeBtn.Text = autoExecuteEnabled and getPageText("theme", "auto_execute_on", "Auto Execute: ON") or getPageText("theme", "auto_execute_off", "Auto Execute: OFF")
		autoExecThemeBtn.BackgroundColor3 = autoExecuteEnabled and C.BindActive or C.BindBg
	end
	if themeButtonGroups.presets then
		for themeName, btn in pairs(themeButtonGroups.presets) do
			btn.BackgroundColor3 = themeName == currentThemeName and C.BindActive or C.BindBg
			btn.TextColor3 = themeName == currentThemeName and C.TxtWhite or C.TxtWhite
		end
	end
	if themeButtonGroups.styles then
		for styleName, btn in pairs(themeButtonGroups.styles) do
			btn.BackgroundColor3 = styleName == currentThemeStyle and C.BindActive or C.BindBg
			btn.TextColor3 = styleName == currentThemeStyle and C.TxtWhite or C.TxtWhite
		end
	end
	if themeButtonGroups.sizes and menuSizes and menuSizes[currentSizeIndex] then
		local currentSizeName = menuSizes[currentSizeIndex].name
		for sizeName, btn in pairs(themeButtonGroups.sizes) do
			btn.BackgroundColor3 = sizeName == currentSizeName and C.BindActive or C.BindBg
			btn.TextColor3 = sizeName == currentSizeName and C.TxtWhite or C.TxtWhite
		end
	end
end

function applyThemePreset(themeName)
	local preset = THEME_PRESETS[themeName]
	if not preset then return false end

	local oldColors = {}
	for key, value in pairs(C) do
		oldColors[tostring(value)] = preset.c[key] or value
	end
	for key, value in pairs(SAKURA) do
		oldColors[tostring(value)] = preset.sakura[key] or value
	end

	for key, value in pairs(preset.c) do
		C[key] = value
	end
	for key, value in pairs(preset.sakura) do
		SAKURA[key] = value
	end

	for _, obj in ipairs(gui:GetDescendants()) do
		if obj:IsA("GuiObject") then
			local replacement = oldColors[tostring(obj.BackgroundColor3)]
			if replacement then
				obj.BackgroundColor3 = replacement
			end
		end
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			local replacement = oldColors[tostring(obj.TextColor3)]
			if replacement then
				obj.TextColor3 = replacement
			end
		end
		if obj:IsA("UIStroke") then
			local replacement = oldColors[tostring(obj.Color)]
			if replacement then
				obj.Color = replacement
			end
		end
	end

	currentThemeName = themeName
	updateThemeStatus()
	if not suppressThemeFeedback then
		saveLibrarySettings()
		showMenuToast("Theme Applied", themeName, C.Purple)
	end
	return true
end

function applyThemeStyle(styleName)
	local styleData = THEME_STYLES[styleName]
	if not styleData then return false end

	for _, obj in ipairs(gui:GetDescendants()) do
		if obj:IsA("UICorner") then
			obj.CornerRadius = UDim.new(0, styleData.radius)
		end
	end

	currentThemeStyle = styleName
	updateThemeStatus()
	if not suppressThemeFeedback then
		saveLibrarySettings()
		showMenuToast("Style Applied", styleName, C.TxtWhite)
	end
	return true
end

function applyThemeSize(sizeIndex)
	if not menuSizes or not menuSizes[sizeIndex] then return false end

	currentSizeIndex = sizeIndex
	hasCustomSizePreference = true
	local size = menuSizes[currentSizeIndex]
	resizeUI(size.width, size.height)
	if menuSizeBtn then
		menuSizeBtn.Text = "Size: " .. size.name
	end
	updateThemeStatus()
	if not suppressThemeFeedback then
		saveLibrarySettings()
		showMenuToast("Size Applied", size.name, C.TxtWhite)
	end
	return true
end

function getAutoExecuteLoaderSource()
	return [[
pcall(function()
	local loader = loadstring or load
	if not loader or not readfile then
		return
	end
	local candidates = {"night_menu.luau", "script_roblox.lua", "night_menu_edit.luau"}
	for _, path in ipairs(candidates) do
		local ok, src = pcall(readfile, path)
		if ok and src and src ~= "" then
			local fn = loader(src)
			if fn then
				fn()
				return
			end
		end
	end
end)
]]
end

function getTeleportQueueFunction()
	return queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
end

function setupAutoExecute()
	if not autoExecuteEnabled then
		return false
	end

	local loaderSource = getAutoExecuteLoaderSource()
	if writefile then
		pcall(function()
			if makefolder and isfolder and not isfolder("autoexec") then
				makefolder("autoexec")
			end
		end)
		pcall(function()
				writefile("autoexec/night_menu_autoexec.lua", loaderSource)
		end)
	end

	local queueFn = getTeleportQueueFunction()
	if queueFn then
		pcall(function()
			queueFn(loaderSource)
		end)
	end

	return true
end

function toggleAutoExecute()
	autoExecuteEnabled = not autoExecuteEnabled
	saveLibrarySettings()
	if autoExecuteEnabled then
		setupAutoExecute()
		showMenuToast("Auto Execute", "Enabled for autoexec and teleport queue", Color3.fromRGB(170, 255, 170))
	else
		showMenuToast("Auto Execute", "Disabled", Color3.fromRGB(255, 170, 170))
	end
	updateThemeStatus()
end

