	local data = syncPlayerCharacter(p)
	local char = data and data.character
	if not char then return end

	local humanoid = data and data.humanoid or char:FindFirstChildOfClass("Humanoid")
	local root = data and data.root or char:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
