			pcall(function() RunService:UnbindFromRenderStep("NightThirdPerson") end)
			_G._nightThirdPersonLoop = nil
		end
		_G._nightThirdPersonLoop = true

		pcall(function()
			RunService:BindToRenderStep("NightThirdPerson", Enum.RenderPriority.Last.Value + 3, function()
				if not enabled or not _G._nightThirdPersonActive then
					pcall(function() RunService:UnbindFromRenderStep("NightThirdPerson") end)
					_G._nightThirdPersonLoop = nil
					return
				end

				local cam = workspace.CurrentCamera
				if not cam then return end
				cam.CameraType = Enum.CameraType.Scriptable

				local char = LocalPlayer.Character
				if not char then return end
				local root = char:FindFirstChild("HumanoidRootPart")
				if not root then return end

				local delta = UserInputService:GetMouseDelta()
				if not panelVisible and delta.Magnitude > 0 then
					_G._nightThirdPersonYaw = (_G._nightThirdPersonYaw or 0) - delta.X * 0.004
					_G._nightThirdPersonPitch = math.clamp(
						(_G._nightThirdPersonPitch or 0) - delta.Y * 0.004,
						-0.8, 0.8
					)
				end

				local rootPos = root.CFrame.Position
				local dist = 8
				local yaw = _G._nightThirdPersonYaw or 0
				local pitch = _G._nightThirdPersonPitch or 0

				local camX = rootPos.X - math.sin(yaw) * dist
				local camY = rootPos.Y + 3 + pitch * 6
				local camZ = rootPos.Z - math.cos(yaw) * dist
				local camPos = Vector3.new(camX, camY, camZ)
				local lookAt = rootPos + Vector3.new(0, 2, 0)
				cam.CFrame = CFrame.lookAt(camPos, lookAt)
				cam.Focus = root.CFrame
			end)
		end)
	else
		_G._nightThirdPersonActive = false
		LocalPlayer.CameraMaxZoomDistance = 400
		LocalPlayer.CameraMinZoomDistance = 0.5
		if _G._nightThirdPersonLoop then
			pcall(function() RunService:UnbindFromRenderStep("NightThirdPerson") end)
