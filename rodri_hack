	Corner(8, circle)

	local inlineHint
	if hasDescription then
		inlineHint = New("TextLabel", {
			Name = "InlineHint",
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.08,
			Position = UDim2.new(0, 0, 0, 0),
