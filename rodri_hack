antiKickToggle = createToggle(utilsContent, "Anti-Kick", function(enabled)
	antiKickEnabled = enabled
	if not enabled then
		return
	end

	if type(getrawmetatable) ~= "function" or type(setreadonly) ~= "function" or type(newcclosure) ~= "function" or type(getnamecallmethod) ~= "function" then
		antiKickEnabled = false
		showMenuToast("Anti-Kick", "Executor sem suporte para hook de metatable.", Color3.fromRGB(255, 170, 70))
		return
	end

	local ok, err = pcall(function()
		local mt = getrawmetatable(game)
		if not mt then
			error("metatable unavailable")
		end

		local oldNamecall = mt.__namecall
		setreadonly(mt, false)
		mt.__namecall = newcclosure(function(self, ...)
			local method = getnamecallmethod()
			if method == "Kick" or method == "kick" then
				return nil
			end
			return oldNamecall(self, ...)
		end)

		local oldIndex = mt.__index
		mt.__index = newcclosure(function(self, key)
			if typeof(self) == "Instance" and self:IsA("Player") and (key == "Kick" or key == "kick") then
				return newcclosure(function() return nil end)
			end
			return oldIndex(self, key)
		end)
		setreadonly(mt, true)
	end)

	if not ok then
		antiKickEnabled = false
		showMenuToast("Anti-Kick", "Falha ao ativar: " .. tostring(err), Color3.fromRGB(255, 120, 120))
	end
end, "Intercepts local kick attempts sent by the server or other scripts.")

