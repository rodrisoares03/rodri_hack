				pcall(function() npcHighlights[model]:Destroy() end)
				npcHighlights[model] = nil
			end
			return
		end
	end

	local h = npcHighlights[model]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "NpcESP"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Adornee = model
		h.Parent = LocalPlayer:WaitForChild("PlayerGui")
		npcHighlights[model] = h
	end

	if npcAutoEspEnabled then
		local rayOrigin = workspace.CurrentCamera.CFrame.Position
		local rayDir = (targetRoot.Position - rayOrigin).Unit * 100
		local raycastParams = RaycastParams.new()
		raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, model}
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		local result = workspace:Raycast(rayOrigin, rayDir, raycastParams)
		if result then
			h.FillColor = Color3.fromRGB(255, 0, 0)
			h.OutlineColor = Color3.fromRGB(255, 0, 0)
		else
			h.FillColor = Color3.fromRGB(0, 255, 0)
			h.OutlineColor = Color3.fromRGB(0, 255, 0)
		end
	else
		h.FillColor = npcEspColor
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
	end

	if npcEspMode == "Cheio" then
		h.FillTransparency = 0
		h.OutlineTransparency = 0
	else
		h.FillTransparency = 1
		h.OutlineTransparency = 0
	end

	if npcShowSkeleton then
		h.Enabled = true
	else
		h.Enabled = false
	end
end

