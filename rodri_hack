tpToCursorBind = nil
tpToCursorBindString = "None"
tpCursorCooldownSeconds = 3
tpCursorLastUseAt = 0

function teleportToCursorNow()
	local currentTime = tick()
	if currentTime - tpCursorLastUseAt < tpCursorCooldownSeconds then
		return false
	end

	local mouse = LocalPlayer:GetMouse()
	local character = LocalPlayer.Character
	if character and mouse.Hit then
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart then
			local targetPos = mouse.Hit.Position + Vector3.new(0, 3, 0)
			local direction = (targetPos - humanoidRootPart.Position)
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {character}
			rayParams.FilterType = Enum.RaycastFilterType.Blacklist

			local rayResult = workspace:Raycast(humanoidRootPart.Position, direction, rayParams)
			if rayResult then
				return false
			end

			humanoidRootPart.CFrame = CFrame.new(targetPos)
			tpCursorLastUseAt = currentTime
			return true
		end
	end

	return false
end

