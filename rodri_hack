				return
			end
			UserInputService.MouseIconEnabled = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			pcall(function() LocalPlayer:GetMouse().Icon = "" end)
		end)
		_G._nightCursorHeartbeat = RunService.Heartbeat:Connect(function()
			if not panelVisible then
				if _G._nightCursorHeartbeat then _G._nightCursorHeartbeat:Disconnect() _G._nightCursorHeartbeat = nil end
				return
			end
			UserInputService.MouseIconEnabled = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			pcall(function() LocalPlayer:GetMouse().Icon = "" end)
		end)
	else
		if _G._nightCursorForceLoop then
			pcall(function() RunService:UnbindFromRenderStep("NightCursorForce") end)
			_G._nightCursorForceLoop = nil
		end
		if _G._nightCursorStepped then _G._nightCursorStepped:Disconnect() _G._nightCursorStepped = nil end
		if _G._nightCursorHeartbeat then _G._nightCursorHeartbeat:Disconnect() _G._nightCursorHeartbeat = nil end
