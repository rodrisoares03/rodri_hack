function ensureNpcHealthBar(model)
	if not model or not model.Parent then
		if npcHealthBars[model] then
			pcall(function()
				if npcHealthBars[model].bg then npcHealthBars[model].bg:Remove() end
				if npcHealthBars[model].fill then npcHealthBars[model].fill:Remove() end
			end)
			npcHealthBars[model] = nil
		end
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		if npcHealthBars[model] then
			pcall(function()
				if npcHealthBars[model].bg then npcHealthBars[model].bg:Remove() end
				if npcHealthBars[model].fill then npcHealthBars[model].fill:Remove() end
			end)
			npcHealthBars[model] = nil
		end
		return
	end

	local root = getPrimaryPart(model)
	if not root then return end

	local camera = workspace.CurrentCamera
	local topPos = root.Position + Vector3.new(0, 3, 0)
	local bottomPos = root.Position - Vector3.new(0, 3, 0)
	local topScreen, topOnScreen = camera:WorldToViewportPoint(topPos)
	local bottomScreen, bottomOnScreen = camera:WorldToViewportPoint(bottomPos)
	if not topOnScreen or not bottomOnScreen then return end

	if not npcHealthBars[model] then
		npcHealthBars[model] = {
			bg = Drawing.new("Square"),
			fill = Drawing.new("Square"),
		}
		npcHealthBars[model].bg.Filled = true
		npcHealthBars[model].bg.Color = Color3.fromRGB(40, 0, 0)
		npcHealthBars[model].bg.Transparency = 0.6
		npcHealthBars[model].fill.Filled = true
		npcHealthBars[model].fill.Transparency = 0.3
	end

	local healthPercent = humanoid.Health / humanoid.MaxHealth
	local barHeight = math.abs(topScreen.Y - bottomScreen.Y)
	local barWidth = 4
	local boxWidth = barHeight * 0.4
	local barX = topScreen.X - boxWidth/2 - barWidth - 6
	local barY = topScreen.Y

	npcHealthBars[model].bg.Size = Vector2.new(barWidth, barHeight)
	npcHealthBars[model].bg.Position = Vector2.new(barX, barY)
	npcHealthBars[model].bg.Visible = true

	local fillHeight = barHeight * healthPercent
	npcHealthBars[model].fill.Size = Vector2.new(barWidth - 2, fillHeight)
	npcHealthBars[model].fill.Position = Vector2.new(barX + 1, barY + barHeight - fillHeight)

	if healthPercent > 0.5 then
		npcHealthBars[model].fill.Color = Color3.fromRGB(0, 255, 0)
	elseif healthPercent > 0.25 then
		npcHealthBars[model].fill.Color = Color3.fromRGB(255, 255, 0)
	else
		npcHealthBars[model].fill.Color = Color3.fromRGB(255, 0, 0)
	end
	npcHealthBars[model].fill.Visible = true
end

