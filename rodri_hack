	selectionIndicator.Visible = false
	selectionIndicator.Parent = btn
	Instance.new("UICorner", selectionIndicator).CornerRadius = UDim.new(0, 2)

	if selectedPlayer == player then
		selectionIndicator.Visible = true
		btn.BackgroundColor3 = SAKURA.surfaceLight
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	end

	btn.MouseButton1Click:Connect(function()
		-- Verificar se o player ainda existe
		if not player or not player.Parent then
			selectedPlayer = nil
			if actionsPanel then actionsPanel.Visible = false end
			if tpBtn then tpBtn.Visible = false end
			if spectateToggle then spectateToggle.Visible = false end
			if infinitePushBtn then infinitePushBtn.Visible = false end
			stopInfinitePush()
			return
		end
		
		for _, button in pairs(playerButtons) do
			if button:IsA("TextButton") and button ~= btn then
				local label = button:FindFirstChild("NameLabel")
				if label then label.TextColor3 = Color3.fromRGB(255, 255, 255) end
			end
		end
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		selectedPlayer = player
		if actionsPanel then actionsPanel.Visible = true end
		if tpBtn then tpBtn.Visible = true end
		if spectateToggle then spectateToggle.Visible = true end
		if infinitePushBtn then infinitePushBtn.Visible = true end
		if spectateActive then
			spectateActive = false
			stopSpectate()
		end
	end)

	playerButtons[player] = btn
	return btn
end

